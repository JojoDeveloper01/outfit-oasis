---
// Import necessary components or utilities
import Layout from "@layouts/Layout.astro";
import { getItemByName } from "@lib/dbFunctions";

// Access the `id` parameter from the URL

const { clothes } = Astro.params;

// Fetch the item data using the `id`
if (!clothes) {
    throw new Error("Item name is not defined.");
}

const item = await getItemByName(clothes.replace("", "").replace(/-/g, " "));

if (!item) {
    // Handle case where the item is not found
    throw new Error(`Item with Name ${item} not found.`);
}
---

<Layout>
    <div
        class="max-w-screen-lg mx-auto flex flex-col md:flex-row gap-8 bg-gray-50 p-6 rounded-xl shadow-xl"
    >
        {/* Image Section */}
        <div class="w-full md:w-1/2 relative">
            <img
                src={String(item.image)}
                alt={String(item.name)}
                class="rounded-lg shadow-md w-full h-[46rem] max-[768px]:h-[32rem] object-cover object-top"
            />
            {/* Badge */}
            <div
                class={`absolute top-4 left-4 px-3 py-1 text-xs font-semibold uppercase rounded-md ${
                    item.availability
                        ? "bg-green-600 text-white"
                        : "bg-orange-600 text-white"
                }`}
            >
                {item.availability ? "Available" : "Reserved"}
            </div>
        </div>

        {/* Details Section */}
        <div class="w-full md:w-1/2 flex flex-col gap-6">
            {/* Título e Preço */}
            <div>
                <h1 class="text-2xl md:text-4xl font-bold text-gray-800">
                    {item.name}
                </h1>
                <p class="text-sm text-gray-500 mt-1">{item.category}</p>
                <div class="mt-3 flex items-center gap-4">
                    <p class="text-2xl md:text-3xl font-bold text-gray-900">
                        €{Number(item.rental_price).toFixed(2)}
                    </p>
                    {
                        item.discountPrice && (
                            <p class="text-lg text-gray-500 line-through">
                                €{Number(item.discountPrice).toFixed(2)}
                            </p>
                        )
                    }
                </div>
                {
                    item.discount && (
                        <p class="text-sm text-red-600 font-semibold">
                            Desconto {item.discount}% OFF
                        </p>
                    )
                }
            </div>

            {/* Cor */}
            <div>
                <p class="text-gray-800 font-semibold">Cor:</p>
                <div class="flex items-center gap-4 mt-2">
                    <span
                        class="w-8 h-8 rounded-full border-2 border-gray-200"
                        style={{ backgroundColor: String(item.color) }}></span>
                </div>
            </div>

            {/* Tamanhos */}
            <div>
                <p class="text-gray-800 font-semibold">Tamanho:</p>
                <div class="flex items-center gap-4 mt-2">
                    <button
                        class="py-2 px-4 border rounded-lg text-gray-700 font-medium hover:bg-gray-100 transition"
                    >
                        {item.size}
                    </button>
                </div>
                <a
                    href="#size-guide"
                    class="text-sm text-orange-600 hover:underline mt-2 block"
                >
                    Guia de tamanhos
                </a>
            </div>

            {/* Quantidade */}
            <div>
                <p class="text-gray-800 font-semibold">Quantidade:</p>
                <div class="flex items-center gap-4 mt-2">
                    <button class="py-2 px-4 bg-gray-100 rounded-lg font-bold"
                        >-</button
                    >
                    <input
                        type="number"
                        value={1}
                        class="w-16 text-center border rounded-lg"
                        min={1}
                    />
                    <button class="py-2 px-4 bg-gray-100 rounded-lg font-bold"
                        >+</button
                    >
                </div>
            </div>

            {/* Botão de Ação */}
            <div class="mt-6">
                <button
                    class="w-full py-4 bg-orange-600 text-white font-bold rounded-lg shadow-md hover:bg-orange-700 transition"
                >
                    Adicionar ao Carrinho
                </button>
            </div>

            {/* Informação Adicional */}
            <div class="border-t pt-4 mt-4">
                <ul class="text-sm text-gray-600 space-y-2">
                    <li>💸 Qualiade - Preço</li>
                    <li>🔒 Pagamentos seguros e suporte rápido</li>
                </ul>
            </div>
        </div>
    </div>
</Layout>
