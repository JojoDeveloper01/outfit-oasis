---
// Import necessary components or utilities
import Availability from "@components/Items/Availability";
import Layout from "@layouts/Layout.astro";
import { getItemByID, getRentals, userExistsByID } from "@lib/dbFunctions";
import { isCurrentlyRented } from "@lib/functions";

// Access the `id` parameter from the URL

const id = Astro.url.searchParams.get("id");

// Fetch the item data using the `id`
if (!id) {
    throw new Error("Item name is not defined.");
}

const item = await getItemByID(Number(id));
const rentals = await getRentals();

if (!item) {
    // Handle case where the item is not found
    return Astro.redirect("/");
}

// Combina o item com seu aluguel relacionado
const data: any = (() => {
    const relatedRental = rentals.find(
        (rental: any) => rental.article_id === item.id,
    );
    return relatedRental
        ? { ...item, rental: relatedRental, hasRental: true } // Marca itens com rental relacionado
        : { ...item, hasRental: false }; // Marca itens sem rental relacionado
})();

//console.log("data: ", data);

let $user;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    const user_id = Number(getCookie?.value);

    $user = await userExistsByID(`${user_id}`);
    // console.log($user);
}

const user = $user;
const isUser = user ? "modalRent" : "modalLogin";
---

<Layout>
    <div
        class="max-w-screen-lg mx-auto my-16 flex flex-col md:flex-row bg-gray-50 rounded-xl shadow-xl"
    >
        {/* Image Section */}
        <div transition:name=`item-${data.id}` class="w-full md:w-1/2 relative">
            {/* Availability Badge */}
            <Availability client:load entry={data} />
            <img
                src={String(data.image)}
                alt={String(data.name)}
                class="rounded-lg shadow-md w-full h-[46rem] max-[768px]:h-[32rem] object-cover object-top saturate-150"
            />
        </div>

        {/* Details Section */}
        <div
            class="px-6 py-8 w-full md:w-1/2 flex flex-col justify-between gap-6"
        >
            {/* Título e Preço */}
            <div>
                <h1 class="text-2xl md:text-4xl font-bold text-gray-800">
                    {data.name}
                </h1>
                <p class="text-[1vw] text-gray-500 font-bold mt-4">
                    {data.category}
                </p>
                <div class="mt-3 flex items-center gap-[1vw]">
                    <p class="text-2xl md:text-3xl font-bold text-gray-900">
                        {Number(data.rental_price).toFixed(2)} €
                    </p>
                </div>
            </div>

            <div class="grid gap-[1vw]">
                {/* Color */}
                <div>
                    <p class="text-gray-800 font-semibold">Color</p>
                    <div class="flex items-center gap-[1vw] mt-2">
                        <span
                            class="w-8 h-8 rounded-full border-2 border-gray-200"
                            style={{ backgroundColor: String(data.color) }}
                        ></span>
                    </div>
                </div>

                {/* Brand */}
                <div>
                    <p class="text-gray-800 font-semibold">Brand</p>
                    <div class="flex items-center gap-[1vw] mt-2">
                        <span
                            class="py-[.6vw] px-[1vw] border rounded-lg text-gray-700 font-medium"
                        >
                            {data.brand}
                        </span>
                    </div>
                </div>

                {/* Tamanhos */}
                <div>
                    <p class="text-gray-800 font-semibold">Size</p>
                    <div class="flex items-center gap-[1vw] mt-2">
                        <button
                            class="py-[.6vw] px-[1vw] border rounded-lg text-gray-700 font-medium"
                        >
                            {data.size}
                        </button>
                    </div>
                </div>
            </div>

            {/* Botão de Ação */}
            <div class="flex flex-col justify-evently mt-6">
                <div
                    class="flex gap-[1vw] *:p-[1vw] *:font-bold *:rounded-lg *:text-white *:shadow-md *:transition"
                >
                    <button
                        onclick={`document.getElementById('${isUser}').showModal()`}
                        class={`w-full bg-[--greenBlack] hover:bg-black hover:text-white`}
                        data-rent={data.id}
                    >
                        Rent Now
                    </button>

                    <button
                        id={`add-to-cart-${data.id}`}
                        class="w-1/6 flex justify-center bg-[--color-black] hover:bg-black hover:text-white"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="icon icon-tabler icons-tabler-outline icon-tabler-shopping-cart-plus"
                        >
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"
                            ></path>
                            <path d="M4 19a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
                            <path d="M12.5 17h-6.5v-14h-2"></path>
                            <path d="M6 5l14 1l-.86 6.017m-2.64 .983h-10.5"
                            ></path>
                            <path d="M16 19h6"></path>
                            <path d="M19 16v6"></path>
                        </svg>
                    </button>
                </div>

                {/* Informação Adicional */}
                <div class="border-t pt-4 mt-4">
                    <ul class="text-[1vw] text-gray-600 space-y-2">
                        <li>💸 Qualiade - Preço</li>
                        <li>🔒 Pagamentos seguros e suporte rápido</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</Layout>
