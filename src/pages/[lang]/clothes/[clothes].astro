---
// Import necessary components or utilities
import Availability from "@components/Items/Availability";
import Layout from "@layouts/Layout.astro";
import { getItemByID, getRentals, userExistsByID } from "@lib/dbFunctions";
import { isCurrentlyRented } from "@lib/functions";

// Access the `id` parameter from the URL

const id = Astro.url.searchParams.get("id");

// Fetch the item data using the `id`
if (!id) {
    throw new Error("Item name is not defined.");
}

const item = await getItemByID(Number(id));
const rentals = await getRentals();

if (!item) {
    // Handle case where the item is not found
    return Astro.redirect("/");
}

// Combina o item com seu aluguel relacionado
const data: any = (() => {
    const relatedRental = rentals.find(
        (rental: any) => rental.article_id === item.id,
    );
    return relatedRental
        ? { ...item, rental: relatedRental, hasRental: true } // Marca itens com rental relacionado
        : { ...item, hasRental: false }; // Marca itens sem rental relacionado
})();

//console.log("data: ", data);

let $user;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    const user_id = Number(getCookie?.value);

    $user = await userExistsByID(`${user_id}`);
    // console.log($user);
}

const user = $user;
const isUser = user ? "modalRent" : "modalLogin";
---

<Layout>
    <div
        class="w-[49vw] h-[40vw] mx-auto my-[2vw] flex max-[687px]:size-full max-[800px]:size-4/5 max-[464px]:flex-col max-[464px]:w-full max-[464px]:h-[130vw] max-[464px]:justify-evenly bg-gray-50 rounded-xl shadow-xl"
    >
        {/* Image Section */}
        <div
            transition:name=`item-${data.id}`
            class="w-full max-[464px]:h-3/5 relative"
        >
            {/* Availability Badge */}
            <Availability client:load entry={data} />
            <img
                src={String(data.image)}
                alt={String(data.name)}
                class="rounded-lg shadow-md size-full object-cover object-top saturate-150"
            />
        </div>

        {/* Details Section */}
        <div
            class="px-[1.3vw] py-[1vw] w-full flex flex-col justify-evenly max-[464px]:h-2/5 max-[464px]:justify-around max-[464px]:px-[3vw]"
        >
            {/* Título e Preço */}
            <div class="flex flex-col gap-[.5vw] justify-between">
                <h1
                    class="text-[1.3vw] max-[687px]:text-[2.5vw] font-bold text-gray-800"
                >
                    {data.name}
                </h1>
                <p
                    class="text-[.9vw] max-[687px]:text-[2vw] text-gray-500 font-bold"
                >
                    {data.category}
                </p>
                <div class="flex items-center">
                    <p
                        class="text-[.9vw] max-[687px]:text-[2vw] font-bold text-gray-900"
                    >
                        {Number(data.rental_price).toFixed(2)} €
                    </p>
                </div>
            </div>

            <div
                class="flex flex-col justify-between gap-[.5vw] max-[464px]:flex-row max-[687px]:gap-[2vw]"
            >
                {/* Color */}
                <div>
                    <p
                        class="text-[.9vw] max-[687px]:text-[2vw] text-gray-800 font-semibold"
                    >
                        Color
                    </p>
                    <div class="flex items-center gap-[1vw]">
                        <span
                            class="size-[1.5vw] max-[464px]:size-[3vw] rounded-full border-2 border-gray-200"
                            style={{ backgroundColor: String(data.color) }}
                        ></span>
                    </div>
                </div>

                {/* Brand */}
                <div>
                    <p
                        class="text-[.9vw] max-[687px]:text-[2vw] text-gray-800 font-semibold"
                    >
                        Brand
                    </p>
                    <div class="flex items-center gap-[1vw]">
                        <span
                            class="text-[.9vw] max-[687px]:text-[2vw] p-[.6vw] border rounded-lg text-gray-700 font-medium"
                        >
                            {data.brand}
                        </span>
                    </div>
                </div>

                {/* Tamanhos */}
                <div>
                    <p
                        class="text-[.9vw] max-[687px]:text-[2vw] text-gray-800 font-semibold"
                    >
                        Size
                    </p>
                    <div class="flex items-center gap-[1vw]">
                        <button
                            class="text-[.9vw] max-[687px]:text-[2vw] p-[.6vw] border rounded-lg text-gray-700 font-medium"
                        >
                            {data.size}
                        </button>
                    </div>
                </div>
            </div>

            {/* Botão de Ação */}
            <div class="flex flex-col justify-evently">
                <div
                    class="flex gap-[1vw] *:p-[.8vw] *:font-bold *:rounded-lg *:shadow-md *:transition"
                >
                    <button
                        onclick={`document.getElementById('${isUser}').showModal()`}
                        class={`w-full bg-black text-[1vw] max-[687px]:text-[1.4vw] max-[464px]:text-[2vw] max-[464px]:p-[2vw] hover:bg-white hover:text-black`}
                        data-rent={data.id}
                    >
                        Rent Now
                    </button>

                    <button
                        id={`add-to-cart-${data.id}`}
                        class="w-1/6 bg-[--gold] text-black hover:bg-black hover:text-[--gold] max-[687px]:p-[1.4vw] *:size-[1.5vw] *:m-auto max-[687px]:*:size-[2vw] max-[464px]:*:size-[4vw]"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="icon icon-tabler icons-tabler-outline icon-tabler-shopping-cart-plus"
                        >
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"
                            ></path>
                            <path d="M4 19a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
                            <path d="M12.5 17h-6.5v-14h-2"></path>
                            <path d="M6 5l14 1l-.86 6.017m-2.64 .983h-10.5"
                            ></path>
                            <path d="M16 19h6"></path>
                            <path d="M19 16v6"></path>
                        </svg>
                    </button>
                </div>

                {/* Informação Adicional */}
                <div class="border-t pt-[1vw] mt-[.9vw]">
                    <ul
                        class="text-[.8vw] max-[687px]:text-[1.4vw] max-[464px]:text-[1.8vw] font-light text-black space-y-2"
                    >
                        <li>💸 Qualiade - Preço</li>
                        <li>🔒 Pagamentos seguros e suporte rápido</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</Layout>
