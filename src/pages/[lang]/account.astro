---
import Delete from "@components/Modal/Delete";
import EditableField from "@components/Users/EditableField";
import { getLangFromUrl } from "@i18n/utils";
import Layout from "@layouts/Layout.astro";
import { userExistsByID } from "@lib/dbFunctions";
import { actions } from "astro:actions";

const lang = getLangFromUrl(Astro.url);

let $user: any;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    const id = Number(getCookie?.value);
    $user = await userExistsByID(`${id}`);
}

const user = $user;
if (!user) return Astro.redirect(`/${lang}/`);

/**
 * Array de configuração para os campos "normais" do formulário.
 * Para o password, vamos criar um campo especial com isPassword = true.
 */

type FieldType = "text" | "password" | "email" | "number";

interface FormField {
    label: string;
    name: string;
    type: FieldType; // Apenas valores válidos
    value: string | number;
    placeholder?: string;
}

const formFields: FormField[] = [
    {
        label: "Name",
        name: "nameAccount",
        type: "text",
        value: user.name,
    },
    {
        label: "Email",
        name: "emailAccount",
        type: "text",
        value: user.email,
    },
    {
        label: "Phone",
        name: "phoneAccount",
        type: "number",
        value: user.phone,
        placeholder: "Enter your phone number",
    },
    {
        label: "Password",
        name: "passwordAccount",
        type: "password",
        value: user.password,
    },
];

// Validação
async function validateField(id: any, value: any) {
    const { data, error } = await actions.validateUserField({
        id: user.id,
        field: id,
        value,
    });
    if (error || !data?.valid) {
        return data?.message || "Erro de validação.";
    }
    return null;
}

// Salvamento
async function saveField(id: any, value: any) {
    const { error } = await actions.editUser({
        id: user.id,
        [id]: value,
    });
    if (error) {
        throw new Error("Erro ao salvar.");
    }
}
---

<Layout>
    <section
        class="h-full bg-gray-100 flex items-center justify-center py-8 px-4"
    >
        <div class="w-full max-w-4xl bg-white rounded-lg shadow-md p-6">
            <h1 class="text-2xl font-bold mb-4">Account Information</h1>

            {
                formFields.map((field) => (
                    <EditableField
                        client:idle
                        id={field.name}
                        label={field.label}
                        type={field.type}
                        value={field.value}
                    />
                ))
            }
            <div class="mt-6">
                <Delete
                    client:idle
                    name="this Account"
                    id={user.id}
                    imagePath={user.profile_pic}
                    type="user"
                    onDelete=""
                />
            </div>
        </div>
    </section>
</Layout>

<script>
    declare global {
        interface Window {
            updateAccountInfo: (fieldName: string) => Promise<void>;
        }
    }

    document.addEventListener("astro:page-load", () => {
        //see password

        const toggleButtons = document.querySelectorAll(
            ".toggle-password",
        ) as any;

        toggleButtons.forEach((button: any) => {
            button.addEventListener("click", () => {
                const target = button.getAttribute("data-target");
                const input = document.getElementById(target) as any;

                if (input) {
                    if (input.type === "password") {
                        input.type = "text";
                        button.innerHTML = `
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-eye">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                                <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"/>
                                                <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"/>
                                            </svg>
                                        `;
                    } else {
                        input.type = "password";
                        button.innerHTML = `
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-eye-closed">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                                <path d="M21 9c-2.4 2.667 -5.4 4 -9 4c-3.6 0 -6.6 -1.333 -9 -4"/>
                                                <path d="M3 15l2.5 -3.8"/>
                                                <path d="M21 14.976l-2.492 -3.776"/>
                                                <path d="M9 17l.5 -4"/>
                                                <path d="M15 17l-.5 -4"/>
                                            </svg>
                                        `;
                    }
                }
            });
        });
    });
</script>
