---
import Delete from "@components/Modal/Delete";
import EditableField from "@components/Users/EditableField";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Layout from "@layouts/Layout.astro";
import { userExistsByID } from "@lib/dbFunctions";

const lang = getLangFromUrl(Astro.url);

let $user: any;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    const id = Number(getCookie?.value);
    $user = await userExistsByID(`${id}`);
}

const t = useTranslations(lang);

const user = $user;
if (!user) return Astro.redirect(`/${lang}/`);

/**
 * Array de configuração para os campos "normais" do formulário.
 * Para o password, vamos criar um campo especial com isPassword = true.
 */

type FieldType = "text" | "password" | "email" | "number" | "file";

interface FormField {
    label: string;
    name: string;
    type: FieldType; // Apenas valores válidos
    value: string | number;
    placeholder?: string;
}

const formFields: FormField[] = [
    {
        label: t("home.profilePicture"),
        name: "profile_pic",
        type: "file",
        value: user.profile_pic,
    },
    {
        label: t("home.name"),
        name: "name",
        type: "text",
        value: user.name,
    },
    {
        label: "Email",
        name: "email",
        type: "text",
        value: user.email,
    },
    {
        label: t("home.phone"),
        name: "phone",
        type: "number",
        value: user.phone,
        placeholder: t("home.phonePlaceHolder"),
    },
    {
        label: t("home.password"),
        name: "password",
        type: "password",
        value: user.password,
    },
];
---

<Layout>
    <section
        class="min-h-screen flex items-start justify-center mt-[6vw] py-10 text-white"
    >
        <div
            class="w-full max-w-2xl bg-[--gray] rounded-lg shadow-md p-6 md:p-8"
        >
            <h1 class="text-2xl md:text-3xl font-bold mb-6">
                {t("home.account")}
            </h1>

            <div class="space-y-4">
                {
                    formFields.map((field) => (
                        <div class="flex flex-col">
                            <EditableField
                                client:idle
                                userID={user.id}
                                field={field.name}
                                name={field.label}
                                type={field.type}
                                value={field.value}
                            />
                        </div>
                    ))
                }
            </div>

            <div class="mt-6 flex justify-between items-center">
                <Delete
                    client:idle
                    name="this Account"
                    id={user.id}
                    imagePath={user.profile_pic}
                    type="user"
                    onDelete=""
                    lang={lang}
                />
            </div>
        </div>
    </section>
</Layout>
