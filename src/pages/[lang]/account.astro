---
import { getLangFromUrl } from "@i18n/utils";
import Layout from "@layouts/Layout.astro";
import { userExistsByID } from "@lib/dbFunctions";

const lang = getLangFromUrl(Astro.url);

let $user: any;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    const id = Number(getCookie?.value); // Converte o valor do cookie para número, se necessário

    $user = await userExistsByID(`${id}`);
}

const user = $user;
const isStaff = user?.user_type === "staff" ? "block" : "hidden";

if (!user) return Astro.redirect(`/${lang}/`);
---

<Layout>
    <section class="relative size-full">
        <div
            class="absolute m-auto inset-0 p-6 max-w-4xl h-[40rem] bg-white rounded-lg shadow-md"
        >
            <h1 class="text-2xl font-bold mb-4">Account Information</h1>

            <form action="">
                <!-- Placeholder for user info -->
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700"
                            >Name</label
                        >
                        <input class="mt-1 text-gray-900" value={user.name} />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700"
                            >Email</label
                        >
                        <input class="mt-1 text-gray-900" value={user.email} />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700"
                            >User Type</label
                        >
                        <input
                            class="mt-1 text-gray-900"
                            value={user.user_type}
                        />
                    </div>
                </div>
            </form>

            <!-- Action Buttons -->
            <div class="mt-6 flex space-x-4">
                <button
                    class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
                >
                    Delete Account
                </button>
            </div>
        </div>
    </section>
</Layout>
