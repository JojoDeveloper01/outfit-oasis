---
import Delete from "@components/Modal/Delete";
import { getLangFromUrl } from "@i18n/utils";
import Layout from "@layouts/Layout.astro";
import { userExistsByID } from "@lib/dbFunctions";

const lang = getLangFromUrl(Astro.url);

let $user: any;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    const id = Number(getCookie?.value);
    $user = await userExistsByID(`${id}`);
}

const user = $user;
if (!user) return Astro.redirect(`/${lang}/`);

/**
 * Array de configuração para os campos "normais" do formulário.
 * Para o password, vamos criar um campo especial com isPassword = true.
 */
const formFields = [
    {
        label: "Name",
        name: "nameAccount",
        type: "text",
        value: user.name,
    },
    {
        label: "Email",
        name: "emailAccount",
        type: "text",
        value: user.email,
    },
    {
        label: "Phone",
        name: "phoneAccount",
        type: "number",
        value: user.phone,
        placeholder: "Enter your phone number",
    },
    {
        label: "Password",
        name: "passwordAccount",
        type: "password",
        value: user.password,
        isPassword: true, // para tratarmos de forma diferente
    },
];
---

<Layout>
    <section
        class="h-full bg-gray-100 flex items-center justify-center py-8 px-4"
    >
        <div class="w-full max-w-4xl bg-white rounded-lg shadow-md p-6">
            <h1 class="text-2xl font-bold mb-4">Account Information</h1>

            <form class="space-y-4">
                <!-- Profile Pic (caso especial) -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1"
                        >Profile Pic</label
                    >
                    <div class="flex items-center space-x-4 mt-1">
                        <img
                            src={user.profile_pic}
                            alt="Profile Picture"
                            class="w-16 h-16 rounded-full object-cover"
                        />
                        <input
                            type="file"
                            id="image"
                            name="image"
                            accept="image/*"
                            class="block w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4
                     file:rounded-full file:border-0 file:bg-blue-600 file:text-white
                     hover:file:bg-blue-700"
                        />
                    </div>
                </div>

                <!-- Mapeia os campos do array formFields -->
                {
                    formFields.map((field) => (
                        <div class="relative">
                            <label
                                for={field.name}
                                class="block text-sm font-bold text-gray-700 mb-1"
                            >
                                {field.label}
                            </label>

                            {!field.isPassword ? (
                                /* Se NÃO for campo de senha, apenas renderiza o input normal */
                                <input
                                    id={field.name}
                                    name={field.name}
                                    type={field.type}
                                    value={field.value}
                                    placeholder={field.placeholder || ""}
                                    class="mt-1 w-full rounded-md border-gray-300 shadow-sm
                       text-gray-900 focus:border-blue-500 focus:ring-blue-500"
                                />
                            ) : (
                                /* Se for um campo de senha, inclui o ícone de olho */
                                <div class="relative flex items-center">
                                    <input
                                        id={field.name}
                                        name={field.name}
                                        type="password"
                                        value={field.value}
                                        class="mt-1 w-full rounded-md border-gray-300 shadow-sm pr-10
                         text-gray-900 focus:border-blue-500 focus:ring-blue-500"
                                    />
                                    <button
                                        type="button"
                                        class="absolute inset-y-0 right-0 flex items-center px-2
                         text-gray-500 hover:text-black"
                                    >
                                        <svg
                                            class="h-5 w-5"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            viewBox="0 0 24 24"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                    </button>
                                </div>
                            )}
                        </div>
                    ))
                }
            </form>

            <!-- Botão de Delete -->
            <div class="mt-6">
                <Delete
                    client:idle
                    name="this Account"
                    id={user.id}
                    imagePath={user.profile_pic}
                    type="user"
                    onDelete=""
                />
            </div>
        </div>
    </section>
</Layout>

<script>
    import { actions } from "astro:actions";

    document.addEventListener("astro:page-load", () => {
        const passwordInput = document.getElementById("passwordAccount");
        const toggleButton = document.getElementById("togglePassword");

        if (passwordInput && toggleButton) {
            toggleButton.addEventListener("click", () => {
                // Alterna o tipo 'password' <-> 'text'
                (passwordInput as HTMLInputElement).type =
                    (passwordInput as HTMLInputElement).type === "password"
                        ? "text"
                        : "password";
            });
        }
    });
</script>
