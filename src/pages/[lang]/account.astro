---
import Delete from "@components/Modal/Delete";
import EditableField from "@components/Users/EditableField";
import { getLangFromUrl } from "@i18n/utils";
import Layout from "@layouts/Layout.astro";
import { userExistsByID } from "@lib/dbFunctions";
import { actions } from "astro:actions";

const lang = getLangFromUrl(Astro.url);

let $user: any;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    const id = Number(getCookie?.value);
    $user = await userExistsByID(`${id}`);
}

const user = $user;
if (!user) return Astro.redirect(`/${lang}/`);

/**
 * Array de configuração para os campos "normais" do formulário.
 * Para o password, vamos criar um campo especial com isPassword = true.
 */

type FieldType = "text" | "password" | "email" | "number";

interface FormField {
    label: string;
    name: string;
    type: FieldType; // Apenas valores válidos
    value: string | number;
    placeholder?: string;
}

const formFields: FormField[] = [
    {
        label: "Name",
        name: "nameAccount",
        type: "text",
        value: user.name,
    },
    {
        label: "Email",
        name: "emailAccount",
        type: "text",
        value: user.email,
    },
    {
        label: "Phone",
        name: "phoneAccount",
        type: "number",
        value: user.phone,
        placeholder: "Enter your phone number",
    },
    {
        label: "Password",
        name: "passwordAccount",
        type: "password",
        value: user.password,
    },
];

async function saveField(fieldId: number, fieldValue: any) {
    try {
        const { error } = await actions.editUser({
            id: user.id,
            [fieldId]: fieldValue,
        });

        if (error) {
            throw new Error(error.message || "Erro ao salvar o campo.");
        }

        console.log("Campo salvo com sucesso:", fieldId, fieldValue);
    } catch (err) {
        console.error("Erro ao salvar:", err);
    }
}

async function validateField(fieldId: any, fieldValue: any) {
    console.log("fieldId: ", fieldId);
    console.log("fieldValue: ", fieldValue);

    try {
        const { data, error } = await actions.validateUserField({
            id: user.id,
            value: fieldValue,
            field: fieldId,
        });

        if (error || !data?.valid) {
            return data?.message || "Campo inválido.";
        }

        return null;
    } catch (err) {
        console.error("Erro ao validar o campo:", err);
        return "Erro inesperado ao validar.";
    }
}
