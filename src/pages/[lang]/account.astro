    <section
        class="h-full bg-gray-100 flex items-center justify-center py-8 px-4"
    >
        <div class="w-full max-w-4xl bg-white rounded-lg shadow-md p-6">
            <h1 class="text-2xl font-bold mb-4">Account Information</h1>

            {
                formFields.map((field) => (
                    <EditableField
                        id={field.name}
                        label={field.label}
                        type={field.type}
                        value={field.value}
                        validateField={validateField}
                        onSave={saveField}
                    />
                ))
            }
            <div class="mt-6">
                <Delete
                    client:idle
                    name="this Account"
                    id={user.id}
                    imagePath={user.profile_pic}
                    type="user"
                    onDelete=""
                />
            </div>
        </div>
    </section>
</Layout>

<script>
    import { actions } from "astro:actions";

    declare global {
        interface Window {
            updateAccountInfo: (fieldName: string) => Promise<void>;
        }
    }

    document.addEventListener("astro:page-load", () => {
        //see password

        const toggleButtons = document.querySelectorAll(
            ".toggle-password",
        ) as any;

        toggleButtons.forEach((button: any) => {
            button.addEventListener("click", () => {
                const target = button.getAttribute("data-target");
                const input = document.getElementById(target) as any;

                if (input) {
                    if (input.type === "password") {
                        input.type = "text";
                        button.innerHTML = `
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-eye">
