---
import Delete from "@components/Modal/Delete";
import EditableField from "@components/Users/EditableField";
import { getLangFromUrl } from "@i18n/utils";
import Layout from "@layouts/Layout.astro";
import { userExistsByID } from "@lib/dbFunctions";
import { actions } from "astro:actions";

const lang = getLangFromUrl(Astro.url);

let $user: any;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    const id = Number(getCookie?.value);
    $user = await userExistsByID(`${id}`);
}

const user = $user;
if (!user) return Astro.redirect(`/${lang}/`);

/**
 * Array de configuração para os campos "normais" do formulário.
 * Para o password, vamos criar um campo especial com isPassword = true.
 */

type FieldType = "text" | "password" | "email" | "number" | "file";

interface FormField {
    label: string;
    name: string;
    type: FieldType; // Apenas valores válidos
    value: string | number;
    placeholder?: string;
}

const formFields: FormField[] = [
    {
        label: "Profile Picture",
        name: "profile_pic",
        type: "file",
        value: user.profile_pic,
    },
    {
        label: "Name",
        name: "name",
        type: "text",
        value: user.name,
    },
    {
        label: "Email",
        name: "email",
        type: "text",
        value: user.email,
    },
    {
        label: "Phone",
        name: "phone",
        type: "number",
        value: user.phone,
        placeholder: "Enter your phone number",
    },
    {
        label: "Password",
        name: "password",
        type: "password",
        value: user.password,
    },
];
---

<Layout>
    <section class="h-full flex items-center justify-center py-8 px-[1vw]">
        <div class="w-full rounded-lg shadow-md p-[1.5vw]">
            <h1 class="text-[2vw] max-[768px]:text-[1.5vw] font-bold mb-8">
                Account Information
            </h1>

            <div class="grid grid-cols-1 gap-[2vw]">
                {
                    formFields.map((field) => (
                        <EditableField
                            client:idle
                            userID={user.id}
                            field={field.name}
                            name={field.label}
                            type={field.type}
                            value={field.value}
                        />
                    ))
                }
            </div>
            <div class="mt-[1.5vw]">
                <Delete
                    client:idle
                    name="this Account"
                    id={user.id}
                    imagePath={user.profile_pic}
                    type="user"
                    onDelete=""
                />
            </div>
        </div>
    </section>
</Layout>
