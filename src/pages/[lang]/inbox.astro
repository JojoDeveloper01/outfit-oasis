---
import { getLangFromUrl } from "@i18n/utils";
import Layout from "@layouts/Layout.astro";
import { getMessagesForUser, userExistsByID } from "@lib/dbFunctions";

const lang = getLangFromUrl(Astro.url);

let $user: any;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    const id = Number(getCookie?.value);
    $user = await userExistsByID(`${id}`);
}

const user = $user;
if (!user) return Astro.redirect(`/${lang}/`);

const messages = await getMessagesForUser(user.id);
---

<Layout
    title="Inbox"
    description="Sistema de mensagens"
    keywords="mensagens, chat"
>
    <section
        class="bg-gray-100 max-w-md mx-auto p-4 rounded-lg shadow-lg flex flex-col gap-4"
    >
        <h1 class="text-2xl font-bold text-center">Inbox</h1>

        <div
            class="chat-box overflow-y-auto border border-gray-300 rounded-lg bg-white p-4 h-96"
        >
            <ul id="messages" class="space-y-4">
                {
                    messages && messages.length > 0 ? (
                        messages.map((msg: any) => (
                            <li
                                class={`chat-message ${
                                    msg.sender_id === user.id
                                        ? "bg-blue-500 text-white self-end"
                                        : "bg-gray-200 text-black self-start"
                                } w-1/2 p-3 rounded-lg max-w-[70%]`}
                            >
                                <strong class="block font-medium">
                                    {msg.sender_id === user.id
                                        ? "Você"
                                        : msg.sender_name}
                                    :
                                </strong>
                                <span class="block">{msg.content}</span>
                                <em class="text-xs text-gray-500 mt-2 block">
                                    {msg.created_at
                                        ? new Date(
                                              Date.parse(msg.created_at),
                                          ).toLocaleTimeString()
                                        : ""}
                                </em>
                            </li>
                        ))
                    ) : (
                        <p class="text-gray-500 text-center">
                            Nenhuma mensagem ainda.
                        </p>
                    )
                }
            </ul>
        </div>

        <form id="sendMessageForm" class="flex items-center gap-2">
            <textarea
                id="messageInput"
                class="flex-1 border border-gray-300 rounded-lg p-2 text-sm focus:outline-none focus:ring focus:ring-blue-300"
                placeholder="Digite sua mensagem..."
                required></textarea>
            <input type="hidden" id="userId" value={user.id} />
            <input type="hidden" id="receiverId" value="62" />
            <button
                type="submit"
                class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition"
            >
                Enviar
            </button>
        </form>
    </section>
</Layout>

<script>
    import { actions } from "astro:actions";

    document.addEventListener("astro:page-load", () => {
        const form = document.querySelector("#sendMessageForm") as HTMLElement;
        const messagesList = document.querySelector("#messages");

        form.addEventListener("submit", async (e) => {
            e.preventDefault(); // Impede o recarregamento da página

            const messageInput = document.querySelector(
                "#messageInput",
            ) as HTMLInputElement;
            const receiverIdInput = document.querySelector(
                "#receiverId",
            ) as HTMLInputElement;
            const userIdInput = document.querySelector(
                "#userId",
            ) as HTMLInputElement;

            const content = messageInput.value.trim();
            const receiverId = Number(receiverIdInput.value);
            const senderId = Number(userIdInput.value);

            if (!content) {
                alert("Por favor, digite uma mensagem.");
                return;
            }

            const { data, error } = await actions.sendMessage({
                senderId,
                receiverId,
                content,
            });

            if (data?.success) {
                // Determina se a mensagem é enviada ou recebida
                const isSender = senderId === Number(userIdInput.value);

                // Cria o contêiner (div pai)
                const messageContent = document.createElement("div");
                messageContent.className = `w-full flex ${
                    isSender ? "justify-end" : "justify-start"
                }`;

                // Cria o item da mensagem
                const newMessage = document.createElement("li");
                newMessage.className = `
                    chat-message w-1/2 ${
                        isSender
                            ? "bg-blue-500 text-white"
                            : "bg-gray-200 text-black"
                    } p-3 rounded-lg max-w-[70%]`;
                newMessage.innerHTML = `
                    <strong>${isSender ? "Você" : "Outro Usuário"}:</strong>
                    <span>${content}</span>
                    <em class="text-xs text-gray-500 mt-2 block">${new Date().toLocaleTimeString()}</em>
                `;

                // Adiciona o li ao div
                messageContent.appendChild(newMessage);

                // Adiciona o div à lista de mensagens
                messagesList?.appendChild(messageContent);

                // Limpa o campo de entrada
                messageInput.value = "";
            } else {
                alert("Erro ao enviar mensagem.");
                console.error(error);
            }
        });
    });
</script>
