---
import Layout from "@layouts/Layout.astro";
import Items from "@components/Items.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { getItems } from "@lib/dbFunctions";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

let items = await getItems();
---

<Layout
    title="inventory"
    description="O teu relevante lugar de aluguer de roupa"
    keywords="aluguer, roupa, "
    canonical="https://outfit-oasis.com"
>
    <section class="container m-auto py-8">
        <h1 class="mb-12">inventory</h1>
        <Items items={items} />
    </section>
</Layout>
