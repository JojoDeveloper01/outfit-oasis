---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Dashboard from "@layouts/AsideDashboard.astro";
import ItemList from "@components/Items/ItemList";
import Alerts from "@components/Modal/Alerts.astro";
import { getItems, getRentals, getUsers } from "@lib/dbFunctions";
import { userExistsByID } from "@lib/dbFunctions";
import { actions, isInputError } from "astro:actions";
import type { Item } from "@lib/functions";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

let items = (await getItems()) as unknown as Item[];

console.log("items: ", items);

let id: number;
let $user: any;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    id = Number(getCookie?.value);

    $user = await userExistsByID(`${id}`);
    // console.log($user);
}

const user = $user;

// Tratamento de erros
let alertMessage = "";
let alertType = "success";

const addItemResult = Astro.getActionResult(actions.addItem);

if (addItemResult?.error) {
    if (isInputError(addItemResult.error)) {
        // Captura erros específicos do Zod
        alertMessage = Object.entries(addItemResult.error.fields)
            .map(([field, errors]) => `${field}: ${errors.join(", ")}`)
            .join("; ");
    } else {
        // Outros erros gerais
        alertMessage = addItemResult.error.message;
    }
    alertType = "error";
} else if (addItemResult?.data) {
    alertMessage = "Item added successfully!";
}

const users = await getUsers();
const rentals = await getRentals();
---

<Dashboard>
    <h1 class="text-[2vw] md:text-[1.5vw]">Item management</h1>

    <!-- Global error message -->
    {alertMessage && <Alerts message={alertMessage} type={alertType} />}

    <!-- Add New Item Form -->
    <details>
        <summary>
            <span>Add New Item</span>
            <svg
                class="w-4 h-4 transition-transform group-open:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 10 6"
            >
                <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5 5 1 1 5"></path>
            </svg>
        </summary>

        <div class="p-6 bg-[--gray]">
            <form
                action={actions.addItem}
                method="POST"
                class="space-y-6"
                enctype="multipart/form-data"
            >
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
                >
                    <div class="grid gap-4">
                        <label for="name">Name</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter the item's name"
                            required
                        />
                    </div>

                    <div class="grid gap-4">
                        <label for="category">Category</label>
                        <input
                            type="text"
                            id="category"
                            name="category"
                            placeholder="Enter the item's category"
                            required
                        />
                    </div>

                    <div class="grid gap-4">
                        <label for="type">Type</label>
                        <select id="type" name="type" required>
                            <option value="">Select a Type</option>
                            <option value="clothing">Clothing</option>
                            <option value="footwear">Footwear</option>
                            <option value="other">Other</option>
                        </select>
                    </div>

                    <div class="grid gap-4">
                        <label for="size">Size</label>
                        <select id="size" name="size" required>
                            <option value="">Select a size</option>
                            <option value="XS">XS</option>
                            <option value="S">S</option>
                            <option value="M">M</option>
                            <option value="L">L</option>
                            <option value="XL">XL</option>
                            <option value="XXL">XXL</option>
                        </select>
                    </div>

                    <div class="grid gap-4">
                        <label for="color">Color</label>
                        <select id="color" name="color" required>
                            <option value="">Select a color</option>
                            <option value="red">Red</option>
                            <option value="blue">Blue</option>
                            <option value="yellow">Yellow</option>
                            <option value="green">Green</option>
                            <option value="brown">Brown</option>
                            <option value="black">Black</option>
                            <option value="white">White</option>
                            <option value="other">Other</option>
                        </select>
                    </div>

                    <div class="grid gap-4">
                        <label for="brand">Brand</label>
                        <input
                            type="text"
                            id="brand"
                            name="brand"
                            placeholder="Enter the item's brand"
                            required
                        />
                    </div>

                    <div class="grid gap-4">
                        <label for="condition">Condition</label>
                        <select id="condition" name="condition" required>
                            <option value="">Select a condition</option>
                            <option value="new">New</option>
                            <option value="used">Used</option>
                            <option value="worn">Worn</option>
                        </select>
                    </div>

                    <div class="grid gap-4">
                        <label for="rental_price">Rental Price</label>
                        <input
                            type="text"
                            id="rental_price"
                            name="rental_price"
                            placeholder="Enter rental price"
                            required
                        />
                    </div>

                    <div
                        class="field col-span-1 max-[768px]:col-span-2 lg:col-span-1"
                    >
                        <label for="image">Image</label>
                        <input
                            type="file"
                            id="image"
                            name="image"
                            accept="image/*"
                            class="block w-full text-[1vw] text-[--gold] file:mr-[1vw] file:py-[.6vw] file:px-[1vw] file:rounded-full file:border-0 file:bg-[--gold] file:text-white hover:file:bg-[--gold]"
                        />
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="flex justify-end">
                    <button
                        type="submit"
                        class="px-5 py-[.6vw] bg-[--gold] text-black font-medium rounded-lg shadow hover:bg-yellow-100 focus:ring-4 focus:ring-yellow-100"
                    >
                        Create User
                    </button>
                </div>
            </form>
        </div>
    </details>

    <!-- Items List -->
    <ItemList
        client:load
        items={items}
        users={users}
        rentals={rentals}
        lang={lang}
        userType="staff"
    />
</Dashboard>
