---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Dashboard from "@layouts/AsideDashboard.astro";
import ItemList from "@components/Items/ItemList";
import Alerts from "@components/Modal/Alerts.astro";
import { getItems, getRentals, getUsers } from "@lib/dbFunctions";
import { userExistsByID } from "@lib/dbFunctions";
import { actions, isInputError } from "astro:actions";
import type { Item } from "@lib/functions";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

let items = (await getItems()) as unknown as Item[];

//console.log("items: ", items);

let id: number;
let $user: any;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    id = Number(getCookie?.value);

    $user = await userExistsByID(`${id}`);
    // console.log($user);
}

const user = $user;

// Tratamento de erros
let alertMessage = "";
let alertType = "success";

const addItemResult = Astro.getActionResult(actions.addItem);

if (addItemResult?.error) {
    if (isInputError(addItemResult.error)) {
        // Captura erros específicos do Zod
        alertMessage = Object.entries(addItemResult.error.fields)
            .map(([field, errors]) => `${field}: ${errors.join(", ")}`)
            .join("; ");
    } else {
        // Outros erros gerais
        alertMessage = addItemResult.error.message;
    }
    alertType = "error";
} else if (addItemResult?.data) {
    alertMessage = "Item added successfully!";
}

const users = await getUsers();
const rentals = await getRentals();
---

<Dashboard>
    <h1 class="text-[2vw] md:text-[1.5vw]">{t("dash.itemTitle")}</h1>

    <!-- Global error message -->
    {alertMessage && <Alerts message={alertMessage} type={alertType} />}

    <!-- Add New Item Form -->
    <details>
        <summary>
            <span> {t("dash.addNewItem")} </span>
            <svg
                class="w-4 h-4 transition-transform group-open:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 10 6"
            >
                <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5 5 1 1 5"></path>
            </svg>
        </summary>

        <div class="p-6 bg-[--gray]">
            <form
                action={actions.addItem}
                method="POST"
                class="space-y-6"
                enctype="multipart/form-data"
            >
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
                >
                    <div class="grid gap-4">
                        <label for="name">{t("home.name")}</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder={t("util.namePlaceHolder")}
                            required
                        />
                    </div>

                    <div class="grid gap-4">
                        <label for="category">{t("dash.category")}</label>
                        <input
                            type="text"
                            id="category"
                            name="category"
                            placeholder={t("dash.categoryPlaceHolder")}
                            required
                        />
                    </div>

                    <div class="grid gap-4">
                        <label for="type">{t("dash.type")}</label>
                        <select id="type" name="type" required>
                            <option value="">{t("dash.selectType")}</option>
                            <option value="clothing"
                                >{t("dash.clothing")}</option
                            >
                            <option value="footwear"
                                >{t("dash.footwear")}</option
                            >
                            <option value="other">{t("dash.other")}</option>
                        </select>
                    </div>

                    <div class="grid gap-4">
                        <label for="size">{t("dash.size")}</label>
                        <select id="size" name="size" required>
                            <option value="">{t("dash.selectSize")}</option>
                            <option value="XS">XS</option>
                            <option value="S">S</option>
                            <option value="M">M</option>
                            <option value="L">L</option>
                            <option value="XL">XL</option>
                            <option value="XXL">XXL</option>
                        </select>
                    </div>

                    <div class="grid gap-4">
                        <label for="color">{t("dash.color")}</label>
                        <select id="color" name="color" required>
                            <option value="">{t("dash.selectColor")}</option>
                            <option value="red">{t("color.red")}</option>
                            <option value="blue">{t("color.blue")}</option>
                            <option value="yellow">{t("color.yellow")}</option>
                            <option value="green">{t("color.green")}</option>
                            <option value="brown">{t("color.brown")}</option>
                            <option value="black">{t("color.black")}</option>
                            <option value="white">{t("color.white")}</option>
                            <option value="other">{t("color.other")}</option>
                        </select>
                    </div>

                    <div class="grid gap-4">
                        <label for="brand">{t("dash.brand")}</label>
                        <input
                            type="text"
                            id="brand"
                            name="brand"
                            placeholder="Enter the item's brand"
                            required
                        />
                    </div>

                    <div class="grid gap-4">
                        <label for="condition">{t("dash.condition")}</label>
                        <select id="condition" name="condition" required>
                            <option value="">{t("dash.selectCondition")}</option
                            >
                            <option value="new">{t("dash.new")}</option>
                            <option value="used">{t("dash.used")}</option>
                            <option value="worn">{t("dash.worn")}</option>
                        </select>
                    </div>

                    <div class="grid gap-4">
                        <label for="rental_price">{t("dash.rentalPrice")}</label
                        >
                        <input
                            type="text"
                            id="rental_price"
                            name="rental_price"
                            placeholder={t("dash.enterRentalPrice")}
                            required
                        />
                    </div>

                    <div
                        class="field col-span-1 max-[768px]:col-span-2 lg:col-span-1"
                    >
                        <label for="image">{t("dash.image")}</label>
                        <input
                            type="file"
                            id="image"
                            name="image"
                            accept="image/*"
                            class="block w-full text-[1vw] text-[--gold] file:mr-[1vw] file:py-[.6vw] file:px-[1vw] file:rounded-full file:border-0 file:bg-[--gold] file:text-white hover:file:bg-[--gold]"
                        />
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="flex justify-end">
                    <button
                        type="submit"
                        class="px-5 py-[.6vw] bg-[--gold] text-black font-medium rounded-lg shadow hover:bg-yellow-100 focus:ring-4 focus:ring-yellow-100"
                    >
                        {t("dash.createUser")}
                    </button>
                </div>
            </form>
        </div>
    </details>

    <!-- Items List -->
    <ItemList
        client:load
        items={items}
        users={users}
        rentals={rentals}
        lang={lang}
        userType="staff"
    />
</Dashboard>
