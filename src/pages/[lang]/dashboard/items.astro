---
import Dashboard from "@layouts/AsideDashboard.astro";
import { getItems, addItem, editItem, deleteItem } from "@lib/dbFunctions";

// Define the type for errors
interface Errors {
    global?: string; // Optional "global" error field
}

const errors: Errors = {}; // Initialize errors with the defined type
let items = await getItems();

console.log(items);

// Handle form submission
if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const action = data.get("action");

        // Common fields
        const name = data.get("name")?.toString().trim();
        const type = data.get("type")?.toString().trim();
        const category = data.get("brand")?.toString().trim();
        const size = data.get("size")?.toString().trim();
        const color = data.get("color")?.toString().trim();
        const brand = data.get("brand")?.toString().trim();
        const rental_price = data.get("rental_price")?.toString().trim();
        const condition = data.get("condition")?.toString().trim();

        // Validation

        if (
            !name ||
            !type ||
            !category ||
            !size ||
            !color ||
            !brand ||
            !rental_price ||
            !condition
        ) {
            errors.global = "All fields are required!";
        } else if (action === "add") {
            await addItem(
                name,
                type,
                category,
                size,
                color,
                brand,
                rental_price,
                condition,
            );
        } else if (action === "edit") {
            const id = data.get("id");
            const field = "";

            if (!id) throw new Error("Missing item ID for editing.");

            await editItem(Number(id), field);
        } else if (action === "delete") {
            const id = data.get("id");
            if (!id) throw new Error("Missing item ID for deletion.");
            await deleteItem(Number(id));
        }

        // Refresh items after any action
        items = await getItems();
    } catch (error) {
        if (error instanceof Error) {
            errors.global = error.message; // Assign the error message to the global field
        } else {
            errors.global = "An unexpected error occurred.";
        }
    }
}
---

<style>
    button {
        background-color: var(--color-white);
        color: unset;

        &:hover {
            color: unset;
        }
    }
</style>

<Dashboard>
    <h1>Inventory</h1>

    <!-- Global error message -->
    {errors.global && <p class="text-red-600">{errors.global}</p>}

    <!-- Add New Item Form -->
    <div id="accordion-collapse" class="my-16" data-accordion="collapse">
        <h2 id="accordion-collapse-heading-1">
            <button
                type="button"
                class="flex items-center justify-between w-full p-5 font-medium text-gray-500 border border-b-0 border-gray-200 rounded-t-xl focus:ring-4 focus:ring-gray-200 gap-3"
                data-accordion-target="#accordion-collapse-body-1"
                aria-expanded="false"
                aria-controls="accordion-collapse-body-1"
            >
                <span>Add New Item</span>
                <svg
                    data-accordion-icon
                    class="w-3 h-3 rotate-180 shrink-0"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 10 6"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5 5 1 1 5"></path>
                </svg>
            </button>
        </h2>
        <div id="accordion-collapse-body-1" class="hidden">
            <div class="p-5 border border-b-0 border-gray-200 bg-[--color5]">
                <form method="POST" class="space-y-4">
                    <input type="hidden" name="action" value="add" />
                    <div>
                        <label
                            for="name"
                            class="block text-sm font-medium text-gray-700 mb-1"
                        >
                            Name
                        </label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter the item's name"
                            class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                            required
                        />
                    </div>
                    <div>
                        <label
                            for="size"
                            class="block text-sm font-medium text-gray-700 mb-1"
                        >
                            Size
                        </label>
                        <select
                            id="size"
                            name="size"
                            class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                            required
                        >
                            <option value="">Select a size</option>
                            <option value="PP">PP</option>
                            <option value="P">P</option>
                            <option value="M">M</option>
                            <option value="L">L</option>
                            <option value="XL">XL</option>
                        </select>
                    </div>
                    <div>
                        <label
                            for="brand"
                            class="block text-sm font-medium text-gray-700 mb-1"
                        >
                            Brand
                        </label>
                        <input
                            type="text"
                            id="brand"
                            name="brand"
                            placeholder="Enter the item's brand"
                            class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                            required
                        />
                    </div>
                    <div>
                        <label
                            for="color"
                            class="block text-sm font-medium text-gray-700 mb-1"
                        >
                            Color
                        </label>
                        <input
                            type="text"
                            id="color"
                            name="color"
                            placeholder="Enter the item's color"
                            class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                            required
                        />
                    </div>
                    <div>
                        <label
                            for="brand"
                            class="block text-sm font-medium text-gray-700 mb-1"
                        >
                            brand
                        </label>
                        <input
                            type="text"
                            id="brand"
                            name="brand"
                            placeholder="Enter the item's brand"
                            class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                            required
                        />
                    </div>
                    <div>
                        <label
                            for="rental_price"
                            class="block text-sm font-medium text-gray-700 mb-1"
                        >
                            rental price
                        </label>
                        <input
                            type="number"
                            id="rental_price"
                            name="rental_price"
                            placeholder="Enter the item's rental_price"
                            class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                            required
                        />
                    </div>
                    <div>
                        <label
                            for="size"
                            class="block text-sm font-medium text-gray-700 mb-1"
                        >
                            Size
                        </label>
                        <select
                            id="size"
                            name="size"
                            class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                            required
                        >
                            <option value="">Select a condition</option>
                            <option value="Used">Used</option>
                            <option value="New">New</option>
                        </select>
                    </div>
                    <div class="flex justify-end">
                        <button
                            type="submit"
                            class="px-5 py-2.5 bg-[--gold] text-[--color-white] font-medium rounded-lg shadow hover:bg-[--color2] focus:ring-4 focus:ring-[--color-white]"
                        >
                            Create Item
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Inventory List -->

    <ul class="mt-6 space-y-6">
        {
            items.map((item: any) => (
                <li class="w-60 p-6 bg-white shadow-lg rounded-lg border-2 border-gray-300 flex flex-col space-y-4">
                    <div class="flex flex-col space-y-2">
                        <h3 class="text-2xl font-bold text-gray-800">
                            {item.name}
                        </h3>
                        <div class="grid gap-2 text-base text-gray-600">
                            <p class="font-medium">
                                Size: <span>{item.size}</span>
                            </p>
                            <p class="font-medium">
                                Brand: <span>{item.brand}</span>
                            </p>
                            <p class="font-medium">
                                Color: <span>{item.color}</span>
                            </p>
                        </div>
                    </div>
                    <div class="flex justify-end space-x-4">
                        <form method="POST">
                            <input type="hidden" name="action" value="edit" />
                            <input type="hidden" name="id" value={item.id} />
                            <input
                                type="hidden"
                                name="name"
                                value={item.name}
                            />
                            <input
                                type="hidden"
                                name="size"
                                value={item.size}
                            />
                            <input
                                type="hidden"
                                name="brand"
                                value={item.brand}
                            />
                            <input
                                type="hidden"
                                name="color"
                                value={item.color}
                            />
                            <button class="px-4 py-2 text-white rounded-full shadow-md hover:bg-[--color2] focus:outline-none">
                                Edit
                            </button>
                        </form>
                        <form method="POST">
                            <input type="hidden" name="action" value="delete" />
                            <input type="hidden" name="id" value={item.id} />
                            <button class="px-4 py-2 text-white rounded-full shadow-md hover:bg-[--color2] focus:outline-none">
                                Delete
                            </button>
                        </form>
                    </div>
                </li>
            ))
        }
    </ul>
</Dashboard>

