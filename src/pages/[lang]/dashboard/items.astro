---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Dashboard from "@layouts/AsideDashboard.astro";
import ListItems from "@components/ListItems.astro";
import { getItems, addItem, editItem, deleteItem } from "@lib/dbFunctions";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Define the type for errors
interface Errors {
    global?: string; // Optional "global" error field
}

const errors: Errors = {}; // Initialize errors with the defined type
let items = await getItems();

// Handle form submission
if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const action = data.get("action");

        // Common fields
        const id = data.get("id")?.toString().trim();
        const name = data.get("name")?.toString().trim();
        const type = data.get("type")?.toString().trim();
        const category = data.get("category")?.toString().trim();
        const size = data.get("size")?.toString().trim();
        const color = data.get("color")?.toString().trim();
        const brand = data.get("brand")?.toString().trim();
        const rental_price = data.get("rental_price")?.toString().trim();
        const condition = data.get("condition")?.toString().trim();

        // Validation and Actions
        if (action === "add") {
            // Ensure all fields are provided for adding a new item

            if (
                !name ||
                !type ||
                !category ||
                !size ||
                !color ||
                !brand ||
                !rental_price ||
                !condition
            ) {
                throw new Error("All fields must be filled in.");
            }

            try {
                await addItem(
                    name,
                    type,
                    category,
                    size,
                    color,
                    brand,
                    rental_price,
                    condition,
                );
            } catch (error) {
                errors.global = "Failed to add item. Please try again.";
            }
        } else if (action === "edit") {
            // Ensure at least an `id` is provided for editing
            if (!id) {
                throw new Error("Missing item ID for editing.");
            }

            // Ensure at least one field is being updated
            if (
                !name ||
                !type ||
                !category ||
                !size ||
                !color ||
                !brand ||
                !rental_price ||
                !condition
            ) {
                throw new Error(
                    "At least one field must be provided for editing.",
                );
            }

            // Call editItem with individual fields
            await editItem(
                Number(id),
                name,
                type,
                category,
                size,
                color,
                brand,
                rental_price,
                condition,
            );
        } else if (action === "delete") {
            // Ensure an `id` is provided for deletion
            if (!id) {
                throw new Error("Missing item ID for deletion.");
            }

            await deleteItem(Number(id));
        }

        // Refresh items after any action
        items = await getItems();
    } catch (error) {
        if (error instanceof Error) {
            errors.global = error.message; // Assign the error message to the global field
        } else {
            errors.global = "An unexpected error occurred.";
        }
    }
}
---

<style>
    .col-wrap {
        display: flex;
        gap: 1rem;

        & > * {
            flex: 1;
        }
    }
    button {
        background-color: var(--color-white);
        color: unset;

        &:hover {
            color: unset;
        }
    }

    @media screen and (max-width: 900px) {
        .col-wrap {
            display: grid;

            & > * {
                width: 10 0%;
            }
        }
    }
</style>

<Dashboard>
    <h1>Items</h1>

    <!-- Global error message -->
    {errors.global && <p class="text-red-600">{errors.global}</p>}

    <!-- Add New Item Form -->
    <div
        id="accordion-collapse"
        class="max-w-screen-desktop my-16"
        data-accordion="collapse"
    >
        <h2 id="accordion-collapse-heading-1">
            <button
                type="button"
                id="accordion-new-item"
                class="flex items-center justify-between w-full p-5 font-medium text-gray-500 border border-b-0 border-gray-200 rounded-t-xl focus:ring-4 focus:ring-gray-200 gap-3"
                data-accordion-target="#accordion-collapse-body-1"
                aria-expanded="false"
                aria-controls="accordion-collapse-body-1"
            >
                <span>Add New Item</span>
                <svg
                    data-accordion-icon
                    class="w-3 h-3 rotate-180 shrink-0"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 10 6"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5 5 1 1 5"></path>
                </svg>
            </button>
        </h2>
        <div id="accordion-collapse-body-1" class="hidden">
            <div class="p-5 border border-b-0 border-gray-200 bg-[--color5]">
                <form method="POST" class="space-y-4">
                    <input type="hidden" name="action" value="add" />
                    <div class="col-wrap">
                        <div>
                            <label
                                for="name"
                                class="block text-sm font-medium text-white mb-1"
                            >
                                Name
                            </label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="Enter the item's name"
                                class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                                required
                            />
                        </div>
                        <div>
                            <label
                                for="type"
                                class="block text-sm font-medium text-white mb-1"
                            >
                                type
                            </label>
                            <select
                                id="type"
                                name="type"
                                class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                                required
                            >
                                <option value="">Select a Type</option>
                                <option value="clothing">clothing</option>
                                <option value="footwear">footwear</option>
                                <option value="other">other</option>
                            </select>
                        </div>
                        <div>
                            <label
                                for="category"
                                class="block text-sm font-medium text-white mb-1"
                            >
                                Category
                            </label>
                            <input
                                type="text"
                                id="category"
                                name="category"
                                placeholder="Enter the item's category"
                                class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                                required
                            />
                        </div>
                    </div>

                    <div class="col-wrap">
                        <div>
                            <label
                                for="size"
                                class="block text-sm font-medium text-white mb-1"
                            >
                                Size
                            </label>
                            <select
                                id="size"
                                name="size"
                                class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                                required
                            >
                                <option value="">Select a size</option>
                                <option value="PP">PP</option>
                                <option value="P">P</option>
                                <option value="M">M</option>
                                <option value="L">L</option>
                                <option value="XL">XL</option>
                            </select>
                        </div>

                        <div>
                            <label
                                for="color"
                                class="block text-sm font-medium text-white mb-1"
                            >
                                Color
                            </label>
                            <input
                                type="text"
                                id="color"
                                name="color"
                                placeholder="Enter the item's color"
                                class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                                required
                            />
                        </div>
                        <div>
                            <label
                                for="brand"
                                class="block text-sm font-medium text-white mb-1"
                            >
                                brand
                            </label>
                            <input
                                type="text"
                                id="brand"
                                name="brand"
                                placeholder="Enter the item's brand"
                                class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                                required
                            />
                        </div>
                    </div>

                    <div class="col-wrap">
                        <div>
                            <label
                                for="rental_price"
                                class="block text-sm font-medium text-white mb-1"
                            >
                                rental price
                            </label>
                            <input
                                type="number"
                                id="rental_price"
                                name="rental_price"
                                placeholder="Enter the item's rental_price"
                                class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                                required
                            />
                        </div>
                        <div>
                            <label
                                for="condition"
                                class="block text-sm font-medium text-white mb-1"
                            >
                                Condition
                            </label>
                            <select
                                id="condition"
                                name="condition"
                                class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                                required
                            >
                                <option value="">Select a condition</option>
                                <option value="new">New</option>
                                <option value="used">Used</option>
                                <option value="worn">Worn</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex justify-end">
                        <button
                            type="submit"
                            class="px-5 py-2.5 bg-[--gold] text-[--color-white] font-medium rounded-lg shadow hover:bg-[--color2] focus:ring-4 focus:ring-[--color-white]"
                        >
                            Create Item
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Items List -->
    <ListItems items={items} />
</Dashboard>

<script>
    document.addEventListener("astro:page-load", () => {
        const accordion = document.getElementById("accordion-collapse-body-1");
        const buttonNewItem = document.getElementById("accordion-new-item");

        buttonNewItem?.addEventListener("click", () => {
            accordion?.classList.toggle("hidden");
        });

        //the button is in the item component
        document.querySelectorAll(".edit-item").forEach((button) => {
            button.addEventListener("click", (event: any) => {
                // Obtém o contêiner pai do botão clicado
                const parentContainer = button.closest(
                    ".item-container",
                ) as HTMLElement;

                // Esconde os botões "Edit" e "Delete" apenas no contêiner pai
                parentContainer
                    .querySelector("#edit-delete")
                    ?.classList.add("hidden");

                const listItem = event.target.closest("li"); // Get the parent <li>
                const fieldsContainer = listItem.querySelector(".item-fields"); // Get the fields container

                if (!fieldsContainer) return;

                const fields = Array.from(fieldsContainer.children); // Get all the <p> elements
                const itemId = listItem.getAttribute("data-item-id"); // Get the item ID

                // Replace fields with inputs
                fieldsContainer.innerHTML = `
            <form method="POST" class="space-y-2">
                <input type="hidden" name="action" value="edit" />
                <input type="hidden" name="id" value="${itemId}" />
                ${fields
                    .map((field: any) => {
                        const labelElement = field.querySelector(".font-bold"); // Get the label
                        const valueElement =
                            field.querySelector(".value-field"); // Get the value

                        if (!labelElement || !valueElement) return ""; // Skip if elements are missing

                        const label = labelElement.textContent?.trim() || ""; // Extract the label
                        const value = valueElement.textContent?.trim() || ""; // Extract the value
                        const name = label.toLowerCase().replace(/ /g, "_"); // Convert label to a valid input name

                        return `
                            <label class="block">
                                ${label}
                                <input
                                    type="text"
                                    name="${name}"
                                    value="${value}"
                                    class="block w-full px-3 py-1.5 border border-gray-300 rounded-lg focus:ring-[--teal] focus:border-[--teal]"
                                />
                            </label>
                        `;
                    })
                    .join("")}
                        <div class="flex space-x-2">
                            <button
                                type="submit"
                                class="px-4 py-2 text-white bg-[--teal] rounded-full shadow-md hover:bg-[--color2] focus:outline-none"
                            >
                                Save
                            </button>
                            <button
                                type="button"
                                class="px-4 py-2 text-white bg-[--blush] rounded-full shadow-md hover:bg-[--color3] focus:outline-none cancel-edit"
                            >
                                Cancel
                            </button>
                        </div>
                    </form>
                `;
                // Add Cancel functionality
                const cancelButton = listItem.querySelector(".cancel-edit");
                cancelButton.addEventListener("click", () => {
                    location.reload(); // Reload the page to reset the fields
                });
            });
        });
    });
</script>
