---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Dashboard from "@layouts/AsideDashboard.astro";
import ItemList from "@components/Items/ItemList";
import Alerts from "@components/Modal/Alerts.astro";
import { getItems, getRentals, getUsers } from "@lib/dbFunctions";
import { userExistsByID } from "@lib/dbFunctions";
import { actions, isInputError } from "astro:actions";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

let items = await getItems();

let id: number;
let $user: any;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    id = Number(getCookie?.value);

    $user = await userExistsByID(`${id}`);
    // console.log($user);
}

const user = $user;

// Tratamento de erros
let alertMessage = "";
let alertType = "success";

const addItemResult = Astro.getActionResult(actions.addItem);

if (addItemResult?.error) {
    if (isInputError(addItemResult.error)) {
        // Captura erros específicos do Zod
        alertMessage = Object.entries(addItemResult.error.fields)
            .map(([field, errors]) => `${field}: ${errors.join(", ")}`)
            .join("; ");
    } else {
        // Outros erros gerais
        alertMessage = addItemResult.error.message;
    }
    alertType = "error";
} else if (addItemResult?.data) {
    alertMessage = "Item added successfully!";
}

const users = await getUsers();
const rentals = await getRentals();
---

<style>
    .col-wrap {
        display: flex;
        gap: 1rem;

        & > * {
            flex: 1;
        }
    }
    button {
        background-color: var(--color-white);
        color: unset;

        &:hover {
            color: unset;
        }
    }

    @media screen and (max-width: 900px) {
        .col-wrap {
            display: grid;

            & > * {
                width: 10 0%;
            }
        }
    }
</style>

<Dashboard>
    <h1>Manage Items</h1>

    <!-- Global error message -->
    {alertMessage && <Alerts message={alertMessage} type={alertType} />}

    <!-- Add New Item Form -->
    <details
        class="max-w-screen-desktop my-[5vw] group border border-gray-200 rounded-lg"
    >
        <summary
            class="flex items-center justify-between cursor-pointer p-5 font-medium text-gray-500 rounded-t-lg hover:bg-gray-100"
        >
            <span>Add New Item</span>
            <svg
                class="w-3 h-3 transition-transform group-open:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 10 6"
            >
                <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5 5 1 1 5"></path>
            </svg>
        </summary>

        <div class="p-5 border-t border-gray-200 rounded-b-lg">
            <form
                action={actions.addItem}
                method="POST"
                class="space-y-4"
                enctype="multipart/form-data"
            >
                <div
                    class="grid grid-cols-1 max-[768px]:grid-cols-2 lg:grid-cols-3 gap-[1.5vw]"
                >
                    <!-- name Field -->
                    <div>
                        <label for="name"> Name </label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter the item's name"
                            autocomplete="name"
                            required
                        />
                    </div>

                    <!-- Category Field -->
                    <div>
                        <label for="category"> Category </label>
                        <input
                            type="text"
                            id="category"
                            name="category"
                            placeholder="Enter the item's category"
                            autocomplete="category"
                            required
                        />
                    </div>

                    <!-- type Field -->
                    <div>
                        <label for="type"> type </label>
                        <select id="type" name="type" required>
                            <option value="">Select a Type</option>
                            <option value="clothing">clothing</option>
                            <option value="footwear">footwear</option>
                            <option value="other">other</option>
                        </select>
                    </div>

                    <!-- Size Field -->
                    <div>
                        <label for="size"> Size </label>
                        <select id="size" name="size" required>
                            <option value="">Select a size</option>
                            <option value="XS">XS</option>
                            <option value="S">S</option>
                            <option value="M">M</option>
                            <option value="L">L</option>
                            <option value="XL">XL</option>
                            <option value="XXL">XXL</option>
                        </select>
                    </div>

                    <!-- Color Field -->
                    <div>
                        <label for="color"> Color </label>
                        <select id="color" name="color" required>
                            <option value="">Select a color</option>
                            <option value="red">red</option>
                            <option value="blue">blue</option>
                            <option value="yellow">yellow</option>
                            <option value="green">green</option>
                            <option value="brown">brown</option>
                            <option value="black">black</option>
                            <option value="white">white</option>
                            <option value="other">other</option>
                        </select>
                    </div>

                    <!-- brand Field -->
                    <div>
                        <label for="brand"> brand </label>
                        <input
                            type="text"
                            id="brand"
                            name="brand"
                            placeholder="Enter the item's brand"
                            required
                        />
                    </div>

                    <!-- condition Field -->
                    <div>
                        <label for="condition"> Condition </label>
                        <select id="condition" name="condition" required>
                            <option value="">Select a condition</option>
                            <option value="new">New</option>
                            <option value="used">Used</option>
                            <option value="worn">Worn</option>
                        </select>
                    </div>

                    <!-- rental price Field -->
                    <div>
                        <label for="rental_price"> rental price </label>
                        <input
                            type="text"
                            id="rental_price"
                            name="rental_price"
                            placeholder="Enter the item's rental_price"
                            autocomplete="rental_price"
                            required
                        />
                    </div>

                    <!-- image Field -->
                    <div
                        class="col-span-1 max-[768px]:col-span-2 lg:col-span-1"
                    >
                        <label
                            for="image"
                            class="block text-[1vw] font-medium text-gray-700 mb-1"
                        >
                            image
                        </label>
                        <input
                            type="file"
                            id="image"
                            name="image"
                            accept="image/*"
                            class="block w-full text-[1vw] text-gray-700 file:mr-[1vw] file:py-[.6vw] file:px-[1vw] file:rounded-full file:border-0 file:bg-blue-600 file:text-white hover:file:bg-blue-700"
                        />
                    </div>
                </div>
                <div class="flex justify-end">
                    <button
                        type="submit"
                        class="px-5 py-[.6vw].5 bg-[--gold] text-[--color-white] font-medium rounded-lg shadow hover:bg-[--color-black] focus:ring-4 focus:ring-[--color-white]"
                    >
                        Create Item
                    </button>
                </div>
            </form>
        </div>
    </details>

    <!-- Items List -->
    <ItemList
        client:load
        items={items}
        users={users}
        rentals={rentals}
        lang={lang}
        userType="staff"
    />
</Dashboard>
