---
import BestSeller from "@components/BestSeller.astro";
import ItemTableUser from "@components/Items/ItemTableUser";
import UsersList from "@components/Users/UserList";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Dashboard from "@layouts/AsideDashboard.astro";
import {
    getAnalyticsData,
    getItems,
    getRentals,
    getUsers,
} from "@lib/dbFunctions";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang) as (key: string) => string;

let rows = await getItems();
let items = rows.map((row: any) => ({
    id: row.id,
    name: row.name,
    category: row.category,
    type: row.type,
    size: row.size,
    color: row.color,
    brand: row.brand,
    image: row.image,
    condition: row.condition,
    rental_price: row.rental_price,
    availability: row.availability,
    // map other properties as needed
}));
const rentals = await getRentals();

const analyticsData = await getAnalyticsData();
let users = await getUsers();

const { topPurchasedProducts } = analyticsData;
---

<Dashboard>
    <div class=`relative w-full h-[16rem]`>
        <div class="mb-3 ml-2">
            <a
                href={`/${lang}/dashboard/items`}
                class="flex items-center gap-3 text-yellow-200 text-[3vw] md:text-[.9vw] hover:underline"
            >
                {t("dash.goItems")}
                <img class="svg-yellow" src="/icons/redirect.svg" />
            </a>
        </div>
        <div class="h-full relative">
            <ItemTableUser
                client:load
                items={items}
                rentals={rentals}
                lang={lang}
                layoutDirection="horizontal"
                width="14rem"
            />
            <div
                class="w-fit h-full absolute flex items-center right-4 top-0 z-40"
            >
                <span
                    class="*:size-10 opacity-70 text-black *:drop-shadow-[0_35px_35px_rgba(255,255,255,1)] z-50 *:text-[#5f5f5f]"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-big-right-lines"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M12 9v-3.586a1 1 0 0 1 1.707 -.707l6.586 6.586a1 1 0 0 1 0 1.414l-6.586 6.586a1 1 0 0 1 -1.707 -.707v-3.586h-3v-6h3z"
                        ></path><path d="M3 9v6"></path><path d="M6 9v6"
                        ></path></svg
                    >
                </span>
            </div>
        </div>
    </div>

    <div class="w-full flex flex-wrap gap-[4vw] mt-[6vw] pb-[3vw]">
        <div>
            <div class="mb-3 ml-2">
                <a
                    href={`/${lang}/dashboard/analytics`}
                    class="flex items-center gap-3 text-yellow-200 text-[3vw] md:text-[.9vw] hover:underline"
                >
                    {t("dash.goAnalitycs")}
                    <img class="svg-yellow" src="/icons/redirect.svg" />
                </a>
            </div>
            <BestSeller
                server:defer
                lang={lang}
                topPurchasedProducts={topPurchasedProducts}
            />
        </div>

        <div class="min-w-[26rem]">
            <div class="mb-3 ml-2">
                <a
                    href={`/${lang}/dashboard/users`}
                    class="flex items-center gap-3 text-yellow-200 text-[3vw] md:text-[.9vw] hover:underline"
                >
                    {t("dash.goUsers")}
                    <img class="svg-yellow" src="/icons/redirect.svg" />
                </a>
            </div>
            <UsersList
                client:visible
                userType="client"
                users={users}
                lang={lang}
            />
        </div>
    </div>
</Dashboard>
