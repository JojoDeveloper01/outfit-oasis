---
import BestSeller from "@components/BestSeller.astro";
import ItemList from "@components/Items/ItemList";
import ItemTableUser from "@components/Items/ItemTableUser";
import UsersList from "@components/Users/UserList";
import { getLangFromUrl } from "@i18n/utils";
import Dashboard from "@layouts/AsideDashboard.astro";
import {
    getAnalyticsData,
    getItems,
    getRentals,
    getUsers,
} from "@lib/dbFunctions";

const lang = getLangFromUrl(Astro.url);

let rows = await getItems();
let items = rows.map((row: any) => ({
    id: row.id,
    name: row.name,
    category: row.category,
    type: row.type,
    size: row.size,
    color: row.color,
    brand: row.brand,
    image: row.image,
    condition: row.condition,
    rental_price: row.rental_price,
    availability: row.availability,
    // map other properties as needed
}));
const rentals = await getRentals();

const analyticsData = await getAnalyticsData();
let users = await getUsers();

const { topPurchasedProducts } = analyticsData;
---

<Dashboard>
    <h1>Bem-vindo ao Dashboard</h1>

    <section class="flex flex-wrap gap-8 mt-16">
        <div class=`relative w-full h-[15rem] mb-4`>
            <ItemTableUser
                client:load
                items={items}
                rentals={rentals}
                lang={lang}
                layoutDirection="horizontal"
                width="13rem"
            />
            <div
                class="w-fit h-full absolute flex items-center right-4 top-0 z-50"
            >
                <span
                    class="*:size-10 opacity-70 text-black *:drop-shadow-[0_35px_35px_rgba(255,255,255,1)] z-50 *:text-[#5f5f5f]"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-big-right-lines"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M12 9v-3.586a1 1 0 0 1 1.707 -.707l6.586 6.586a1 1 0 0 1 0 1.414l-6.586 6.586a1 1 0 0 1 -1.707 -.707v-3.586h-3v-6h3z"
                        ></path><path d="M3 9v6"></path><path d="M6 9v6"
                        ></path></svg
                    >
                </span>
            </div>
        </div>

        <div class="w-full flex flex-wrap gap-4">
            <BestSeller
                lang={lang}
                topPurchasedProducts={topPurchasedProducts}
            />

            <div class="min-w-[26rem] max-w-[35rem]">
                <UsersList client:load userType="client" users={users} />
            </div>
        </div>
    </section>
</Dashboard>
