---
import BestSeller from "@components/BestSeller.astro";
import ItemList from "@components/Items/ItemList";
import ItemTableUser from "@components/Items/ItemTableUser";
import UsersList from "@components/Users/UserList";
import { getLangFromUrl } from "@i18n/utils";
import Dashboard from "@layouts/AsideDashboard.astro";
import {
    getAnalyticsData,
    getItems,
    getRentals,
    getUsers,
} from "@lib/dbFunctions";

const lang = getLangFromUrl(Astro.url);

let rows = await getItems();
let items = rows.map((row: any) => ({
    id: row.id,
    name: row.name,
    category: row.category,
    type: row.type,
    size: row.size,
    color: row.color,
    brand: row.brand,
    image: row.image,
    condition: row.condition,
    rental_price: row.rental_price,
    availability: row.availability,
    // map other properties as needed
}));
const rentals = await getRentals();

const analyticsData = await getAnalyticsData();
let users = await getUsers();

const { topPurchasedProducts } = analyticsData;
---

<Dashboard>
    <h1>Bem-vindo ao Dashboard</h1>
    <p>Esta página é protegida por autenticação.</p>

    <section class="flex flex-wrap gap-4 mt-8">
        <div
            class="relative min-w-[19rem] max-w-[41rem] h-[35rem] mb-4 overflow-y-auto"
        >
            <ItemTableUser
                client:load
                items={items}
                rentals={rentals}
                lang={lang}
                layoutDirection="horizontal"
            />
            <div class="sticky flex justify-center bottom-6">
                <span
                    class="*:size-10 opacity-70 text-black *:drop-shadow-[0_35px_35px_rgba(255,255,255,1)] z-50"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="icon icon-tabler icons-tabler-filled icon-tabler-arrow-big-down-line"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M9 5l-.117 .007a1 1 0 0 0 -.883 .993v4.999l-2.586 .001a2 2 0 0 0 -1.414 3.414l6.586 6.586a2 2 0 0 0 2.828 0l6.586 -6.586a2 2 0 0 0 .434 -2.18l-.068 -.145a2 2 0 0 0 -1.78 -1.089l-2.586 -.001v-4.999a1 1 0 0 0 -1 -1h-6z"
                        ></path><path
                            d="M15 2a1 1 0 0 1 .117 1.993l-.117 .007h-6a1 1 0 0 1 -.117 -1.993l.117 -.007h6z"
                        ></path></svg
                    >
                </span>
            </div>
        </div>
        <BestSeller lang={lang} topPurchasedProducts={topPurchasedProducts} />

        <UsersList client:load userType="client" users={users} />
    </section>
</Dashboard>
