---
import BestSeller from "@components/BestSeller.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Dashboard from "@layouts/AsideDashboard.astro";
import { getAnalyticsData } from "@lib/dbFunctions";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang) as (key: string) => string;

// Busca dados para exibição
const analyticsData = await getAnalyticsData();
const {
    usersWhoPurchased,
    topPurchasedProducts,
    topRenters,
    totalRentalEarnings,
} = analyticsData;

/* console.log("usersWhoPurchased: ", usersWhoPurchased);
console.log("topPurchasedProducts: ", topPurchasedProducts);
console.log("topRenters: ", topRenters);
console.log("totalRentalEarnings: ", totalRentalEarnings); */
---

<Dashboard>
    <section
        class="max-w-[80vw] mx-auto min-h-screen bg-[--background] text-[--color-white] rounded-lg shadow-lg"
    >
        <h1 class="text-[2vw] md:text-[1.5vw]">{t("dash.analytics")}</h1>

        <div class="flex flex-wrap gap-4 md:gap-[2vw] mt-8 md:mt-[2vw]">
            <div
                class="w-full sm:w-[90%] md:w-[80%] lg:w-[70%] xl:w-[60%] h-fit bg-[--gray] text-white px-4 py-6 md:px-[1vw] md:py-8 rounded-lg shadow-lg overflow-auto"
            >
                <div class="hidden md:block">
                    <BestSeller
                        lang={lang}
                        topPurchasedProducts={topPurchasedProducts}
                    />
                </div>
                <div class="md:hidden">
                    {
                        topPurchasedProducts.map((product) => (
                            <div class="p-4 mb-4 bg-[--grayLight] rounded-lg shadow">
                                <h3 class="font-bold text-[4vw]">
                                    {product.name}
                                </h3>
                                <p class="text-[3.5vw]">
                                    {t("dash.sales")}: {product.sales}
                                </p>
                                <p class="text-[3.5vw]">
                                    Total: €{product.total}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>

            {/* Utilizadores com mais aluguéis */}
            <div
                class="w-full sm:w-[80%] md:w-[45%] lg:w-[40%] xl:w-[35%] h-fit bg-[--gray] text-white px-4 py-6 md:px-[1vw] md:py-8 rounded-lg shadow-lg"
            >
                <h2
                    class="text-[4vw] md:text-[1.2vw] font-semibold mb-6 md:mb-8"
                >
                    {t("dash.topUsers")}
                </h2>
                <ul class="max-h-[25rem] overflow-y-auto my-4 px-2">
                    {
                        (Array.isArray(topRenters) ? topRenters : []).map(
                            (renter) => (
                                <li class="flex justify-between text-[3.5vw] md:text-[1vw] py-1 border-b border-[--grayLight]">
                                    <span>{renter.name}</span>
                                    <span class="font-bold">
                                        {renter.count} {t("dash.rentals")}
                                    </span>
                                </li>
                            ),
                        )
                    }
                </ul>
                <div class="mt-2 md:mt-[.9vw] ml-2">
                    <a
                        href={`/${lang}/dashboard/users`}
                        class="flex items-center gap-3 text-yellow-200 text-[3vw] md:text-[.9vw] hover:underline"
                    >
                        {t("dash.goUsers")}
                        <img class="svg-yellow" src="/icons/redirect.svg" />
                    </a>
                </div>
            </div>

            {/* Número de utilizadores que compraram */}
            <div
                class="w-full sm:w-[80%] md:w-[45%] lg:w-[40%] xl:w-[35%] h-fit bg-[--gray] text-white px-4 py-6 md:px-[1vw] md:py-8 rounded-lg shadow-lg"
            >
                <h2
                    class="text-[4vw] md:text-[1.2vw] font-semibold mb-6 md:mb-8"
                >
                    {t("dash.totalUserspurchased")}
                </h2>
                <p class="text-[6vw] md:text-[2vw] font-bold">
                    {usersWhoPurchased}
                </p>
            </div>

            {/* Ganhos totais de aluguéis */}
            <div
                class="w-full sm:w-[80%] md:w-[45%] lg:w-[40%] xl:w-[35%] h-fit bg-[--gray] text-white px-4 py-6 md:px-[1vw] md:py-8 rounded-lg shadow-lg"
            >
                <h2
                    class="text-[4vw] md:text-[1.2vw] font-semibold mb-6 md:mb-8"
                >
                    {t("dash.totalEarnings")}
                </h2>
                <p class="text-[6vw] md:text-[2vw] font-bold">
                    € {totalRentalEarnings}
                </p>
            </div>
        </div>
    </section>
</Dashboard>
