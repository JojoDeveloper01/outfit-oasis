---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Dashboard from "@layouts/AsideDashboard.astro";
import ListUsers from "@components/ListUsers.astro";
import { actions, isInputError } from "astro:actions";
import { deleteItem, getUsers } from "@lib/dbFunctions";
import Alerts from "@components/Modal/Alerts.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const addUserResult = Astro.getActionResult(actions.addUser);
const editUserResult = Astro.getActionResult(actions.editUser);
const deleteUserResult = Astro.getActionResult(actions.deleteUser);

let users = await getUsers();

// Tratamento de erros
let alertMessage = "";
let alertType = "success";

if (addUserResult?.error) {
    if (isInputError(addUserResult.error)) {
        // Captura erros específicos do Zod
        alertMessage = Object.entries(addUserResult.error.fields)
            .map(([field, errors]) => `${field}: ${errors.join(", ")}`)
            .join("; ");
    } else {
        // Outros erros gerais
        alertMessage = addUserResult.error.message;
    }
    alertType = "error";
} else if (addUserResult?.data) {
    alertMessage = "User added successfully!";
}

if (editUserResult?.error) {
    alertMessage = editUserResult.error.message;
    alertType = "error";
} else if (editUserResult?.data) {
    alertMessage = "User edited successfully!";
}

if (deleteUserResult?.error) {
    alertMessage = deleteUserResult.error.message;
    alertType = "error";
} else if (deleteUserResult?.data) {
    alertMessage = "User deleted successfully!";
}
---

<style></style>

<Dashboard>
    <h1>Manage Users</h1>

    <!-- Global error message -->
    {alertMessage && <Alerts message={alertMessage} type={alertType} />}

    <!-- Add New User Accordion -->
    <div class="max-w-screen-desktop my-16">
        <details class="group border border-gray-200 rounded-lg">
            <!-- Cabeçalho do Accordion -->
            <summary
                class="flex items-center justify-between cursor-pointer p-5 font-medium text-gray-500 bg-white rounded-t-lg hover:bg-gray-100"
            >
                <span>Add New User</span>
                <!-- Ícone com rotação quando aberto -->
                <svg
                    class="w-3 h-3 transition-transform group-open:rotate-180"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 10 6"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5 5 1 1 5"></path>
                </svg>
            </summary>

            <!-- Conteúdo do Accordion -->
            <div class="p-5 bg-gray-100 border-t border-gray-200 rounded-b-lg">
                <form
                    method="POST"
                    action={actions.addUser}
                    enctype="multipart/form-data"
                    class="space-y-6"
                >
                    <input type="hidden" name="action" value="add" />

                    <!-- Grid Container -->
                    <div
                        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
                    >
                        <!-- Name Field -->
                        <div>
                            <label
                                for="name"
                                class="block text-sm font-medium text-gray-700 mb-1"
                            >
                                Name
                            </label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="Enter the user's name"
                                class="block w-full p-2.5 border rounded-lg bg-white text-gray-700 focus:ring-blue-500 focus:border-blue-500"
                            />
                        </div>

                        <!-- Email Field -->
                        <div>
                            <label
                                for="email"
                                class="block text-sm font-medium text-gray-700 mb-1"
                            >
                                Email
                            </label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="Enter the user's email"
                                class="block w-full p-2.5 border rounded-lg bg-white text-gray-700 focus:ring-blue-500 focus:border-blue-500"
                            />
                        </div>

                        <!-- Password Field -->
                        <div>
                            <label
                                for="password"
                                class="block text-sm font-medium text-gray-700 mb-1"
                            >
                                Password
                            </label>
                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="******"
                                required
                                class="block w-full p-2.5 border rounded-lg bg-white text-gray-700 focus:ring-blue-500 focus:border-blue-500"
                            />
                        </div>

                        <!-- User Type Field -->
                        <div>
                            <label
                                for="user_type"
                                class="block text-sm font-medium text-gray-700 mb-1"
                            >
                                User Type
                            </label>
                            <select
                                id="user_type"
                                name="user_type"
                                required
                                class="block w-full p-2.5 border rounded-lg bg-white text-gray-700 focus:ring-blue-500 focus:border-blue-500"
                            >
                                <option value="client">Client</option>
                                <option value="staff">Staff</option>
                            </select>
                        </div>

                        <!-- Phone Field -->
                        <div>
                            <label
                                for="phone"
                                class="block text-sm font-medium text-gray-700 mb-1"
                            >
                                Phone
                            </label>
                            <input
                                type="number"
                                id="phone"
                                name="phone"
                                placeholder="Enter the user's phone"
                                class="block w-full p-2.5 border rounded-lg bg-white text-gray-700 focus:ring-blue-500 focus:border-blue-500"
                            />
                        </div>

                        <!-- Profile Picture Field -->
                        <div class="col-span-1 md:col-span-2 lg:col-span-1">
                            <label
                                for="profile_pic"
                                class="block text-sm font-medium text-gray-700 mb-1"
                            >
                                Profile Picture
                            </label>
                            <input
                                type="file"
                                id="profile_pic"
                                name="profile_pic"
                                accept="image/*"
                                class="block w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:bg-blue-600 file:text-white hover:file:bg-blue-700"
                            />
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="flex justify-end">
                        <button
                            type="submit"
                            class="px-5 py-2.5 bg-blue-600 text-white font-medium rounded-lg shadow hover:bg-blue-700 focus:ring-4 focus:ring-blue-300"
                        >
                            Create User
                        </button>
                    </div>
                </form>
            </div>
        </details>
    </div>

    <ListUsers users={users} actions={actions} />
</Dashboard>

<script is:inline define:vars={{ users }}>
    import { actions } from "astro:actions";
    //import { navigate } from "astro:transitions/client";

    console.log(users);

    const form = document.getElementById(
        `confirm-delete-${users.name}-${users.id}`,
    );

    document.getElementById(form).addEventListener("submit", async () => {
        preventDefault();
        // Cria o FormData e envia para a action
        const formData = new FormData(form);
        const { error } = await actions.deleteUser(formData);

        if (!error) {
            alert("User deleted successfully!");
        } else {
            alert(`Error: ${error.message}`);
        }
    });

    // Lista inicial de usuários (serializada)
    function filterUsers() {
        // Obter os valores dos filtros
        const searchFilter = document
            .getElementById("name-filter")
            .value.toLowerCase();
        const typeFilter = document.getElementById("type-filter").value;

        // Filtragem
        const filteredUsers = users.filter((user) => {
            const matchesSearch =
                user.name.toLowerCase().includes(searchFilter) ||
                user.email.toLowerCase().includes(searchFilter) ||
                (user.phone && user.phone.toString().includes(searchFilter));

            const matchesType = typeFilter
                ? user.user_type === typeFilter
                : true;

            return matchesSearch && matchesType;
        });

        // Atualiza a tabela no DOM
        const userList = document.getElementById("user-list");
        userList.innerHTML = filteredUsers
            .map(
                (user) => `
            <tr class="hover:bg-gray-100">
                <!-- Foto de Perfil -->
                <td class="py-3 px-4">
                    <img
                        src="${user.profile_pic}"
                        alt="Profile"
                        class="h-10 w-10 rounded-full object-cover"
                    />
                </td>

                <!-- Informações do Usuário -->
                <td class="py-3 px-4 text-sm text-gray-900">${user.name}</td>
                <td class="py-3 px-4 text-sm text-gray-600">${user.email}</td>
                <td class="py-3 px-4 text-sm text-gray-600">${user.user_type}</td>
                <td class="py-3 px-4 text-sm text-gray-600">${user.phone}</td>

                <!-- Botões de Ações -->
                <td class="py-3 px-4 flex gap-2">
                    <button
                        class="bg-blue-500 text-white px-2 py-1 rounded-md hover:bg-blue-600"
                        onclick="editUser(${user.user_id})"
                    >
                        Edit
                    </button>
                    <button
                        class="bg-red-500 text-white px-2 py-1 rounded-md hover:bg-red-600"
                        onclick="deleteUser(${user.user_id})"
                    >
                        Delete
                    </button>
                </td>
            </tr>
        `,
            )
            .join("");
    }

    // Expor a função globalmente
    window.filterUsers = filterUsers;
</script>
