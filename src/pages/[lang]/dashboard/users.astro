---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Dashboard from "@layouts/AsideDashboard.astro";
import { actions, isInputError } from "astro:actions";
import { getUsers } from "@lib/dbFunctions";
import Alerts from "@components/Modal/Alerts.astro";
import UsersList from "@components/Users/UserList";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const addUserResult = Astro.getActionResult(actions.addUser);

let users = await getUsers();

// Tratamento de erros
let alertMessage = "";
let alertType = "success";

if (addUserResult?.error) {
    if (isInputError(addUserResult.error)) {
        // Captura erros específicos do Zod
        alertMessage = Object.entries(addUserResult.error.fields)
            .map(([field, errors]) => `${field}: ${errors.join(", ")}`)
            .join("; ");
    } else {
        // Outros erros gerais
        alertMessage = addUserResult.error.message;
    }
    alertType = "error";
} else if (addUserResult?.data) {
    alertMessage = "User added successfully!";
}
---

<style></style>

<Dashboard>
    <h1>Manage Users</h1>

    <!-- Global error message -->
    {alertMessage && <Alerts message={alertMessage} type={alertType} />}

    <!-- Add New User Accordion -->
    <details
        class="max-w-screen-desktop my-16 group border border-gray-200 rounded-lg"
    >
        <!-- Cabeçalho do Accordion -->
        <summary
            class="flex items-center justify-between cursor-pointer p-5 .font-medium text-gray-500 rounded-t-lg hover:bg-gray-100"
        >
            <span>Add New User</span>
            <svg
                class="w-3 h-3 transition-transform group-open:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 10 6"
            >
                <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5 5 1 1 5"></path>
            </svg>
        </summary>

        <!-- Conteúdo do Accordion -->
        <div class="p-5 border-t border-gray-200 rounded-b-lg">
            <form
                action={actions.addUser}
                method="POST"
                class="space-y-6"
                enctype="multipart/form-data"
            >
                <!-- Grid Container -->
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
                >
                    <!-- Name Field -->
                    <div class="field">
                        <label for="name"> Name </label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            oninput="sanitizeInput(this)"
                            placeholder="Enter the user's name"
                            autocomplete="name"
                        />
                    </div>

                    <!-- Email Field -->
                    <div class="field">
                        <label for="email"> Email </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter the user's email"
                            autocomplete="email"
                        />
                    </div>

                    <!-- Password Field -->
                    <div class="field">
                        <label for="password"> Password </label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="******"
                            autocomplete="new-password"
                            required
                        />
                    </div>

                    <!-- User Type Field -->
                    <div class="field">
                        <label for="user_type"> User Type </label>
                        <select id="user_type" name="user_type" required>
                            <option value="client">Client</option>
                            <option value="staff">Staff</option>
                        </select>
                    </div>

                    <!-- Phone Field -->
                    <div class="field">
                        <label for="phone"> Phone </label>
                        <input
                            type="number"
                            id="phone"
                            name="phone"
                            placeholder="Enter the user's phone"
                            autocomplete="tel"
                        />
                    </div>

                    <!-- Profile Picture Field -->
                    <div class="field col-span-1 md:col-span-2 lg:col-span-1">
                        <label for="profile_pic"> Profile Picture </label>
                        <input
                            type="file"
                            id="profile_pic"
                            name="profile_pic"
                            accept="image/*"
                            class="block w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:bg-blue-600 file:text-white hover:file:bg-blue-700"
                        />
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="flex justify-end">
                    <button
                        type="submit"
                        class="px-5 py-2.5 bg-blue-600 text-white .font-medium rounded-lg shadow hover:bg-blue-700 focus:ring-4 focus:ring-blue-300"
                    >
                        Create User
                    </button>
                </div>
            </form>
        </div>
    </details>

    <UsersList client:load userType="staff" users={users} />
</Dashboard>

<script is:inline>
    function sanitizeInput(input) {
        // Remove caracteres que não sejam letras, números ou espaços
        input.value = input.value.replace(/[^a-zA-Z0-9 ]/g, "");
    }
</script>
