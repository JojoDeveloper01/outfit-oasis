---
import Dashboard from "@layouts/AsideDashboard.astro";
import { getUsers } from "@lib/dbFunctions";

const users = await getUsers(); // Obtém a lista de usuários do banco de dados
const initialUsers = JSON.stringify(users); // Serializa a lista inicial para filtragem
---

<Dashboard>
    <h1>Users</h1>
    <div class="mb-4">
        <label for="name-filter" class="block text-sm font-medium text-gray-700"
            >Filter by Name:</label
        >
        <input
            id="name-filter"
            type="text"
            placeholder="Search by name"
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
            oninput="filterUsers()"
        />
    </div>
    <div class="mb-4">
        <label for="type-filter" class="block text-sm font-medium text-gray-700"
            >Filter by Type:</label
        >
        <select
            id="type-filter"
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
            onchange="filterUsers()"
        >
            <option value="">All</option>
            <option value="client">Client</option>
            <option value="staff">Staff</option>
        </select>
    </div>
    <ul id="user-list" class="divide-y divide-gray-200">
        {
            users.map((user) => (
                <li class="py-4 flex">
                    <div>
                        <p class="text-sm font-medium text-gray-900">
                            {user.name}
                        </p>
                        <p class="text-sm text-gray-500">
                            {user.email} - {user.user_type}
                        </p>
                        <p class="text-sm text-gray-400">{user.phone}</p>
                    </div>
                </li>
            ))
        }
    </ul>
</Dashboard>

<script define:vars={{ initialUsers }}>
    // Lista inicial de usuários (serializada)
    console.log(initialUsers);

    function filterUsers() {
        const nameFilter = document
            .getElementById("name-filter")
            .value.toLowerCase();
        const typeFilter = document.getElementById("type-filter").value;

        const filteredUsers = initialUsers.filter((user) => {
            const matchesName = user.name.toLowerCase().includes(nameFilter);
            const matchesType = typeFilter
                ? user.user_type === typeFilter
                : true;
            return matchesName && matchesType;
        });

        // Atualiza a lista no DOM
        const userList = document.getElementById("user-list");
        userList.innerHTML = filteredUsers
            .map(
                (user) => `
            <li key=${user.user_id} class="py-4 flex">
                <div>
                    <p class="text-sm font-medium text-gray-900">${user.name}</p>
                    <p class="text-sm text-gray-500">${user.email} - ${user.user_type}</p>
                    <p class="text-sm text-gray-400">${user.phone}</p>
                </div>
            </li>
        `,
            )
            .join("");
    }
</script>
