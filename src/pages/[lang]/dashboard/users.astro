---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Dashboard from "@layouts/AsideDashboard.astro";
import { actions, isInputError } from "astro:actions";
import { getUsers } from "@lib/dbFunctions";
import Alerts from "@components/Modal/Alerts.astro";
import UsersList from "@components/Users/UserList";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const addUserResult = Astro.getActionResult(actions.addUser);

let users = await getUsers();

// Tratamento de erros
let alertMessage = "";
let alertType = "success";

if (addUserResult?.error) {
    if (isInputError(addUserResult.error)) {
        // Captura erros específicos do Zod
        alertMessage = Object.entries(addUserResult.error.fields)
            .map(([field, errors]) => `${field}: ${errors.join(", ")}`)
            .join("; ");
    } else {
        // Outros erros gerais
        alertMessage = addUserResult.error.message;
    }
    alertType = "error";
} else if (addUserResult?.data) {
    alertMessage = "User added successfully!";
}
---

<Dashboard>
    <h1 class="text-[2vw] md:text-[1.5vw]">{t("dash.userTitle")}</h1>

    <!-- Global error message -->
    {alertMessage && <Alerts message={alertMessage} type={alertType} />}

    <!-- Add New User Accordion -->
    <details>
        <!-- Cabeçalho do Accordion -->
        <summary>
            <span>{t("dash.addNewUser")}</span>
            <svg
                class="w-3 h-3 transition-transform group-open:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 10 6"
            >
                <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5 5 1 1 5"></path>
            </svg>
        </summary>

        <!-- Conteúdo do Accordion -->
        <div class="p-5 rounded-b-lg text-[--color-white1]]">
            <form
                action={actions.addUser}
                method="POST"
                class="space-y-6"
                enctype="multipart/form-data"
            >
                <!-- Grid Container -->
                <div
                    class="grid grid-cols-1 max-[768px]:grid-cols-2 lg:grid-cols-3 gap-[1.5vw]"
                >
                    <!-- Name Field -->
                    <div class="grid gap-4">
                        <label for="name">{t("home.name")}</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            oninput="sanitizeInput(this)"
                            placeholder="Enter the user's name"
                            autocomplete="name"
                        />
                    </div>

                    <!-- Email Field -->
                    <div class="grid gap-4">
                        <label for="email">Email</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder={t("dash.enterUserEmail")}
                            autocomplete="email"
                        />
                    </div>

                    <!-- Password Field -->
                    <div class="grid gap-4">
                        <label for="password">{t("home.password")}</label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="******"
                            autocomplete="new-password"
                            required
                        />
                    </div>

                    <!-- User Type Field -->
                    <div class="grid gap-4">
                        <label for="user_type">{t("dash.userType")}</label>
                        <select id="user_type" name="user_type" required>
                            <option value="client">{t("dash.client")}</option>
                            <option value="staff">{t("dash.staff")}</option>
                        </select>
                    </div>

                    <!-- Phone Field -->
                    <div class="grid gap-4">
                        <label for="phone">{t("home.phone")}</label>
                        <input
                            type="number"
                            id="phone"
                            name="phone"
                            placeholder={t("dash.enterUserPhone")}
                            autocomplete="tel"
                        />
                    </div>

                    <!-- Profile Picture Field -->
                    <div
                        class="field col-span-1 max-[768px]:col-span-2 lg:col-span-1"
                    >
                        <label for="profile_pic"
                            >{t("home.profilePicture")}</label
                        >
                        <input
                            type="file"
                            id="profile_pic"
                            name="profile_pic"
                            accept="image/*"
                            class="block w-full text-[1vw] text-[--gold] file:mr-[1vw] file:py-[.6vw] file:px-[1vw] file:rounded-full file:border-0 file:bg-[--gold] file:text-white hover:file:bg-[--gold]"
                        />
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="flex justify-end">
                    <button
                        type="submit"
                        class="px-5 py-[.6vw] bg-[--gold] text-black font-medium rounded-lg shadow hover:bg-yellow-100 focus:ring-4 focus:ring-yellow-100"
                    >
                        {t("dash.createUser")}
                    </button>
                </div>
            </form>
        </div>
    </details>

    <UsersList client:load userType="staff" users={users} lang={lang} />
</Dashboard>

<script is:inline>
    function sanitizeInput(input) {
        // Remove caracteres que não sejam letras, números ou espaços
        input.value = input.value.replace(/[^a-zA-Z0-9 ]/g, "");
    }
</script>
