---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Dashboard from "@layouts/AsideDashboard.astro";
import UsersMap from "@components/UsersMap.astro";
import { getUsers, addUser, editUser, deleteUser } from "@lib/dbFunctions";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Define the type for errors
interface Errors {
    global?: string; // Optional "global" error field
}

const errors: Errors = {}; // Initialize errors with the defined type

let users = await getUsers();

if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const action = data.get("action");

        // Campos comuns
        const id = data.get("id")?.toString().trim();
        const name = data.get("name")?.toString().trim();
        const email = data.get("email")?.toString().trim();
        const user_type = data.get("user_type")?.toString().trim();
        const phone = data.get("phone")?.toString().trim();
        const profile_pic = data.get("profile_pic")?.toString().trim();

        console.log("data:", data);

        // Validação e Ações
        if (action === "add") {
            console.log("data:", name, email, user_type);

            // Garantir que todos os campos obrigatórios estão preenchidos
            if (!name || !email || !user_type) {
                throw new Error("Name, email, and user type are required.");
            }

            try {
                await addUser({
                    name,
                    email,
                    user_type,
                    phone: phone ? Number(phone) : null,
                    profile_pic:
                        profile_pic || "https://via.placeholder.com/40", // Foto padrão
                });
            } catch (error) {
                errors.global = "Failed to add user. Please try again.";
            }
        } else if (action === "edit") {
            // Garantir que o ID está presente para edição
            if (!id) {
                throw new Error("Missing user ID for editing.");
            }

            // Garantir pelo menos um campo para atualizar
            if (!name && !email && !user_type && !phone && !profile_pic) {
                throw new Error(
                    "At least one field must be provided for editing.",
                );
            }

            // Chamar função editUser com os campos disponíveis
            await editUser(Number(id), {
                name,
                email,
                user_type,
                phone: phone ? Number(phone) : null,
                profile_pic,
            });
        } else if (action === "delete") {
            // Garantir que o ID está presente para exclusão
            if (!id) {
                throw new Error("Missing user ID for deletion.");
            }

            await deleteUser(Number(id));
        }

        // Atualizar a lista de utilizadores após qualquer ação
        users = await getUsers();
    } catch (error) {
        if (error instanceof Error) {
            errors.global = error.message; // Atribuir a mensagem do erro ao campo global
        } else {
            errors.global = "An unexpected error occurred.";
        }
    }
}
---

<style></style>

<Dashboard>
    <h1>Users</h1>

    <!-- Global error message -->
    {errors.global && <p class="text-red-600">{errors.global}</p>}

    <!-- Add New User Form -->
    <div
        transition:persist="add-new-item"
        id="accordion-collapse"
        class="max-w-screen-desktop my-16"
        data-accordion="collapse"
    >
        <h2 id="accordion-collapse-heading-1">
            <button
                type="button"
                id="accordion-new-user"
                class="flex items-center justify-between w-full p-5 font-medium text-gray-500 border border-b-0 border-gray-200 rounded-t-xl focus:ring-4 focus:ring-gray-200 gap-3 bg-white"
                data-accordion-target="#accordion-collapse-users"
                aria-expanded="false"
                aria-controls="accordion-collapse-users"
            >
                <span>Add New User</span>
                <svg
                    data-accordion-icon
                    class="w-3 h-3 rotate-180 shrink-0"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 10 6"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5 5 1 1 5"></path>
                </svg>
            </button>
        </h2>
        <div id="accordion-collapse-users" class="hidden">
            <div class="p-5 border border-gray-200 bg-[--color5] rounded-b-xl">
                <form
                    method="POST"
                    enctype="multipart/form-data"
                    class="space-y-6"
                >
                    <input type="hidden" name="action" value="add" />

                    <!-- Grid Container -->
                    <div
                        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
                    >
                        <!-- Name Field -->
                        <div>
                            <label
                                for="name"
                                class="block text-sm font-medium text-white mb-1"
                            >
                                Name
                            </label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="Enter the user's name"
                                class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                                required
                            />
                        </div>

                        <!-- Email Field -->
                        <div>
                            <label
                                for="email"
                                class="block text-sm font-medium text-white mb-1"
                            >
                                Email
                            </label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="Enter the user's email"
                                class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                                required
                            />
                        </div>

                        <!-- User Type Field -->
                        <div>
                            <label
                                for="type"
                                class="block text-sm font-medium text-white mb-1"
                            >
                                User Type
                            </label>
                            <select
                                id="user_type"
                                name="user_type"
                                class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                                required
                            >
                                <option value="client">Client</option>
                                <option value="staff">Staff</option>
                            </select>
                        </div>

                        <!-- Phone Field -->
                        <div>
                            <label
                                for="phone"
                                class="block text-sm font-medium text-white mb-1"
                            >
                                Phone
                            </label>
                            <input
                                type="number"
                                id="phone"
                                name="phone"
                                placeholder="Enter the user's phone"
                                class="block w-full p-2.5 border rounded-lg bg-[--color-black] border-gray-300 focus:ring-[--color-white] focus:border-[--color-white] text-[--color-white]"
                            />
                        </div>

                        <!-- Profile Picture Field -->
                        <div class="col-span-1 md:col-span-2 lg:col-span-1">
                            <label
                                for="profile-pic"
                                class="block text-sm font-medium text-white mb-1"
                            >
                                Profile Picture
                            </label>
                            <input
                                type="file"
                                id="profile-pic"
                                name="profile_pic"
                                accept="image/*"
                                class="block w-full text-sm text-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-[--gold] file:text-white"
                            />
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="flex justify-end">
                        <button
                            type="submit"
                            class="px-5 py-2.5 bg-[--gold] text-[--color-white] font-medium rounded-lg shadow hover:bg-[--color2] focus:ring-4 focus:ring-[--color-white]"
                        >
                            Create User
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <UsersMap users={users} />
</Dashboard>

<script is:inline define:vars={{ users }}>
    // Lista inicial de usuários (serializada)

    function filterUsers() {
        // Obter os valores dos filtros
        const searchFilter = document
            .getElementById("name-filter")
            .value.toLowerCase();
        const typeFilter = document.getElementById("type-filter").value;

        // Filtragem
        const filteredUsers = users.filter((user) => {
            const matchesSearch =
                user.name.toLowerCase().includes(searchFilter) ||
                user.email.toLowerCase().includes(searchFilter) ||
                (user.phone && user.phone.toString().includes(searchFilter));

            const matchesType = typeFilter
                ? user.user_type === typeFilter
                : true;

            return matchesSearch && matchesType;
        });

        // Atualiza a tabela no DOM
        const userList = document.getElementById("user-list");
        userList.innerHTML = filteredUsers
            .map(
                (user) => `
            <tr class="hover:bg-gray-100">
                <!-- Foto de Perfil -->
                <td class="py-3 px-4">
                    <img
                        src="${user.profile_pic || "https://via.placeholder.com/40"}"
                        alt="Profile"
                        class="h-10 w-10 rounded-full object-cover"
                    />
                </td>

                <!-- Informações do Usuário -->
                <td class="py-3 px-4 text-sm text-gray-900">${user.name}</td>
                <td class="py-3 px-4 text-sm text-gray-600">${user.email}</td>
                <td class="py-3 px-4 text-sm text-gray-600">${user.user_type}</td>
                <td class="py-3 px-4 text-sm text-gray-600">${user.phone}</td>

                <!-- Botões de Ações -->
                <td class="py-3 px-4 flex gap-2">
                    <button
                        class="bg-blue-500 text-white px-2 py-1 rounded-md hover:bg-blue-600"
                        onclick="editUser(${user.user_id})"
                    >
                        Edit
                    </button>
                    <button
                        class="bg-red-500 text-white px-2 py-1 rounded-md hover:bg-red-600"
                        onclick="deleteUser(${user.user_id})"
                    >
                        Delete
                    </button>
                </td>
            </tr>
        `,
            )
            .join("");
    }

    // Expor a função globalmente
    window.filterUsers = filterUsers;

    window.filterUsers = filterUsers;
</script>
