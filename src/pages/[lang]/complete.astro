<script>
    import {
        getCookie,
        stripe,
        triggerConfetti,
        removeItemFromCart,
    } from "@lib/functions";
    import { actions } from "astro:actions";

    document.addEventListener("astro:page-load", () => {
        // Parâmetros iniciais
        const params = new URLSearchParams(document.location.search);
        const user_id = Number(getCookie("id"));
        const item_id = Number(params.get("item_id"));
        const start_date = convertToISODate(params.get("start_date") || "");
        const end_date = convertToISODate(params.get("end_date") || "");
        const payment_amount = Number(params.get("payment_amount"));

        // Checar o status do pagamento ao carregar a página
        checkStatus();

        // Função principal: checar status do pagamento
        async function checkStatus() {
            try {
                const clientSecret = params.get("payment_intent_client_secret");
                if (!clientSecret)
                    return updateStatusMessage(
                        "Erro: nenhum pagamento foi encontrado.",
                    );

                if (!stripe) throw new Error("Stripe não pôde ser carregado!");

                const { paymentIntent } =
                    await stripe.retrievePaymentIntent(clientSecret);
                if (!paymentIntent)
                    throw new Error("Erro ao recuperar PaymentIntent.");

                if (paymentIntent.status === "succeeded") {
                    const payment_method = await getPaymentMethod(
                        String(paymentIntent.payment_method),
                    );

                    if (
                        !validateParameters({
                            user_id,
                            item_id,
                            start_date,
                            end_date,
                            payment_amount,
                            payment_method,
                        })
                    ) {
                        return updateStatusMessage(
                            "Alguns campos estão inválidos ou faltando.",
                        );
                    }

                    // Processar a reserva e obter a mensagem de resultado
                    const reservationMessage = await handleReservation(
                        user_id,
                        item_id,
                        start_date,
                        end_date,
                        payment_amount,
                        String(payment_method),
                    );

                    // Exibir a mensagem retornada pela função
                    updateStatusMessage(
                        reservationMessage || "Erro ao processar reserva.",
                    );

                    // Mostrar sucesso se a reserva foi concluída
                    if (
                        reservationMessage === "Reserva processada com sucesso!"
                    ) {
                        showSuccess();
                    }
                } else {
                    updateStatusMessage("Seu pagamento está sendo processado.");
                }
            } catch (error) {
                console.error("Erro ao checar o status:", error);
                updateStatusMessage(
                    "Erro no pagamento. Por favor, tente novamente.",
                );
            }
        }

        // Função para validar parâmetros (centralizada)
        function validateParameters(params: any) {
            //console.log(params);
            // Verifica se cada valor é válido de acordo com seu tipo
            return Object.values(params).every((value) => {
                if (typeof value === "number") {
                    return value > 0; // Números devem ser maiores que 0
                } else if (typeof value === "string") {
                    return value.trim().length > 0; // Strings não podem estar vazias
                } else {
                    return false; // Qualquer outro tipo de valor
                }
            });
        }

        function convertToISODate(dateString: string) {
            const [day, month, year] = dateString.split("/");
            return `${year}-${month}-${day}`; // Retorna no formato YYYY-MM-DD
        }

        // Função para atualizar mensagens na interface
        function updateStatusMessage(message: string) {
            const statusMessageElement =
                document.getElementById("status-message");
            if (statusMessageElement) {
                statusMessageElement.textContent = message;
            }
        }

        // Função para obter o método de pagamento
        async function getPaymentMethod(id: string) {
            try {
                const { data, error } = await actions.getPaymentMethod({ id });

                if (error)
                    throw new Error("Erro ao obter o método de pagamento.");
                if (!data)
                    throw new Error("Método de pagamento não encontrado.");

                return data;
            } catch (error) {
                console.error("Erro ao obter o método de pagamento:", error);
                return null;
            }
        }

        // Função para processar a reserva
        async function handleReservation(
            user_id: number,
            item_id: number,
            start_date: string,
            end_date: string,
            payment_amount: number,
            payment_method: string,
        ) {
            try {
                // Verificar se a reserva já existe
                const { data, error } = await actions.thereIsReservation({
                    user_id,
                    item_id,
                    start_date,
                    end_date,
                });
                if (error) throw new Error("Erro ao verificar reserva.");
                if (data) {
                    return "O produto já foi reservado.";
                }

                // Confirmar o pagamento e criar a reserva
                const response = await confirmationPayment(
                    user_id,
                    item_id,
                    start_date,
                    end_date,
                    payment_amount,
                    payment_method,
                );
                if (!response) throw new Error("Erro ao confirmar a reserva.");

                // Remover o item do carrinho
                removeItemFromCart(item_id);

                return "Reserva processada com sucesso!";
            } catch (error) {
                console.error("Erro ao processar reserva:", error);
                return false;
            }
        }

        // Função para confirmar o pagamento
        async function confirmationPayment(
            user_id: number,
            item_id: number,
            start_date: string,
            end_date: string,
            payment_amount: number,
            payment_method: string,
        ) {
            try {
                const { data, error } = await actions.itemPaymentConfirmation({
                    user_id,
                    item_id,
                    start_date,
                    end_date,
                    payment_amount,
                    payment_method,
                });

                if (error) {
                    console.error("o pagamento n doi confirmado: ", error);
                    throw new Error("Erro ao confirmar pagamento.");
                }
                if (!data)
                    throw new Error("Item não encontrado para confirmação.");

                return data;
            } catch (error) {
                console.error("Erro ao confirmar pagamento:", error);
                return null;
            }
        }

        // Função para mostrar sucesso (genérica)
        function showSuccess() {
            updateStatusMessage("Compra realizada com sucesso!");

            const statusLoadingElement =
                document.getElementById("status-loading");
            const statusSuccessElement =
                document.getElementById("status-success");

            if (statusLoadingElement)
                statusLoadingElement.classList.add("hidden");
            if (statusSuccessElement)
                statusSuccessElement.classList.remove("hidden");

            // Disparar confete
            triggerConfetti();
        }
    });
</script>
