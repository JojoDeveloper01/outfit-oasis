---
import Layout from "@layouts/Layout.astro";
---

<style>
    .loader {
        border: 4px solid rgba(0, 0, 0, 0.1);
        border-left-color: #f76c6c;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<Layout>
    <div
        id="payment-status"
        class="flex flex-col items-center justify-center h-screen bg-pink-100"
    >
        <!-- Status de carregamento -->
        <div id="status-loading" class="flex flex-col items-center">
            <h1 class="text-3xl font-bold mb-4">Status do Pagamento</h1>
            <p id="status-message" class="text-lg text-gray-700">
                Verificando status...
            </p>
            <div class="loader mt-6"></div>
            <!-- Animação de carregamento -->
        </div>

        <!-- Sucesso no pagamento -->
        <div
            id="status-success"
            class="hidden flex flex-col items-center text-center"
        >
            <h1 class="text-3xl font-bold mb-4">🎉 Success!</h1>
            <p class="text-lg text-green-700 font-semibold mb-4">
                Pagamento bem-sucedido! Obrigado!
            </p>
            <p class="text-xl text-gray-800 font-semibold mb-4">
                Find your item here:
            </p>
            <div
                id="mapComplete"
                class="w-96 h-64 border-2 border-gray-300 rounded-lg overflow-hidden"
            >
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3106.609552808246!2d-9.077966787753034!3d38.86429367161323!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd192ec1c4a591d1%3A0x384a0c3b46e3770a!2sR.%20Jos%C3%A9%20Nogueira%20Vaz%2016%2C%202625-099%20P%C3%B3voa%20de%20Santa%20Iria!5e0!3m2!1spt-PT!2spt!4v1736287506229!5m2!1spt-PT!2spt"
                    width="400"
                    height="300"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </div>

    <!-- Adicionar o CDN da biblioteca tsparticles/confetti -->
</Layout>

<!-- 
