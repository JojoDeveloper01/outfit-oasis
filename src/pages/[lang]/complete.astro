<script>
    import {
        getCookie,
        stripe,
        triggerConfetti,
        removeItemFromCart,
    } from "@lib/functions";
    import { actions } from "astro:actions";

    document.addEventListener("astro:page-load", () => {
        checkStatus();

        async function checkStatus() {
            const clientSecret = new URLSearchParams(
                window.location.search,
            ).get("payment_intent_client_secret");

            if (!clientSecret) {
                const statusMessageElement =
                    document.getElementById("status-message");
                if (statusMessageElement) {
                    statusMessageElement.textContent =
                        "Erro: nenhum pagamento foi encontrado.";
                }
                return;
            }

            if (!stripe) {
                console.error("Stripe não pôde ser carregado!");
                return;
            }

            const { paymentIntent } =
                await stripe.retrievePaymentIntent(clientSecret);

            if (paymentIntent) {
                if (paymentIntent.status === "succeeded") {
                    const params = new URLSearchParams(
                        document.location.search,
                    );

                    const user_id = Number(getCookie("id"));
                    const item_id = Number(params.get("item_id"));
                    const start_date = params.get("start_date") || "";
                    const end_date = params.get("end_date") || "";
                    const payment_amount = Number(params.get("payment_amount"));
                    const payment_method = params.get("payment_method") || "";

                    handleReservation(
                        user_id,
                        item_id,
                        start_date,
                        end_date,
                        payment_amount,
                        payment_method,
                    );

                    showSuccess();
                } else {
                    const statusMessageElement =
                        document.getElementById("status-message");
                    if (statusMessageElement) {
                        statusMessageElement.textContent =
                            "Seu pagamento está sendo processado.";
                    }
                }
            } else {
                const statusMessageElement =
                    document.getElementById("status-message");
                if (statusMessageElement) {
                    statusMessageElement.textContent =
                        "Erro no pagamento. Por favor, tente novamente.";
                }
            }
        }

        async function handleReservation(
            user_id: number,
            item_id: number,
            start_date: string,
            end_date: string,
            payment_amount: number,
            payment_method: string,
        ) {
            try {
                // Verifica se já existe a reserva
                const { data, error } = await actions.thereIsReservation({
                    user_id,
                    item_id,
                });

                if (error) throw new Error("Erro ao verificar reserva");
                if (data) {
                    console.log("O produto já foi reservado.");
                    return;
                }

                // Confirma o pagamento e adiciona a reserva
                await confirmationPayment(
                    user_id,
                    item_id,
                    start_date,
                    end_date,
                    payment_amount,
                    payment_method,
                );

                // Remove o item do carrinho
                removeItemFromCart(item_id);
            } catch (error) {
                console.error("Erro ao processar reserva:", error);
            }
        }

        async function confirmationPayment(
            user_id: number,
            item_id: number,
            start_date: string,
            end_date: string,
            payment_amount: number,
            payment_method: string,
        ) {
            try {
                const { data, error } = await actions.itemPaymentConfirmation({
                    user_id,
                    item_id,
                    start_date,
                    end_date,
                    payment_amount,
                    payment_method,
                });

                if (error) throw new Error("Erro ao confirmar pagamento");
                if (!data)
                    throw new Error("Item não encontrado para confirmação");

                return data;
            } catch (error) {
                console.error("Erro ao confirmar pagamento:", error);
                return null;
            }
        }

        // Função para mostrar sucesso, confete e mapa
        function showSuccess() {
            const statusLoadingElement =
                document.getElementById("status-loading");
            const statusSuccessElement =
                document.getElementById("status-success");

            if (statusLoadingElement) {
                statusLoadingElement.classList.add("hidden");
            }
            if (statusSuccessElement) {
                statusSuccessElement.classList.remove("hidden");
            }

            // Disparar confete
            triggerConfetti();
        }
    });
</script>
