---
import PreviewImage from "@components/Modal/PreviewImage";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Layout from "@layouts/Layout.astro";
import { getRentalByID, userExistsByID, getItemByID } from "@lib/dbFunctions";

let $user: any;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    const id = Number(getCookie?.value);

    $user = await userExistsByID(`${id}`);
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const user = $user;

if (!user) return Astro.redirect(`/${lang}/`);

// Obtem os dados de aluguel
const rentals = await getRentalByID(user.id);

//console.log("rentals: ", rentals);

// Obtem os dados do item para cada aluguel
const items = (
    await Promise.all(
        rentals.map(async (rental: any) => {
            const item = await getItemByID(rental.article_id);
            return item ? { ...rental, item } : null; // Retorna null se o item não existir
        }),
    )
).filter((rentalWithItem) => rentalWithItem !== null); // Remove os nulos

//console.log("items: ", items);
---

<Layout
    title="Historical"
    description="Historical"
    keywords="Historical"
    canonical="https://outfit-oasis.com/historical"
>
    <section
        class="max-w-[80vw] mx-auto my-6 p-[1vw] min-h-screen bg-[--background] text-[--color-white] rounded-lg shadow-lg"
    >
        <h1 class="text-[2vw] font-bold my-12">{t("his.title")}</h1>
        <div class="overflow-hidden rounded-lg shadow-md">
            <table
                class="w-full border-collapse bg-[--gray] rounded-lg hidden min-[884px]:table"
            >
                <thead
                    class="bg-[--grayLight] text-[--color-white1] uppercase text-sm"
                >
                    <tr class="text-center *:p-3">
                        <th>ID</th>
                        <th>{t("his.title")}</th>
                        <th>{t("util.startDate")}</th>
                        <th>{t("util.endDate")}</th>
                        <th>{t("util.status")}</th>
                        <th>{t("util.returnDate")}</th>
                        <th>{t("util.totalCost")}</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        items.map((rental) => {
                            const endDateObj = new Date(rental.end_date);
                            const today = new Date();
                            today.setHours(0, 0, 0, 0);
                            endDateObj.setHours(0, 0, 0, 0);
                            return (
                                <tr class="border-b border-[--color-black] hover:bg-[--grayLight] *:p-3 *:text-[.9vw]">
                                    <td>{rental.rental_id}</td>
                                    <td class=" flex items-center gap-[1vw]">
                                        <PreviewImage
                                            client:idle
                                            src={rental.item?.image}
                                            type="item"
                                        />
                                        <img
                                            src={rental.item?.image}
                                            onclick={`document.getElementById('preview-item-image-${rental.item?.image}').showModal()`}
                                            alt={rental.item?.name}
                                            class="size-16 object-cover rounded-lg cursor-pointer"
                                        />
                                        <div>
                                            <p>{rental.item?.name}</p>
                                            <p class="text-xm text-[--color-white1]">
                                                {rental.item?.brand}
                                            </p>
                                        </div>
                                    </td>
                                    <td>{rental.start_date}</td>
                                    <td>{rental.end_date}</td>
                                    <td class="font-semibold">
                                        <span
                                            class={
                                                rental.return_date
                                                    ? "text-green-400"
                                                    : rental.rental_status ===
                                                        "active"
                                                      ? "text-yellow-200"
                                                      : "text-yellow-400"
                                            }
                                        >
                                            {rental.return_date
                                                ? t("util.completed")
                                                : rental.rental_status ===
                                                    "active"
                                                  ? t("util.active")
                                                  : t("util.pending")}
                                        </span>
                                    </td>
                                    <td class="font-semibold text-center">
                                        <span
                                            class={
                                                endDateObj < today &&
                                                !rental.return_date
                                                    ? "bg-red-500 text-white px-2 py-1 rounded"
                                                    : "bg-green-500 text-white px-2 py-1 rounded"
                                            }
                                        >
                                            {rental.return_date
                                                ? rental.return_date
                                                : endDateObj < today
                                                  ? t("util.lateReturn")
                                                  : t("util.onTime")}
                                        </span>
                                    </td>
                                    <td class="font-semibold">
                                        ${rental.total_cost.toFixed(2)}
                                    </td>
                                </tr>
                            );
                        })
                    }
                </tbody>
            </table>
            {/* Mobile view fallback */}
            <div class="min-[884px]:hidden">
                {
                    items.map((rental) => (
                        <div class="flex gap-3 bg-[--gray] p-[1vw] my-2 rounded-lg shadow-md *:text-xs ">
                            <div class="">
                                <PreviewImage
                                    client:idle
                                    src={rental.item?.image}
                                    type="item"
                                />
                                <img
                                    src={rental.item?.image}
                                    onclick={`document.getElementById('preview-item-image-${rental.item?.image}').showModal()`}
                                    alt={rental.item?.name}
                                    class="w-16 h-full object-cover rounded-lg cursor-pointer"
                                />
                            </div>
                            <div class="grid gap-2">
                                <div>
                                    <p class="text-[--color-white1]">
                                        {rental.item?.name}
                                    </p>
                                    <p class="text-sm text-[--color-white]">
                                        {rental.item?.brand}
                                    </p>
                                </div>
                                <div class="flex gap-2 *:font-semibold">
                                    <div>
                                        <p>
                                            {t("util.start")}:{" "}
                                            {rental.start_date}
                                        </p>
                                        <p>
                                            {t("util.end")}: {rental.end_date}
                                        </p>
                                    </div>
                                    <div>
                                        <p>
                                            {t("util.status")}:
                                            {rental.return_date
                                                ? t("util.completed")
                                                : rental.rental_status ===
                                                    "active"
                                                  ? t("util.active")
                                                  : t("util.pending")}
                                        </p>
                                        <p>
                                            {t("util.totalCost")}: $
                                            {rental.total_cost.toFixed(2)}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
