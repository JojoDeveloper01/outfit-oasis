---
import PreviewImage from "@components/Modal/PreviewImage";
import { getLangFromUrl } from "@i18n/utils";
import Layout from "@layouts/Layout.astro";
import {
    getRentalByID,
    userExistsByID,
    getItemByID,
    editRentalStatus,
} from "@lib/dbFunctions";

// Define os tipos para os objetos de Rental e Item
interface Item {
    id: number;
    name: string;
    type: string;
    category: string;
    size: string;
    color: string;
    brand: string;
    rental_price: number;
    image: string;
    condition: string;
    availability: number;
    added_date: string;
}

interface Rental {
    rental_id: number;
    user_id: number;
    article_id: number;
    start_date: string;
    end_date: string;
    rental_status: string;
    return_date: string | null;
    total_cost: number;
    item?: Item; // Item associado ao aluguel
}

let $user: any;

if (Astro.cookies.has("id")) {
    const getCookie = Astro.cookies.get("id");
    const id = Number(getCookie?.value);

    $user = await userExistsByID(`${id}`);
}

const lang = getLangFromUrl(Astro.url);
const user = $user;

if (!user) return Astro.redirect(`/${lang}/`);

// Obtem os dados de aluguel
const rentals = await getRentalByID(user.id);

//console.log("rentals: ", rentals);

// Obtem os dados do item para cada aluguel
const items = (
    await Promise.all(
        rentals.map(async (rental: any) => {
            const item = await getItemByID(rental.article_id);
            return item ? { ...rental, item } : null; // Retorna null se o item não existir
        }),
    )
).filter((rentalWithItem) => rentalWithItem !== null); // Remove os nulos

//console.log("items: ", items);

// Função para retornar as classes de status dinamicamente
function getStatusClass(
    id: number,
    endDate: string,
    returnDate: string | null,
): string {
    const today = new Date();
    const endDateObj = new Date(endDate);

    today.setHours(0, 0, 0, 0);
    endDateObj.setHours(0, 0, 0, 0);

    if (returnDate) {
        return "bg-gray-100 text-gray-800"; // Item já devolvido
    } else if (endDateObj < today) {
        // Atrasado
        editRentalStatus(id, "late");

        return "bg-red-100 text-red-800";
    } else if (endDateObj.toDateString() === today.toDateString()) {
        return "bg-yellow-100 text-yellow-800"; // Devolução hoje
    } else {
        return "bg-green-100 text-green-800"; // Ainda no prazo
    }
}
---

<Layout
    title="Historical"
    description="Historical"
    keywords="Historical"
    canonical="https://outfit-oasis.com/historical"
>
    <section class="max-w-[85vw] mx-auto py-12 px-4 min-h-screen">
        <h1 class="text-3xl font-bold mb-8 text-gray-800">My Rental History</h1>
        <div class="bg-white shadow-md rounded-lg">
            <table class="min-w-full border-collapse border border-gray-300">
                <thead>
                    <tr
                        class="*:bg-gray-200 *:px-4 *:py-3 *:border *:border-gray-300 *:text-left"
                    >
                        <th>Rental ID</th>
                        <th>Item</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Return Date </th>
                        <th>Total Cost</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        items.map((rental: Rental) => {
                            const endDateObj = new Date(rental.end_date);
                            const today = new Date();

                            today.setHours(0, 0, 0, 0);
                            endDateObj.setHours(0, 0, 0, 0);

                            return (
                                <tr>
                                    <td class="px-4 py-3 border border-gray-300">
                                        {rental.rental_id}
                                    </td>
                                    <td class="px-4 py-3 border border-gray-300 flex items-center gap-4">
                                        <PreviewImage
                                            client:idle
                                            src={rental.item?.image}
                                            type="item"
                                        />
                                        <img
                                            src={rental.item?.image}
                                            onclick={`document.getElementById('preview-item-image-${rental.item?.image}').showModal()`}
                                            alt={rental.item?.name}
                                            class="w-16 h-16 object-cover rounded-lg cursor-pointer"
                                        />
                                        <div>
                                            <p class="font-bold text-gray-800">
                                                {rental.item?.name}
                                            </p>
                                            <p class="text-sm text-gray-600">
                                                {rental.item?.brand}
                                            </p>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 border border-gray-300">
                                        {rental.start_date}
                                    </td>
                                    <td class="px-4 py-3 border border-gray-300">
                                        {rental.end_date}
                                    </td>
                                    <td class="px-4 py-3 border border-gray-300">
                                        {rental.return_date
                                            ? "Finished" // Devolvido
                                            : rental.rental_status === "active"
                                              ? "Active" // Em andamento
                                              : "Pending"}{" "}
                                    </td>
                                    <td
                                        class={`px-4 py-3 border border-gray-300 font-bold ${getStatusClass(
                                            rental.rental_id,
                                            rental.end_date,
                                            rental.return_date,
                                        )}`}
                                    >
                                        <div class="relative flex gap-3 items-center group">
                                            <span class="m-w-28">
                                                {rental.return_date
                                                    ? rental.return_date // Data de devolução
                                                    : endDateObj < today
                                                      ? "Late Return" // Atrasado
                                                      : endDateObj.toDateString() ===
                                                          today.toDateString()
                                                        ? "Return Today" // Deve ser devolvido hoje
                                                        : "On Time"}{" "}
                                            </span>
                                            <button>
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="24"
                                                    height="24"
                                                    viewBox="0 0 24 24"
                                                    fill="currentColor"
                                                    class="icon icon-tabler icons-tabler-filled icon-tabler-alert-square-rounded"
                                                >
                                                    <path
                                                        stroke="none"
                                                        d="M0 0h24v24H0z"
                                                        fill="none"
                                                    />
                                                    <path d="M12 2l.642 .005l.616 .017l.299 .013l.579 .034l.553 .046c4.687 .455 6.65 2.333 7.166 6.906l.03 .29l.046 .553l.041 .727l.006 .15l.017 .617l.005 .642l-.005 .642l-.017 .616l-.013 .299l-.034 .579l-.046 .553c-.455 4.687 -2.333 6.65 -6.906 7.166l-.29 .03l-.553 .046l-.727 .041l-.15 .006l-.617 .017l-.642 .005l-.642 -.005l-.616 -.017l-.299 -.013l-.579 -.034l-.553 -.046c-4.687 -.455 -6.65 -2.333 -7.166 -6.906l-.03 -.29l-.046 -.553l-.041 -.727l-.006 -.15l-.017 -.617l-.004 -.318v-.648l.004 -.318l.017 -.616l.013 -.299l.034 -.579l.046 -.553c.455 -4.687 2.333 -6.65 6.906 -7.166l.29 -.03l.553 -.046l.727 -.041l.15 -.006l.617 -.017c.21 -.003 .424 -.005 .642 -.005zm.01 13l-.127 .007a1 1 0 0 0 0 1.986l.117 .007l.127 -.007a1 1 0 0 0 0 -1.986l-.117 -.007zm-.01 -8a1 1 0 0 0 -.993 .883l-.007 .117v4l.007 .117a1 1 0 0 0 1.986 0l.007 -.117v-4l-.007 -.117a1 1 0 0 0 -.993 -.883z" />
                                                </svg>
                                            </button>
                                            <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 whitespace-nowrap bg-gray-800 text-white text-sm px-4 py-2 rounded shadow-md opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                                {rental.return_date
                                                    ? "The item has already been returned." // Devolvido
                                                    : endDateObj < today
                                                      ? "The product price will be added per day." // Atrasado
                                                      : endDateObj.toDateString() ===
                                                          today.toDateString()
                                                        ? "Please return it by the end of the day." // Devolução hoje
                                                        : "The item is still within the rental period."}{" "}
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 border border-gray-300 text-gray-800">
                                        ${rental.total_cost}
                                    </td>
                                </tr>
                            );
                        })
                    }
                </tbody>
            </table>
        </div>
    </section>
</Layout>
