---
import Layout from "@layouts/Layout.astro";
import { getItems, getUserLogin } from "@lib/dbFunctions";

import Hero from "@components/LandingPage/Hero.astro";
import Benefits from "@components/LandingPage/Benefits.astro";
import Highlight from "@components/LandingPage/Highlight.astro";
import RentNow from "@components/LandingPage/RentNow.astro";
import Reviews from "@components/LandingPage/Reviews.astro";
import Partnerships from "@components/LandingPage/Partnerships.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const email = "";
const pass = "";
const user = (await getUserLogin(email, pass)) || null;
const lang = getLangFromUrl(Astro.url);
const isStaff = user?.user_type === "staff" ? "block" : "hidden";
const t = useTranslations(lang);

const items = await getItems();
---

<Layout
	title="Home"
	description="O teu relevante lugar de aluguer de roupa"
	keywords="aluguer, roupa, "
	canonical="https://outfit-oasis.com"
>
	<Hero lang={lang} />
