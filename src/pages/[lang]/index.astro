---
import Layout from "@layouts/Layout.astro";
import { getItems, getRentals, getUserLogin } from "@lib/dbFunctions";

import Hero from "@components/LandingPage/Hero.astro";
import WhyRentUs from "@components/LandingPage/WhyRentUs.astro";
import OurClothes from "@components/LandingPage/OurClothes.astro";
import HowItWorks from "@components/LandingPage/HowItWorks.astro";
import RentNow from "@components/LandingPage/RentNow.astro";
import Reviews from "@components/LandingPage/Reviews.astro";
import Partnerships from "@components/LandingPage/Partnerships.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const email = "";
const pass = "";
const user = (await getUserLogin(email, pass)) || null;
const lang = getLangFromUrl(Astro.url);
const isStaff = user?.user_type === "staff" ? "block" : "hidden";
const t = useTranslations(lang);

const rentals = await getRentals();
const items = await getItems();
---

<Layout
	title="Home"
	description="O teu relevante lugar de aluguer de roupa"
	keywords="aluguer, roupa, "
	canonical="https://outfit-oasis.com"
>
	<Hero lang={lang} />
	<OurClothes items={items} rentals={rentals} lang={lang} />
	<HowItWorks />
	<WhyRentUs />
	<!-- Your Dream Outfit Awaits -->
	<Reviews />
	<RentNow lang={lang} />
	<Partnerships />
</Layout>
