---
import { ClientRouter } from "astro:transitions";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LoginRegister from "@components/LoginRegister.astro";
import { getLangFromUrl } from "@i18n/utils";
import { userExistsByID } from "@lib/dbFunctions";
import Rent from "@components/Modal/Rent.astro";
import { getItems, getRentals } from "@lib/dbFunctions";

//canonical
//const canonicalURL = new URL(Astro.url.pathname, Astro.site);

//const socialImageURL = new URL("/preview.png", Astro.url);

const lang = getLangFromUrl(Astro.url);

let $user: any;

if (Astro.cookies.has("id")) {
	const getCookie = Astro.cookies.get("id");
	const id = Number(getCookie?.value);

	$user = await userExistsByID(`${id}`);
}
const user = $user;
const isStaff = user?.user_type === "staff" ? "flex" : "none";

const { title, description, canonical, keywords, hideFooter } = Astro.props;
const overflowToggle = Astro.url.pathname.includes("/dashboard");

const items = await getItems();
const rentals = await getRentals();

// Combina o item com seu aluguel relacionado
const data: any[] = items.map((item: any) => {
	const relatedRentals = rentals.filter(
		(rental: any) => rental.article_id === item.id,
	);

	return relatedRentals.length > 0
		? { ...item, rental: relatedRentals, hasRental: true } // Inclui todos os rentals relacionados
		: { ...item, rental: [], hasRental: false }; // Marca itens sem rentals
});
---

<style is:global>
	:root {
		--background: #171717;
		--gray: #212121;
		--grayLight: #434343;
		--color-black: #0e0e0e;
		--color-white: #c4c4c4;
		--color-white1: #e5e7eb;
		--color: #f7b785;
		--gold: #efb577;
		--greenBlack: #006938;
		--blush: #0f0b0a;
		--gold: #ffca00;
	}

	/* Aplica para todos os elementos com rolagem */
	* {
		scrollbar-width: none; /* Firefox */
		-ms-overflow-style: none; /* IE/Edge */
	}

	/* Para navegadores Webkit (Chrome, Safari, Edge moderno) */
	*::-webkit-scrollbar {
		display: none; /* Oculta a barra de rolagem */
	}

	html {
		scrollbar-gutter: stable;
	}

	html,
	body {
		/* background: linear-gradient(135deg, #000000, #0d0d0d, #2e2e2e); */
		background: var(--background);
		background-size: 300% 300%;
		color: var(--color-white);

		margin: 0;
		width: 100%;
		height: 100%;

		font-family: "Lexend Giga", serif;
		font-weight: 100;

		scrollbar-color: var(--color-black), var(--color);
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	h1,
	h2 {
		position: relative;
		font-weight: bolder;
		text-transform: capitalize;
		letter-spacing: 2px;

		margin: 0;
	}

	h1 {
		font-size: clamp(1.8rem, calc(4vw + 0.7rem), 4vw);
	}

	h2 {
		font-size: larger;
	}

	h3 {
		font-size: x-large;
	}

	footer {
		background-color: var(--color5);
		height: 5rem;

		span,
		p {
			color: var(--color-white);
		}
	}

	a,
	button {
		text-decoration: none;
		font-weight: bolder;
		cursor: pointer;
	}

	.link {
		color: #0088ff;
	}

	.hvLi {
		font-size: 1vw;
		padding: 0.3vw min(0.6vw, 0.9vw);
		border-radius: 0.5rem;
		cursor: pointer;

		&:hover {
			background-color: #dadada3a;
		}

		@media screen and (max-width: 768px) {
			font-size: 2vw;
		}
	}

	p {
		text-align: left;
		line-height: 1.7em;
		text-wrap: pretty;
	}

	/* 	svg {
		fill: var(--color-white);

		&:hover {
			fill: var(--color-black);
		}
	} */

	[type="text"],
	[type="email"],
	[type="url"],
	[type="password"],
	[type="number"],
	[type="date"],
	[type="datetime-local"],
	[type="month"],
	[type="search"],
	[type="tel"],
	[type="time"],
	[type="week"],
	[multiple],
	textarea,
	select {
		margin-top: 1vw;
		display: block;
		width: 100%;
		padding: 2%;
		border-radius: 0.375rem;
		border: 0.01vw solid #d1d5db;
		box-shadow: 0 0.01vw 0.04vw 0 rgb(0 0 0 / 0.05);
		font-size: 0.9vw;
		font-weight: 200;
		line-height: 1.1vw;
		color: #212121;

		&:focus {
			--tw-ring-shadow: var(--greenBlack);
			border-color: var(--greenBlack);
			outline: none;
			ring-color: var(--greenBlack);
			ring-width: 2px;
		}
	}

	table {
		background: var(--gray);
		color: var(--color-white1);
		thead {
			background-color: var(--grayLight);
		}
	}

	.blurred-background {
		background: rgba(56, 56, 56, 0.6);
		backdrop-filter: blur(32px);
		padding: 1vw;
		border-radius: 10px;
		color: #ffffff;
	}
</style>

<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />

		<!-- Google Font -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lexend+Giga:wght@100..900&display=swap"
			rel="stylesheet"
		/>

		<!-- <link rel="canonical" href={canonicalURL} />
		<meta property="og:image" content={socialImageURL} /> -->

		<title>{title}</title>
		<ClientRouter />
	</head>
	<body
		class="grid min-h-screen grid-rows-[auto_1fr_auto] w-[80%] max-[1000px]:w-[85%] mx-auto"
	>
		<!-- Modais -->
		<LoginRegister />
		<Rent data={data} />
		<!-- Modais -->

		<Header user={user} isStaff={isStaff} />
		<main
			class=`size-full relative m-auto ${overflowToggle ? 'overflow-y-hidden' : ''}`
		>
			<slot />
		</main>

		{!hideFooter && <Footer user={user} isStaff={isStaff} />}

		<script src="node_modules/flowbite/dist/flowbite.min.js"></script>
	</body>
</html>

<script is:inline define:vars={{ user }}>
	if (user === null) {
		document.cookie = "id=; path=/; expires=Thu, 01 Jan 1970 00:00:00 UTC;";
	}
</script>
