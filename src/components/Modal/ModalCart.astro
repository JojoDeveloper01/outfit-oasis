<div class="relative">
    <!-- Checkbox (hidden) -->
    <input type="checkbox" id="cartToggle" class="hidden peer" />

    <!-- Cart Button -->
    <label
        for="cartToggle"
        class="relative size-9 rounded-lg flex items-center justify-center bg-[--color2] cursor-pointer"
    >
        <span
            id="cartCounter"
            class="absolute w-7 h-4 -top-2 -right-4 rounded-full bg-white text-black font-bold text-xs text-center z-10"
        >
            0
        </span>
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-shopping-cart-plus"
        >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M4 19a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
            <path d="M12.5 17h-6.5v-14h-2"></path>
            <path d="M6 5l14 1l-.86 6.017m-2.64 .983h-10.5"></path>
            <path d="M16 19h6"></path>
            <path d="M19 16v6"></path>
        </svg>
    </label>

    <!-- Dropdown (Cart Modal) -->
    <div
        class="absolute top-full right-0 mt-2 w-80 bg-white rounded-lg shadow-lg border border-gray-300 opacity-0 pointer-events-none peer-checked:opacity-100 peer-checked:pointer-events-auto transition-opacity duration-200 z-20"
    >
        <!-- Header -->
        <div class="p-4 border-b">
            <h3 class="text-lg font-semibold">Shopping Cart</h3>
        </div>

        <!-- Items (Initially Empty) -->
        <div id="cart-container" class="max-h-60 overflow-y-auto">
            <!-- Dynamically inserted items will go here -->
        </div>

        <!-- Footer -->
        <div class="p-4 border-t">
            <div class="flex justify-between items-center">
                <span class="text-sm font-medium">Total:</span>
                <div class="text-lg font-bold text-[--color2]">
                    <span class="text-[--color2]" id="total-value"> </span>
                    €
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    import { actions } from "astro:actions";

    function sanitizeName(name: string | undefined): string {
        if (!name) return "";
        return name
            .replace(/\s+/g, "-")
            .replace(/[^\w-]/g, "")
            .toLowerCase();
    }

    document.addEventListener("astro:page-load", () => {
        interface CartItem {
            id: string;
            name: string;
            image: string;
            price: number;
            size: string;
            color: string;
            availability: number;
        }

        const cartCounter = document.getElementById(
            "cartCounter",
        ) as HTMLElement;

        const totaValueElement = document.getElementById(
            "total-value",
        ) as HTMLElement;

        function getCart(): CartItem[] {
            return JSON.parse(sessionStorage.getItem("cart") || "[]");
        }

        function saveCart(cart: CartItem[]): void {
            sessionStorage.setItem("cart", JSON.stringify(cart));
        }

        function renderCart(): void {
            const cartContainer = document.querySelector(
                "#cart-container",
            ) as HTMLElement;
            if (!cartContainer) return;
            cartContainer.innerHTML = ""; // Limpa o conteúdo atual
            const cart: CartItem[] = getCart();
            cartCounter.textContent = cart.length.toString();

            cart.forEach((item) => {
                const cartItemHTML = `
                <div class="flex items-center p-2 hover:bg-gray-100">
                    <a href="/clothes/${sanitizeName(item.name)}">
                      <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover rounded-lg border" />
                    </a>
                    <div class="relative ml-4 flex-1">
                        <span class="absolute top-2 right-1 w-3 h-3 ${item.availability === 0 ? "bg-[--color2]" : "bg-[--teal]"} rounded-full shadow-lg"></span>

                        <a href="/clothes/${sanitizeName(item.name)}" class="pr-4 text-sm font-medium text-black">${item.name}</a>
                        <p class="text-xs text-gray-500">${item.size} | ${item.color}</p>
                        <div class="flex items-center justify-between mt-1">
                            <span class="item-value text-sm font-bold text-black">${item.price.toFixed(2)} €</span>
                            <div class="flex items-center gap-2">
                                <button
                                    class="remove-item text-red-500 text-sm px-2 py-1 border rounded hover:bg-red-100 flex items-center justify-center"
                                    data-id="${item.id}"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="16"
                                        height="16"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="icon icon-tabler icons-tabler-outline icon-tabler-x pointer-events-none"
                                    >
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M18 6l-12 12" />
                                        <path d="M6 6l12 12" />
                                    </svg>
                                </button>
                                <button
                                    onclick="document.getElementById('modalRent').showModal()"
                                    class="${item.availability === 0 ? "hidden" : ""} rent-item text-green-500 text-sm px-2 py-1 border rounded hover:bg-green-100"
                                    data-rent="${item.id}"
                                    title="${
                                        item.availability === 0
                                            ? "This item is reserved"
                                            : "Click to rent"
                                    }"
                                >
                                    Rent
                                </button>
                            </div>
                        </div>
                    </div>
                </div>`;
                cartContainer.innerHTML += cartItemHTML;
            });

            totaValueRender();
            attachEventListeners();
        }

        function attachEventListeners(): void {
            // Botão de remover
            document.querySelectorAll(".remove-item").forEach((button) => {
                button.addEventListener("click", (event) => {
                    const id = (event.target as HTMLElement).getAttribute(
                        "data-id",
                    );
                    if (!id) return;

                    let cart = getCart();
                    cart = cart.filter((item) => item.id !== id); // Remove o item do carrinho
                    saveCart(cart);
                    renderCart();
                });
            });
        }

        function totaValueRender() {
            const cart: CartItem[] = getCart();
            const total = cart.reduce((sum, item) => sum + item.price, 0);

            if (totaValueElement) {
                totaValueElement.textContent = total.toFixed(2);
            } else {
                console.error("Elemento com id 'total-value' não encontrado!");
            }
        }

        async function fetchItemById(id: string): Promise<CartItem | null> {
            try {
                const { data, error }: { data?: any; error?: any } =
                    await actions.getItemID({ id: Number(id) });

                if (error) throw new Error("Erro ao buscar item");
                if (!data) throw new Error("Item não encontrado");

                const item: CartItem = {
                    id: String(data.id),
                    name: String(data.name),
                    image: String(data.image),
                    price: Number(data.rental_price),
                    size: String(data.size),
                    color: String(data.color),
                    availability: data.availability,
                };

                console.log(item);

                return item;
            } catch (error) {
                console.error("Erro ao buscar item:", error);
                return null;
            }
        }

        document.addEventListener("click", async (event) => {
            const button = (event.target as HTMLElement).closest(
                'button[id^="add-to-cart-"]',
            ) as HTMLElement;
            if (button) {
                const itemId = button.id.replace("add-to-cart-", "");
                const cart: CartItem[] = getCart();

                if (!cart.some((item) => item.id === itemId)) {
                    const item = await fetchItemById(itemId);
                    if (item) {
                        cartCounter.textContent = cart.length.toString();
                        cart.push({ ...item });
                        saveCart(cart);
                        renderCart();
                        totaValueRender();
                    }
                }
            }
        });

        renderCart();
    });
</script>
