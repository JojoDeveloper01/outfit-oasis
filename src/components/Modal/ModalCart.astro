<div class="relative mr-[1vw]">
  <!-- Checkbox (hidden) -->
  <input type="checkbox" id="cartToggle" class="hidden peer" />

  <!-- Cart Button -->
  <label
    for="cartToggle"
    class="relative size-[2.2vw] rounded-full flex items-center justify-center bg-[--gold] text-black cursor-pointer"
  >
    <span
      id="cartCounter"
      class="absolute w-[60%] h-[40%] grid items-center -top-[14%] -right-[26%] rounded-full text-black font-bold text-[.7vw] text-center z-10 bg-white"
    >
      0
    </span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-shopping-cart-plus size-[70%]"
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
        d="M4 19a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path><path
        d="M12.5 17h-6.5v-14h-2"></path><path
        d="M6 5l14 1l-.86 6.017m-2.64 .983h-10.5"></path><path d="M16 19h6"
      ></path><path d="M19 16v6"></path></svg
    >
  </label>

  <!-- Dropdown (Cart Modal) -->
  <div
    class="min-h-[10vw] max-h-[28vw] absolute flex flex-col justify-between top-full right-0 mt-[.6vw] w-80 rounded-lg shadow-lg border border-gray-300 opacity-0 pointer-events-none peer-checked:opacity-100 peer-checked:pointer-events-auto transition-opacity duration-200 z-20 bg-gray-100"
  >
    <!-- Header -->
    <div class="p-[1vw] border-b">
      <h3 class="text-[1vw] text-black font-semibold">Shopping Cart</h3>
    </div>

    <!-- Items (Initially Empty) -->
    <div id="cart-container" class="h-full overflow-y-auto">
      <!-- Dynamically inserted items will go here -->
    </div>

    <!-- Footer -->
    <div class="p-[1vw] border-t">
      <div class="flex justify-between items-center">
        <span class="text-[.8] font-medium">Total:</span>
        <div class="text-[1vw] font-bold text-[--color-black]">
          <span class="text-[--color-black]" id="total-value"> </span>
          €
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { actions } from "astro:actions";
  import { getCookie, sanitizeName } from "@lib/functions";
  import { getLangFromUrl } from "@i18n/utils";

  const lang = getLangFromUrl(new URL(window.location.href));

  document.addEventListener("astro:page-load", () => {
    interface CartItem {
      id: string;
      name: string;
      image: string;
      price: number;
      size: string;
      color: string;
      availability: number;
    }

    const cartCounter = document.getElementById("cartCounter") as HTMLElement;

    const totaValueElement = document.getElementById(
      "total-value",
    ) as HTMLElement;

    const user_id = getCookie("id");
    const isUser = user_id ? "modalRent" : "modalLogin";

    function getCart(): CartItem[] {
      return JSON.parse(sessionStorage.getItem("cart") || "[]");
    }

    function saveCart(cart: CartItem[]): void {
      sessionStorage.setItem("cart", JSON.stringify(cart));
    }

    function renderCart(): void {
      const cartContainer = document.querySelector(
        "#cart-container",
      ) as HTMLElement;
      if (!cartContainer) return;
      cartContainer.innerHTML = ""; // Limpa o conteúdo atual
      const cart: CartItem[] = getCart();
      cartCounter.textContent = cart.length.toString();

      cart.forEach((item) => {
        // Procurar pelo elemento com ID correspondente
        const availabilityElement = document.getElementById(
          `availability-${item.id}`,
        );

        const availabilityValue =
          availabilityElement?.getAttribute("data-availability") === "true";

        const cartItemHTML = `
                <div class="flex items-center p-[.7vw] hover:bg-gray-200">
                    <a href="/${lang}/clothes/${sanitizeName(item.name)}?id=${item.id}">
                      <img src="${item.image}" alt="${item.name}" class="w-16 h-full object-cover rounded-lg border" />
                    </a>
                    <div class="relative ml-4 flex-1">
                        <span class="absolute top-[.7vw] right-1 w-3 h-3 ${availabilityValue ? "bg-[--color-black]" : "bg-[--greenBlack]"} rounded-full shadow-lg"></span>

                        <a href="/${lang}/clothes/${sanitizeName(item.name)}?id=${item.id}" class="pr-4 text-[.8vw] font-medium text-black">${item.name}</a>
                        <p class="text-[1vw] text-gray-900 font-extralight">${item.size} | ${item.color}</p>
                        <div class="flex items-center justify-between mt-1">
                            <span class="item-value text-[.8vw] font-bold text-black">${item.price.toFixed(2)} €/day</span>
                            <div class="flex items-center gap-[.7vw]">
                                <button
                                    class="remove-item text-red-500 text-[.8vw] px-2 py-[.3vw] border rounded hover:bg-red-100 flex items-center justify-center"
                                    data-id="${item.id}"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="16"
                                        height="16"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="icon icon-tabler icons-tabler-outline icon-tabler-x pointer-events-none"
                                    >
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M18 6l-12 12" />
                                        <path d="M6 6l12 12" />
                                    </svg>
                                </button>
                                <button
                                    onclick="document.getElementById('${isUser}').showModal()"
                                    class="rent-item text-green-500 text-[.8vw] px-2 py-[.3vw] border rounded hover:bg-green-100"
                                    data-rent="${item.id}"
                                    title="Click to rent"
                                >
                                    Rent
                                </button>
                            </div>
                        </div>
                    </div>
                </div>`;
        cartContainer.innerHTML += cartItemHTML;
      });

      totaValueRender();
      attachEventListeners();
    }

    function attachEventListeners(): void {
      // Botão de remover
      document.querySelectorAll(".remove-item").forEach((button) => {
        button.addEventListener("click", (event) => {
          const id = (event.target as HTMLElement).getAttribute("data-id");
          if (!id) return;

          let cart = getCart();
          cart = cart.filter((item) => item.id !== id); // Remove o item do carrinho
          saveCart(cart);
          renderCart();
        });
      });
    }

    function totaValueRender() {
      const cart: CartItem[] = getCart();
      const total = cart.reduce((sum, item) => sum + item.price, 0);

      if (totaValueElement) {
        totaValueElement.textContent = total.toFixed(2);
      } else {
        console.error("Elemento com id 'total-value' não encontrado!");
      }
    }

    async function fetchItemById(id: string): Promise<CartItem | null> {
      try {
        const { data, error }: { data?: any; error?: any } =
          await actions.getItemID({ id: Number(id) });

        if (error) throw new Error("Erro ao buscar item");
        if (!data) throw new Error("Item não encontrado");

        const item: CartItem = {
          id: String(data.id),
          name: String(data.name),
          image: String(data.image),
          price: Number(data.rental_price),
          size: String(data.size),
          color: String(data.color),
          availability: data.availability,
        };

        //console.log(item);

        return item;
      } catch (error) {
        console.error("Erro ao buscar item:", error);
        return null;
      }
    }

    document.addEventListener("click", async (event) => {
      const button = (event.target as HTMLElement).closest(
        'button[id^="add-to-cart-"]',
      ) as HTMLElement;
      if (button) {
        const itemId = button.id.replace("add-to-cart-", "");

        const cart: CartItem[] = getCart();

        if (!cart.some((item) => item.id === itemId)) {
          const item = await fetchItemById(itemId);
          if (item) {
            cartCounter.textContent = cart.length.toString();
            cart.push({ ...item });
            saveCart(cart);
            renderCart();
            totaValueRender();
          }
        }
      }
    });

    renderCart();
  });
</script>
