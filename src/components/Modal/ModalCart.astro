<div class="relative">
    <!-- Checkbox (hidden) -->
    <input type="checkbox" id="cartToggle" class="hidden peer" />

    <!-- Cart Button -->
    <label
        for="cartToggle"
        class="relative size-9 rounded-lg flex items-center justify-center bg-[--color2] cursor-pointer"
    >
        <span
            class="absolute w-7 h-4 -top-2 -right-4 rounded-full bg-white text-black font-bold text-xs text-center z-10"
        >
            0
        </span>
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-shopping-cart-plus"
        >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M4 19a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
            <path d="M12.5 17h-6.5v-14h-2"></path>
            <path d="M6 5l14 1l-.86 6.017m-2.64 .983h-10.5"></path>
            <path d="M16 19h6"></path>
            <path d="M19 16v6"></path>
        </svg>
    </label>

    <!-- Dropdown (Cart Modal) -->
    <div
        class="absolute top-full right-0 mt-2 w-72 bg-white rounded-lg shadow-lg border border-gray-300 opacity-0 pointer-events-none peer-checked:opacity-100 peer-checked:pointer-events-auto transition-opacity duration-200 z-20"
    >
        <!-- Header -->
        <div class="p-4 border-b">
            <h3 class="text-lg font-semibold">Shopping Cart</h3>
        </div>

        <!-- Items (Initially Empty) -->
        <div class="p-4 space-y-4 max-h-60 overflow-y-auto">
            <!-- Dynamically inserted items will go here -->
        </div>

        <!-- Footer -->
        <div class="p-4 border-t">
            <div class="flex justify-between items-center">
                <span class="text-sm font-medium">Total:</span>
                <span class="text-lg font-bold text-[--color2]">€ 0.00</span>
            </div>
            <button
                class="mt-3 w-full py-2 bg-[--color2] text-white rounded hover:bg-opacity-90"
            >
                Checkout
            </button>
        </div>
    </div>
</div>

<script is:inline>
    // Simulação de uma base de dados
    const database = [
        {
            id: 1,
            name: "Example Product",
            price: 19.99,
            size: "M",
            color: "Black",
            image: "https://via.placeholder.com/60",
        },
        {
            id: 2,
            name: "Another Product",
            price: 25.0,
            size: "L",
            color: "Blue",
            image: "https://via.placeholder.com/60",
        },
        // Adicione mais itens conforme necessário
    ];

    // Array para armazenar os itens do carrinho
    let cartItems = [];

    // Referências DOM
    const cartDropdown = document.querySelector(".p-4.space-y-4"); // Contêiner dos itens
    const cartCount = document.querySelector("span.absolute"); // Contador de itens

    // Função para buscar itens na "base de dados"
    function fetchItemById(id) {
        return database.find((item) => item.id === id);
    }

    // Função para adicionar itens ao carrinho
    function addToCart(item) {
        // Verifica se o item já está no carrinho
        const existingItem = cartItems.find(
            (cartItem) => cartItem.id === item.id,
        );

        if (existingItem) {
            existingItem.quantity++;
        } else {
            cartItems.push({ ...item, quantity: 1 });
        }

        updateCartUI();
    }

    // Atualiza o carrinho na interface
    function updateCartUI() {
        // Limpa os itens anteriores
        cartDropdown.innerHTML = "";

        // Atualiza o contador
        cartCount.textContent = cartItems.reduce(
            (sum, item) => sum + item.quantity,
            0,
        );

        // Adiciona os novos itens
        cartItems.forEach((item) => {
            const itemHTML = `
            <div class="flex items-center">
                <img src="${item.image}" alt="Item" class="w-16 h-16 object-cover rounded-lg border" />
                <div class="ml-4 flex-1">
                    <h4 class="text-sm font-medium truncate">${item.name}</h4>
                    <p class="text-xs text-gray-500">Size: ${item.size} | Color: ${item.color}</p>
                    <div class="flex items-center justify-between mt-1">
                        <span class="text-sm font-bold text-[--color2]">€ ${item.price.toFixed(2)}</span>
                        <div class="flex items-center gap-2">
                            <button class="text-gray-500 text-sm px-2 py-1 border rounded hover:bg-gray-100">-</button>
                            <span class="text-sm">${item.quantity}</span>
                            <button class="text-gray-500 text-sm px-2 py-1 border rounded hover:bg-gray-100">+</button>
                        </div>
                    </div>
                </div>
            </div>
        `;
            cartDropdown.innerHTML += itemHTML;
        });
    }

    // Escuta eventos do Broadcast API
    const broadcastChannel = new BroadcastChannel("cartChannel");
    broadcastChannel.onmessage = (event) => {
        const itemId = event.data;
        const item = fetchItemById(itemId);
        if (item) {
            addToCart(item);
        }
    };
</script>
