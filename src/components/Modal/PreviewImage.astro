---
const { src } = Astro.props;
---

<dialog
    id={`preview-profile-image-${src}`}
    class="p-0 bg-white rounded-lg shadow-lg max-w-md w-full overflow-hidden"
>
    <!-- Conteúdo do Modal -->
    <div class="p-6 flex flex-col gap-4 items-center text-center">
        <!-- Botões -->
        <div class="flex justify-center gap-4">
            <!-- Botão Fechar -->
            <form method="dialog">
                <button
                    type="submit"
                    class="w-6 h-6 flex items-center justify-center text-red-600 border border-red-600 rounded-md hover:bg-red-600 hover:text-white focus:ring-2 focus:ring-red-300"
                >
                    &times;
                </button>
            </form>
        </div>

        <!-- Imagem de Pré-visualização -->
        <img
            id="modalImage"
            src={src}
            alt="Image Preview"
            class="max-w-full max-h-60 object-contain border border-gray-300 rounded-lg"
        />
    </div>
</dialog>
