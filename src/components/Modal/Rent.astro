---
import Calendar from "@components/Calendar";

const { data } = Astro.props;
//console.log("data: ", data);
---

<style>
    .tooltip {
        position: absolute;
        background-color: rgba(59, 130, 246, 0.9); /* Azul com transparência */
        color: white;
        padding: 0.5rem;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
        z-index: 1000;
        pointer-events: none; /* Não interferir com o rato */
        white-space: nowrap;
        display: none; /* Inicia invisível */
    }

    .hidden-step {
        visibility: hidden;
        height: 0;
        overflow: hidden;
        padding: 0;
    }

    #payment-form {
        form {
            width: 30vw;
            min-width: 500px;
            align-self: center;
            box-shadow:
                0px 0px 0px 0.5px rgba(50, 50, 93, 0.1),
                0px 2px 5px 0px rgba(50, 50, 93, 0.1),
                0px 1px 1.5px 0px rgba(0, 0, 0, 0.07);
            border-radius: 7px;
            padding: 40px;
            margin-top: auto;
            margin-bottom: auto;
        }

        #payment-message {
            color: rgb(105, 115, 134);
            font-size: 16px;
            line-height: 20px;
            padding-top: 12px;
            text-align: center;
        }

        /* Buttons and links */
        button {
            background: #0055de;
            font-family: Arial, sans-serif;
            color: #ffffff;
            border-radius: 4px;
            border: 0;
            padding: 12px 16px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            display: block;
            transition: all 0.2s ease;
            box-shadow: 0px 4px 5.5px 0px rgba(0, 0, 0, 0.07);
            width: 100%;
        }
        button:hover {
            filter: contrast(115%);
        }
        button:disabled {
            opacity: 0.5;
            cursor: default;
        }

        /* spinner/processing state, errors */
        .spinner,
        .spinner:before,
        .spinner:after {
            border-radius: 50%;
        }
        .spinner {
            color: #ffffff;
            font-size: 22px;
            text-indent: -99999px;
            margin: 0px auto;
            position: relative;
            width: 20px;
            height: 20px;
            box-shadow: inset 0 0 0 2px;
            -webkit-transform: translateZ(0);
            -ms-transform: translateZ(0);
            transform: translateZ(0);
        }
        .spinner:before,
        .spinner:after {
            position: absolute;
            content: "";
        }
        .spinner:before {
            width: 10.4px;
            height: 20.4px;
            background: #0055de;
            border-radius: 20.4px 0 0 20.4px;
            top: -0.2px;
            left: -0.2px;
            -webkit-transform-origin: 10.4px 10.2px;
            transform-origin: 10.4px 10.2px;
            -webkit-animation: loading 2s infinite ease 1.5s;
            animation: loading 2s infinite ease 1.5s;
        }
        .spinner:after {
            width: 10.4px;
            height: 10.2px;
            background: #0055de;
            border-radius: 0 10.2px 10.2px 0;
            top: -0.1px;
            left: 10.2px;
            -webkit-transform-origin: 0px 10.2px;
            transform-origin: 0px 10.2px;
            -webkit-animation: loading 2s infinite ease;
            animation: loading 2s infinite ease;
        }

        /* Payment status page */
        #payment-status {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            row-gap: 30px;
            width: 30vw;
            min-width: 500px;
            min-height: 380px;
            align-self: center;
            box-shadow:
                0px 0px 0px 0.5px rgba(50, 50, 93, 0.1),
                0px 2px 5px 0px rgba(50, 50, 93, 0.1),
                0px 1px 1.5px 0px rgba(0, 0, 0, 0.07);
            border-radius: 7px;
            padding: 40px;
            opacity: 0;
            animation: fadeInAnimation 1s ease forwards;
        }

        #status-icon {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 40px;
            width: 40px;
            border-radius: 50%;
        }

        h2 {
            margin: 0;
            color: #30313d;
            text-align: center;
        }

        a {
            text-decoration: none;
            font-size: 16px;
            font-weight: 600;
            font-family: Arial, sans-serif;
            display: block;
        }
        a:hover {
            filter: contrast(120%);
        }

        #details-table {
            overflow-x: auto;
            width: 100%;
        }

        table {
            width: 100%;
            font-size: 14px;
            border-collapse: collapse;
        }
        table tbody tr:first-child td {
            border-top: 1px solid #e6e6e6; /* Top border */
            padding-top: 10px;
        }
        table tbody tr:last-child td {
            border-bottom: 1px solid #e6e6e6; /* Bottom border */
        }
        td {
            padding-bottom: 10px;
        }

        .TableContent {
            text-align: right;
            color: #6d6e78;
        }

        .TableLabel {
            font-weight: 600;
            color: #30313d;
        }

        .AnimatePresence,
        .p-LinkAutofillPrompt {
            display: none;
        }

        #view-details {
            color: #0055de;
        }

        #retry-button {
            text-align: center;
            background: #0055de;
            color: #ffffff;
            border-radius: 4px;
            border: 0;
            padding: 12px 16px;
            transition: all 0.2s ease;
            box-shadow: 0px 4px 5.5px 0px rgba(0, 0, 0, 0.07);
            width: 100%;
        }
    }
    @-webkit-keyframes loading {
        0% {
            -webkit-transform: rotate(0deg);
            transform: rotate(0deg);
        }
        100% {
            -webkit-transform: rotate(360deg);
            transform: rotate(360deg);
        }
    }
    @keyframes loading {
        0% {
            -webkit-transform: rotate(0deg);
            transform: rotate(0deg);
        }
        100% {
            -webkit-transform: rotate(360deg);
            transform: rotate(360deg);
        }
    }
    @keyframes fadeInAnimation {
        to {
            opacity: 1;
        }
    }

    @media only screen and (max-width: 600px) {
        #payment-form {
            form,
            #payment-status {
                width: 80vw;
                min-width: initial;
            }
        }
    }
</style>

<dialog
    id="modalRent"
    class="p-0 rounded-lg shadow-lg w-[33vw] max-[1000px]:w-[38vw] overflow-hidden"
>
    <!-- Botão de fechar -->
    <button
        id="closeModal"
        class="absolute top-[1.5vw] right-4 text-gray-500 hover:text-gray-700 z-10 *:size-5"
        aria-label="Close"
        onclick="document.getElementById('modalRent').close()"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icon-tabler-x"
        >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M18 6l-12 12"></path>
            <path d="M6 6l12 12"></path>
        </svg>
    </button>

    <div
        class="relative p-[2vw] *:h-[-webkit-fill-available] *:flex *:gap-[1vw] max-[768px]:*:gap-[2vw] *:flex-col *:justify-between"
    >
        <!-- Passo 1 -->
        <section id="step1">
            <h3 class="text-[1vw] max-[768px]:text-[2vw] font-bold mb-[.5vw]">
                Choose Rental Days
            </h3>
            <p
                class="text-[1.2vw] font-semibold text-black bg-gray-200 px-[1vw] py-[.6vw]"
            >
                Select the days you want to rent this item
            </p>

            <Calendar itemsRent={data} client:idle />

            <div class="flex justify-between max-[768px]:*:text-[2vw]">
                <button
                    id="closeFromStep1"
                    class="bg-[--gray] text-white px-[1vw] py-[.6vw] rounded hover:bg-gray-600"
                    onclick="document.getElementById('modalRent').close()"
                >
                    Close
                </button>
                <button
                    id="nextToStep2"
                    class="bg-[--gold] text-black px-[1vw] py-[.6vw] rounded hover:bg-yellow-100"
                >
                    Next
                </button>
            </div>
        </section>

        <!-- Passo 2 -->
        <section id="step2" class="hidden-step">
            <h3 class="text-[1vw] max-[768px]:text-[1.5vw] font-bold mb-[.5vw]">
                Confirm Your Selection
            </h3>
            <div id="itemDetails" class="h-full">
                <!-- Informações do item -->
            </div>
            <div class="flex justify-between">
                <button
                    id="backToStep1"
                    class="bg-[--gray] text-white px-[1vw] py-[.6vw] rounded hover:bg-gray-600"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path d="M15 6l-6 6l6 6"></path></svg
                    >
                </button>
                <button
                    id="nextToStep3"
                    class="bg-[--gold] text-black px-[1vw] py-[.6vw] rounded hover:bg-yellow-100"
                >
                    Confirm
                </button>
            </div>
        </section>

        <!-- Passo 3 -->
        <section id="step3" class="hidden-step">
            <h3 class="text-[1vw] max-[768px]:text-[1.5vw] font-bold mb-[.5vw]">
                Payment
            </h3>
            <p
                class="text-[1.2vw] font-semibold text-black bg-gray-200 px-[1vw] py-[.6vw]"
            >
                Choose a payment method
            </p>

            <!-- Stripe Payment Section -->
            <div id="paymentSection" class="h-[22rem] mb-8">
                <!-- Stripe Elements will be injected here -->
                <p class="font-bold text-[1.2vw]">
                    <span id="itemPrice"></span>€
                </p>
                <div class="h-full mt-[.6vw]">
                    <!-- Elemento do Stripe -->

                    <form
                        id="payment-form"
                        class="h-full flex flex-col justify-between shadow-md mt-auto mb-auto"
                    >
                        <div id="payment-element" class="h-full mb-[1vw]">
                            <!-- stripe.js vai injetar o formulário aqui -->
                        </div>
                        <button
                            id="submit"
                            type="submit"
                            class="bg-[#0055de] text-white rounded-md border-0 px-[1vw] py-[.8vw] text-[1.2vw] font-semibold cursor-pointer shadow-md w-full transition-all duration-200 hover:contrast-125 disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                            Pay Now
                        </button>
                    </form>

                    <div id="payment-message" class="hidden"></div>
                </div>
            </div>

            <div class="flex justify-between">
                <button
                    id="backToStep2"
                    class="bg-[--gray] text-white px-[1vw] py-[.6vw] rounded hover:bg-gray-600"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left"
                    >
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path>
                        <path d="M15 6l-6 6l6 6"></path>
                    </svg>
                </button>
            </div>
        </section>
    </div>
</dialog>

<script>
    import { getLangFromUrl } from "@i18n/utils";
    import { stripe, currentItem } from "@lib/functions";
    import { actions } from "astro:actions";
    import {
        type Appearance,
        type StripeElementsOptions,
    } from "@stripe/stripe-js";

    document.addEventListener("astro:page-load", () => {
        interface Item {
            id: string;
            name: string;
            image: string;
            price: number;
            size: string;
            color: string;
            brand: string;
        }
        const lang = getLangFromUrl(new URL(window.location.href));

        // Elementos do DOM
        const step1 = document.querySelector("#step1") as HTMLElement;
        const step2 = document.querySelector("#step2") as HTMLElement;
        const step3 = document.querySelector("#step3") as HTMLElement;

        const nextToStep2 = document.querySelector(
            "#nextToStep2",
        ) as HTMLButtonElement;
        const backToStep1 = document.querySelector(
            "#backToStep1",
        ) as HTMLButtonElement;
        const nextToStep3 = document.querySelector(
            "#nextToStep3",
        ) as HTMLButtonElement;
        const backToStep2 = document.querySelector(
            "#backToStep2",
        ) as HTMLButtonElement;

        let selectedItem: Item | null = null;

        const updateParamsInURL = (totalPrice: string) => {
            const url = new URL(window.location.href);
            url.searchParams.set("totalPrice", totalPrice); // Adiciona ou atualiza o parâmetro
            // url.searchParams.set("itemId", itemId); // Adiciona ou atualiza o parâmetro
            window.history.pushState({}, "", url); // Atualiza a URL sem recarregar
        };

        // Função para abrir o modal e carregar os dados do item
        document.addEventListener("click", async (event) => {
            const button = (event.target as HTMLElement).closest(
                "button[data-rent]",
            ) as HTMLElement;

            if (button && button.getAttribute("data-rent")) {
                currentItem.itemId = button.getAttribute("data-rent") as string;

                if (currentItem.itemId) {
                    selectedItem = await fetchItemById(currentItem.itemId); // Buscar detalhes do item
                    renderPaymentDetails();
                    if (selectedItem) {
                        updateParamsInURL(selectedItem.price.toFixed(2));
                        renderItemDetails(selectedItem);
                    }
                }
            }
        });

        // Passo 1 -> Passo 2
        nextToStep2.addEventListener("click", () => {
            step1.classList.add("hidden-step");
            step2.classList.remove("hidden-step");
        });

        // Passo 2 -> Passo 1
        backToStep1.addEventListener("click", () => {
            step2.classList.add("hidden-step");
            step1.classList.remove("hidden-step");
        });

        // Passo 2 -> Passo 3
        nextToStep3.addEventListener("click", () => {
            step2.classList.add("hidden-step");
            step3.classList.remove("hidden-step");
            setupStripePayment();
        });

        // Passo 3 -> Passo 2
        backToStep2.addEventListener("click", () => {
            step3.classList.add("hidden-step");
            step2.classList.remove("hidden-step");
        });

        // Função para exibir detalhes do item no Step 1
        function renderItemDetails(item: Item) {
            const itemDetails = document.querySelector(
                "#itemDetails",
            ) as HTMLElement;
            itemDetails.innerHTML = `
            <div class="h-full flex flex-col md:flex-row items-center md:items-stretch gap-[1.5vw]">
                <!-- Seção da Imagem -->
                <div class="w-full md:w-1/3">
                    <img src="${item.image}" class="size-full object-cover rounded-lg border border-gray-200 shadow-sm" />
                </div>

                <!-- Seção de Detalhes -->
                <div class="flex flex-col justify-between w-full md:w-2/3">
                    <h4 class="text-[2vw] font-semibold mb-3 text-gray-800">${item.name}</h4>
                    <div class="grid gap-[.7vw] mb-3 font-light">
                        <div class="flex justify-evenly bg-gray-200 p-[.7vw] rounded-lg">
                            <p class="flex gap-[1vw] items-center">
                                <span class=" font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-ruler-2"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M17 3l4 4l-14 14l-4 -4z"></path><path d="M16 7l-1.5 -1.5"></path><path d="M13 10l-1.5 -1.5"></path><path d="M10 13l-1.5 -1.5"></path><path d="M7 16l-1.5 -1.5"></path></svg></span> 
                                ${item.size}
                            </p>
                            <p class="flex gap-3 items-center">
                                <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-palette"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 21a9 9 0 0 1 0 -18c4.97 0 9 3.582 9 8c0 1.06 -.474 2.078 -1.318 2.828c-.844 .75 -1.989 1.172 -3.182 1.172h-2.5a2 2 0 0 0 -1 3.75a1.3 1.3 0 0 1 -1 2.25" /><path d="M8.5 10.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /><path d="M12.5 7.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /><path d="M16.5 10.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></svg> 
                                ${item.color}
                            </p>
                        </div>

                        <p class="flex justify-center gap-[1vw] bg-gray-200 p-[.7vw] rounded-lg text-[1.2vw] text-black-600">
                            <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-brand-cake"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20.84 12c0 2.05 .985 3.225 -.04 5c-1.026 1.775 -2.537 1.51 -4.314 2.534c-1.776 1.026 -2.302 2.466 -4.353 2.466c-2.051 0 -2.576 -1.441 -4.353 -2.466c-1.776 -1.024 -3.288 -.759 -4.314 -2.534c-1.025 -1.775 -.04 -2.95 -.04 -5s-.985 -3.225 .04 -5c1.026 -1.775 2.537 -1.51 4.314 -2.534c1.776 -1.026 2.302 -2.466 4.353 -2.466s2.577 1.441 4.353 2.466c1.776 1.024 3.288 .759 4.313 2.534c1.026 1.775 .04 2.95 .04 5z" /></svg> 
                            ${item.brand}
                        </p>
                    </div>

                    <!-- Mapa -->
                    <div class="w-full h-40 border border-gray-200 rounded- overflow-hidden" title="Local that you have to go to get your item">
                         <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3106.609552808246!2d-9.077966787753034!3d38.86429367161323!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd192ec1c4a591d1%3A0x384a0c3b46e3770a!2sR.%20Jos%C3%A9%20Nogueira%20Vaz%2016%2C%202625-099%20P%C3%B3voa%20de%20Santa%20Iria!5e0!3m2!1spt-PT!2spt!4v1736287506229!5m2!1spt-PT!2spt"
                            width="400"
                            height="300"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>
    `;
        }

        // Exibir informações de pagamento no Step 3
        function renderPaymentDetails() {
            if (selectedItem) {
                const itemPrice = document.querySelector(
                    "#itemPrice",
                ) as HTMLElement;
                itemPrice.textContent = selectedItem.price.toFixed(2);
            }
        }

        // Simula a busca de um item (substitua por lógica real)
        async function fetchItemById(id: string): Promise<Item | null> {
            try {
                const { data, error } = await actions.getItemID({
                    id: Number(id),
                });

                if (error) throw new Error("Erro ao buscar item");
                if (!data) throw new Error("Item não encontrado");

                return {
                    id: String(data.id),
                    name: String(data.name),
                    image: String(data.image),
                    price: Number(data.rental_price),
                    size: String(data.size),
                    color: String(data.color),
                    brand: String(data.brand),
                };
            } catch (error) {
                console.error("Erro ao buscar item:", error);
                return null;
            }
        }

        async function setupStripePayment() {
            try {
                if (!stripe) {
                    console.error("Stripe não pôde ser carregado!");
                    return;
                }

                // Verifica se o item selecionado existe
                if (!selectedItem) {
                    console.error("Nenhum item selecionado para pagamento.");
                    return;
                }

                // Preparar o item para envio ao Stripe
                const item = [
                    {
                        id: Number(selectedItem.id), // ID do item
                        amount: selectedItem.price, // Convertendo para centavos
                    },
                ];

                // Criar PaymentIntent via action
                const { data, error } = await actions.createPaymentIntent({
                    items: item as unknown as [{ id: number; amount: number }],
                });

                if (error) {
                    console.error("Erro ao criar PaymentIntent:", error);
                    return;
                }

                const { clientSecret } = data;

                // Verifique se o clientSecret é válido
                if (!clientSecret) {
                    console.error(
                        "O clientSecret é inválido ou não foi fornecido.",
                    );
                    return;
                }

                // Configuração do objeto appearance
                const appearance: Appearance = {
                    theme: "flat",
                    variables: {
                        fontFamily: ' "Gill Sans", sans-serif',
                        fontLineHeight: "1.5",
                        borderRadius: "10px",
                        colorBackground: "#F6F8FA",
                        accessibleColorOnColorPrimary: "#262626",
                    },
                    rules: {
                        ".Block": {
                            backgroundColor: "var(--colorBackground)",
                            boxShadow: "none",
                            padding: "12px",
                        },
                        ".Input": {
                            padding: "12px",
                        },
                        ".Input:disabled, .Input--invalid:disabled": {
                            color: "lightgray",
                        },
                        ".Tab": {
                            padding: "10px 12px 8px 12px",
                            border: "none",
                        },
                        ".Tab:hover": {
                            border: "none",
                            boxShadow:
                                "0px 1px 1px rgba(0, 0, 0, 0.03), 0px 3px 7px rgba(18, 42, 66, 0.04)",
                        },
                        ".Tab--selected, .Tab--selected:focus, .Tab--selected:hover":
                            {
                                border: "none",
                                backgroundColor: "#fff",
                                boxShadow:
                                    "0 0 0 1.5px var(--colorPrimaryText), 0px 1px 1px rgba(0, 0, 0, 0.03), 0px 3px 7px rgba(18, 42, 66, 0.04)",
                            },
                        ".Label": {
                            fontWeight: "500",
                        },
                    },
                };

                // Configuração do objeto options para o Stripe Elements
                const elementsOptions: StripeElementsOptions = {
                    clientSecret: clientSecret ?? undefined, // Converte null para undefined, se necessário
                    appearance, // Aparência configurada
                };

                // Inicializar o Stripe Elements
                const elements = stripe.elements(elementsOptions);

                const paymentElement = elements.create("payment", {
                    paymentMethodOrder: ["card"], // Ordena os métodos de pagamento
                });

                // Montar o Payment Element no elemento HTML
                paymentElement.mount("#payment-element");

                // Configurar evento de submissão do formulário
                const form = document.querySelector(
                    "#payment-form",
                ) as HTMLFormElement;
                form.addEventListener("submit", async (event) => {
                    event.preventDefault();

                    const itemPriceText =
                        document.getElementById("itemPrice")?.textContent;
                    const itemPrice = itemPriceText
                        ? parseFloat(itemPriceText)
                        : 0;

                    const payment_amount = itemPrice;
                    const intervalDate =
                        document.getElementById("interval-date")?.textContent ||
                        "";

                    // Dividir a string em `startDate` e `endDate`
                    const [startDate, endDate] = intervalDate.split(" - ");

                    // Confirmar o pagamento
                    if (stripe) {
                        const { error } = await stripe.confirmPayment({
                            elements,
                            confirmParams: {
                                return_url: `http://localhost:4321/${lang}/complete?item_id=${encodeURIComponent(currentItem.itemId)}&start_date=${encodeURIComponent(startDate)}&end_date=${encodeURIComponent(endDate)}&payment_amount=${encodeURIComponent(payment_amount)}`,
                            },
                        });

                        //console.log("data: ", data);

                        if (error) {
                            // Tratar erro de pagamento
                            console.error("Erro no pagamento:", error.message);
                            const paymentMessage = document.querySelector(
                                "#payment-message",
                            ) as HTMLElement | null;
                            if (paymentMessage) {
                                paymentMessage.textContent =
                                    error?.message ||
                                    "Ocorreu um erro durante o pagamento.";
                            }
                        }

                        // Atualizar a mensagem de erro ou sucesso no pagamento
                        const paymentMessage = document.querySelector(
                            "#payment-message",
                        ) as HTMLElement | null;

                        if (error) {
                            if (paymentMessage) {
                                paymentMessage.textContent =
                                    error?.message ||
                                    "Ocorreu um erro durante o pagamento.";
                            } else {
                                console.error(
                                    "Elemento #payment-message não encontrado no DOM.",
                                );
                            }
                            console.error("Erro no pagamento:", error.message);
                        }
                    }
                });
            } catch (error) {
                console.error("Erro ao configurar Stripe:", error);
            }
        }
    });
</script>
