---
const { image, name, email, lang, t } = Astro.props;
---

<style>
    .profile-dropdown {
        &:hover .profile-menu,
        &:focus-within .profile-menu {
            visibility: visible;
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="profile-dropdown relative flex items-center space-x-3">
    <button
        type="button"
        class="profile-button flex items-center bg-gray-800 text-white rounded-full focus:ring-4 focus:ring-gray-300 dark:focus:ring-gray-600"
        id="profile-menu-button"
    >
        <span class="sr-only">Open user menu</span>
        <img
            src={image}
            class="size-[2vw] rounded-full"
            src=""
            alt="user photo"
        />
    </button>

    <!-- Dropdown menu -->
    <div
        id="user-dropdown"
        class="profile-menu absolute top-full right-0 mt-[.5vw] border border-gray-200 rounded-lg shadow-lg invisible opacity-0 transform -translate-y-2 transition-all duration-300 ease bg-gray-100 z-50 overflow-hidden"
    >
        <div>
            <a
                href=`/${lang}/account`
                class="block p-[.5vw] hover:bg-gray-200 text-gray-700 text-[.9vw]"
            >
                <span>
                    {name}
                </span>
                <span>{email}</span>
            </a>
        </div>
        <ul
            aria-labelledby="profile-menu-button"
            class="text-[1vw] p-[.5vw] text-black"
        >
            <li>
                <a id="logout" class="w-full inline-block">{t("nav.logout")}</a>
            </li>
        </ul>
    </div>
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        document.getElementById("logout")?.addEventListener("click", () => {
            // Apaga a cookie 'id'
            document.cookie =
                "id=; path=/; expires=Thu, 01 Jan 1970 00:00:00 UTC;";
            location.reload();
        });
    });
</script>
