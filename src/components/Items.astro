---
const { items } = Astro.props;

// Handle form submission
if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        console.log("data: ", data);
        const action = data.get("action");

        console.log(action);
    } catch (error) {}
}
---

<div class="grid gap-4">
    <form class="w-full grid gap-4 bg-[--color-white] p-4 rounded-lg shadow-md">
        <!-- Linha 1: Nome e Tipo -->
        <div class="min-w-[150px]">
            <input
                type="text"
                id="name"
                name="name"
                class="block w-full p-1.5 text-sm text-[--color-black] bg-[--color-white] rounded-lg border focus:ring-[--color-black] focus:border-[--color-black]"
                placeholder="Digite o nome..."
            />
        </div>

        <!-- Linha 2: Cor e Tamanho -->
        <div class="flex flex-wrap gap-2">
            <div class="flex-1 min-w-[150px]">
                <select
                    id="type"
                    name="type"
                    class="block w-full p-1.5 text-sm text-[--color-black] bg-[--color-white] rounded-lg border focus:ring-[--color-black] focus:border-[--color-black]"
                >
                    <option value="">Todos</option>
                    <option value="footwear">Footwear</option>
                    <option value="t-shirt">T-shirt</option>
                </select>
            </div>
            <div class="flex-1 min-w-[150px]">
                <input
                    type="text"
                    id="color"
                    name="color"
                    class="block w-full p-1.5 text-sm text-[--color-black] bg-[--color-white] rounded-lg border focus:ring-[--color-black] focus:border-[--color-black]"
                    placeholder="Digite a cor..."
                />
            </div>
            <div class="flex-1 min-w-[150px]">
                <select
                    id="size"
                    name="size"
                    class="block w-full p-1.5 text-sm text-[--color-black] bg-[--color-white] rounded-lg border focus:ring-[--color-black] focus:border-[--color-black]"
                >
                    <option value="">Todos</option>
                    <option value="P">P</option>
                    <option value="M">M</option>
                    <option value="G">G</option>
                </select>
            </div>
            <div class="flex gap-4 flex-1 min-w-[150px]">
                <input
                    type="number"
                    id="price"
                    name="price"
                    class="block w-full p-1.5 text-sm text-[--color-black] bg-[--color-white] rounded-lg border focus:ring-[--color-black] focus:border-[--color-black]"
                    placeholder="Digite o preço..."
                />
            </div>
        </div>

        <!-- Botão de filtro -->
        <button
            type="submit"
            class="w-1/2 px-4 mb-4 py-2 text-sm font-medium text-[--color-white] bg-[--teal] rounded-lg hover:bg-[--color3] focus:ring-4 focus:outline-none focus:ring-[--gold]"
        >
            Filtrar
        </button>

        <div class="flex justify-end"></div>
    </form>

    <ul
        style="grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), .29fr));"
        class="grid gap-4"
    >
        {
            items.map((item: any) => (
                <li
                    class="max-w-96 p-6 bg-white shadow-lg rounded-lg border-2 border-gray-300 flex flex-col"
                    data-item-id={item.article_id}
                >
                    <div class="flex flex-col space-y-2">
                        <div class="grid gap-2 text-base text-gray-600 item-fields">
                            <p class="font-medium">
                                <span class="font-bold">Name</span>:{" "}
                                <span class="value-field">
                                    {item.article_name}
                                </span>
                            </p>
                            <p class="font-medium">
                                <span class="font-bold">Type</span>:{" "}
                                <span class="value-field">{item.type}</span>
                            </p>
                            <p class="font-medium">
                                <span class="font-bold">Category</span>:{" "}
                                <span class="value-field">{item.category}</span>
                            </p>
                            <p class="font-medium">
                                <span class="font-bold">Size</span>:{" "}
                                <span class="value-field">{item.size}</span>
                            </p>
                            <p class="font-medium">
                                <span class="font-bold">Color</span>:{" "}
                                <span class="value-field">{item.color}</span>
                            </p>
                            <p class="font-medium">
                                <span class="font-bold">Brand</span>:{" "}
                                <span class="value-field">{item.brand}</span>
                            </p>
                            <p class="font-medium">
                                <span class="font-bold">Rental Price</span>:{" "}
                                <span class="value-field">
                                    {item.rental_price}
                                </span>
                                €
                            </p>
                            <p class="font-medium">
                                <span class="font-bold">Condition</span>:{" "}
                                <span class="value-field">
                                    {item.condition}
                                </span>
                            </p>
                        </div>
                    </div>
                </li>
            ))
        }
    </ul>
</div>
