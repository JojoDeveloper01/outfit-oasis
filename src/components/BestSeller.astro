---
const { lang, topPurchasedProducts } = Astro.props;
---

<!-- Produtos mais comprados -->
<div class="w-full max-[768px]:w-[22rem] h-fit text-white rounded-lg shadow-lg">
    <div class="max-h-[25rem] overflow-y-auto">
        <table class="w-full text-[1vw] text-left rounded-t-lg overflow-hidden">
            <thead class="text-[.9vw] uppercase">
                <tr>
                    <th scope="col" class="px-[1vw] py-[1vw]">Produto</th>
                    <th scope="col" class="px-[1.5vw] py-[1vw] text-right"
                        >Vendas</th
                    >
                    <th scope="col" class="px-[1.5vw] py-[1vw] text-right"
                        >Total</th
                    >
                </tr>
            </thead>
            <tbody>
                {
                    Array.isArray(topPurchasedProducts) &&
                        topPurchasedProducts.map((product: any) => (
                            <tr class="hover:bg-[--background]">
                                <td class="px-[1vw] py-[1vw]">
                                    {product.name}
                                </td>
                                <td class="px-[1.5vw] py-[1vw] text-right">
                                    {product.count}
                                </td>
                                <td class="flex gap-1 px-[1.5vw] py-[1vw] text-right">
                                    {product.rental_price
                                        ? (
                                              product.count *
                                              product.rental_price
                                          ).toFixed(2)
                                        : "-"}
                                    <span>€</span>
                                </td>
                            </tr>
                        ))
                }
            </tbody>
        </table>
    </div>
</div>
