<!-- Modal de Login -->
<dialog id="modalLogin" class="p-0 rounded-lg shadow-lg w-full max-w-md">
    <form method="dialog" id="login-form" class="bg-white rounded-lg">
        <!-- Header -->
        <div class="flex justify-between items-center p-4 border-b">
            <h2 class="text-xl font-semibold text-gray-800">Sign in</h2>
            <button
                type="button"
                onclick="document.getElementById('modalLogin').close()"
                class="text-gray-500 hover:text-gray-700"
            >
                &#x2715;
            </button>
        </div>
        <!-- Corpo do Modal -->
        <div class="p-4 space-y-4">
            <div>
                <label for="loginEmail" class="block text-sm text-gray-700 mb-1"
                    >Your Email</label
                >
                <input
                    type="email"
                    id="loginEmail"
                    name="loginEmail"
                    placeholder="name@company.com"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
                <!-- Erro específico do email -->
                <p id="loginEmailError" class="mt-1 text-red-500 hidden"></p>
            </div>
            <div>
                <label
                    for="loginPassword"
                    class="block text-sm text-gray-700 mb-1"
                    >Your password</label
                >
                <input
                    type="password"
                    id="loginPassword"
                    name="loginPassword"
                    placeholder="••••••••"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
                <!-- Erro específico da senha -->
                <p id="loginPasswordError" class="mt-1 text-red-500 hidden"></p>
            </div>

            <div class="flex items-center">
                <input
                    id="rememberLogin"
                    name="rememberLogin"
                    type="checkbox"
                    class="w-4 h-4 text-blue-500 border-gray-300 rounded"
                />
                <label for="rememberLogin" class="ml-2 text-sm text-gray-600"
                    >Remember me</label
                >
            </div>
            <button
                type="submit"
                class="w-full bg-yellow-500 text-white py-2 rounded-lg hover:bg-yellow-600"
            >
                Login to your account
            </button>
            <p class="text-sm text-gray-600 text-center">
                Not registered?
                <button
                    type="button"
                    class="text-yellow-500 hover:underline"
                    onclick="document.getElementById('modalLogin').close(); document.getElementById('modalRegister').showModal();"
                >
                    Create account
                </button>
            </p>
        </div>
    </form>
</dialog>

<!-- Modal de Registro -->
<dialog id="modalRegister" class="p-0 rounded-lg shadow-lg w-full max-w-md">
    <form method="dialog" id="register-form" class="bg-white rounded-lg">
        <!-- Header -->
        <div class="flex justify-between items-center p-4 border-b">
            <h2 class="text-xl font-semibold text-gray-800">Register</h2>
            <button
                type="button"
                onclick="document.getElementById('modalRegister').close()"
                class="text-gray-500 hover:text-gray-700"
            >
                &#x2715;
            </button>
        </div>
        <!-- Corpo do Modal -->
        <div class="p-4 space-y-4">
            <div>
                <label
                    for="registerName"
                    class="block text-sm text-gray-700 mb-1">Name</label
                >
                <input
                    type="text"
                    id="registerName"
                    placeholder="example name"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
            </div>
            <div>
                <label
                    for="registerEmail"
                    class="block text-sm text-gray-700 mb-1">Your email</label
                >
                <input
                    type="email"
                    id="registerEmail"
                    placeholder="name@company.com"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
            </div>
            <div>
                <label
                    for="registerPassword"
                    class="block text-sm text-gray-700 mb-1">Password</label
                >
                <input
                    type="password"
                    id="registerPassword"
                    placeholder="••••••••"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
            </div>
            <div>
                <label
                    for="registerConfirmPassword"
                    class="block text-sm text-gray-700 mb-1"
                    >Confirm password</label
                >
                <input
                    type="password"
                    id="registerConfirmPassword"
                    placeholder="••••••••"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
            </div>
            <div class="flex items-center">
                <input
                    id="rememberRegister"
                    type="checkbox"
                    class="w-4 h-4 text-blue-500 border-gray-300 rounded"
                />
                <label for="rememberRegister" class="ml-2 text-sm text-gray-600"
                    >Remember me</label
                >
            </div>
            <button
                type="submit"
                class="w-full bg-yellow-500 text-white py-2 rounded-lg hover:bg-yellow-600"
            >
                Register
            </button>
            <p class="text-sm text-gray-600 text-center">
                Already have an account?
                <button
                    type="button"
                    class="text-yellow-500 hover:underline"
                    onclick="document.getElementById('modalRegister').close(); document.getElementById('modalLogin').showModal();"
                >
                    Login
                </button>
            </p>
        </div>
    </form>
</dialog>

<script>
    import { actions } from "astro:actions";

    document.addEventListener("astro:page-load", () => {
        const loginForm = document.getElementById("login-form");
        const loginEmailErrorEl = document.getElementById(
            "loginEmailError",
        ) as HTMLElement;
        const loginPasswordErrorEl = document.getElementById(
            "loginPasswordError",
        ) as HTMLElement;

        loginForm?.addEventListener("submit", async (event: any) => {
            event.preventDefault();

            // 1) Limpar mensagens de erro a cada tentativa
            loginEmailErrorEl.textContent = "";
            loginEmailErrorEl.classList.add("hidden");
            loginPasswordErrorEl.textContent = "";
            loginPasswordErrorEl.classList.add("hidden");

            // Coleta os dados do formulário
            const email = (
                document.getElementById("loginEmail") as HTMLInputElement
            )?.value.trim();
            const password = (
                document.getElementById("loginPassword") as HTMLInputElement
            )?.value.trim();

            try {
                // Chama a action diretamente (sem rota)
                const { data, error } = await actions.login({
                    email,
                    password,
                });

                // Se há erro, pode ser erro de validação do Zod ou outro erro
                if (error) {
                    // Verifica se é erro "Failed to validate:"
                    if (error.message.startsWith("Failed to validate:")) {
                        // Extrai só a parte JSON do final da mensagem
                        const rawJSON = error.message
                            .replace("Failed to validate:", "")
                            .trim();

                        try {
                            // Faz parse do array de erros
                            const zodErrors = JSON.parse(rawJSON);
                            zodErrors.forEach(
                                (zErr: {
                                    path: any[];
                                    message: string | null;
                                }) => {
                                    const field = zErr.path[0]; // "email" ou "password"

                                    if (field === "email") {
                                        loginEmailErrorEl.textContent =
                                            zErr.message;
                                        loginEmailErrorEl.classList.remove(
                                            "hidden",
                                        );
                                    } else if (field === "password") {
                                        loginPasswordErrorEl.textContent =
                                            zErr.message;
                                        loginPasswordErrorEl.classList.remove(
                                            "hidden",
                                        );
                                    }
                                },
                            );
                        } catch (parseErr) {
                            console.error(
                                "Falha ao parsear erros de validação:",
                                parseErr,
                            );
                        }
                    } else {
                        // Se não for erro de validação, é um erro crítico
                        console.error("Erro crítico:", error);
                    }
                    return; // Interrompe aqui
                }

                // Se não houve "error", pode ter data.valid = false (depende de como você retornou)
                if (data && !data.valid && data.message) {
                    // Caso você esteja retornando algo como: { valid: false, errors: [...] }
                    const field = data.message.includes("email")
                        ? "email"
                        : "password";
                    if (field === "email") {
                        loginEmailErrorEl.textContent = data.message;
                        loginEmailErrorEl.classList.remove("hidden");
                    } else if (field === "password") {
                        loginPasswordErrorEl.textContent = data.message;
                        loginPasswordErrorEl.classList.remove("hidden");
                    }
                    return;
                }

                // Caso seja válido (login ok), data.user deve conter o usuário:
                const userData = data?.user;
                console.log("userData: ", userData);

                // Se quiser "simular" uma sessão:
                document.cookie = `id=${userData?.id}; path=/; max-age=3600;`; // 60 min
                sessionStorage.setItem("User", JSON.stringify(userData));

                // Ou redirecionar, recarregar, etc.
                location.reload();
            } catch (err) {
                console.error("Erro ao fazer login:", err);
            }
        });

        const registerForm = document.getElementById("register-form");

        // Referências para as mensagens de erro
        const registerNameErrorEl =
            document.getElementById("registerNameError");
        const registerEmailErrorEl =
            document.getElementById("registerEmailError");
        const registerPasswordErrorEl = document.getElementById(
            "registerPasswordError",
        );
        const registerConfirmPasswordErrorEl = document.getElementById(
            "registerConfirmPasswordError",
        );

        registerForm?.addEventListener("submit", async (event) => {
            event.preventDefault();

            // Limpa mensagens de erro anteriores
            registerNameErrorEl.textContent = "";
            registerNameErrorEl.classList.add("hidden");
            registerEmailErrorEl.textContent = "";
            registerEmailErrorEl.classList.add("hidden");
            registerPasswordErrorEl.textContent = "";
            registerPasswordErrorEl.classList.add("hidden");
            registerConfirmPasswordErrorEl.textContent = "";
            registerConfirmPasswordErrorEl.classList.add("hidden");

            // Pega valores
            const name = document.getElementById("registerName").value.trim();
            const email = document.getElementById("registerEmail").value.trim();
            const password = document
                .getElementById("registerPassword")
                .value.trim();
            const confirmPassword = document
                .getElementById("registerConfirmPassword")
                .value.trim();

            try {
                // Chama a action sem rota
                const { data, error } = await actions.register({
                    name,
                    email,
                    password,
                    confirmPassword,
                });

                // Se "error" existir, pode ser erro de validação do Zod
                if (error) {
                    // Verifica se começa com "Failed to validate:"
                    if (error.message.startsWith("Failed to validate:")) {
                        // Extraímos a parte JSON
                        const rawJSON = error.message
                            .replace("Failed to validate:", "")
                            .trim();
                        let zodErrors;
                        try {
                            zodErrors = JSON.parse(rawJSON); // array de erros
                        } catch (parseErr) {
                            console.error(
                                "Falha ao parsear erros de validação:",
                                parseErr,
                            );
                            return;
                        }
                        // Exibe cada erro no campo correspondente
                        zodErrors.forEach((zErr) => {
                            const field = zErr.path[0]; // "name" | "email" | "password" | "confirmPassword" | "server", etc.

                            switch (field) {
                                case "name":
                                    registerNameErrorEl.textContent =
                                        zErr.message;
                                    registerNameErrorEl.classList.remove(
                                        "hidden",
                                    );
                                    break;
                                case "email":
                                    registerEmailErrorEl.textContent =
                                        zErr.message;
                                    registerEmailErrorEl.classList.remove(
                                        "hidden",
                                    );
                                    break;
                                case "password":
                                    registerPasswordErrorEl.textContent =
                                        zErr.message;
                                    registerPasswordErrorEl.classList.remove(
                                        "hidden",
                                    );
                                    break;
                                case "confirmPassword":
                                    registerConfirmPasswordErrorEl.textContent =
                                        zErr.message;
                                    registerConfirmPasswordErrorEl.classList.remove(
                                        "hidden",
                                    );
                                    break;
                                case "server":
                                    // Exemplo: erro de "User with this email already exists"
                                    alert(zErr.message); // ou exibir em outro lugar
                                    break;
                                default:
                                    console.log("Outro campo ou erro:", zErr);
                            }
                        });
                    } else {
                        // Se não for "Failed to validate:", é um erro crítico
                        console.error("Erro crítico:", error);
                    }
                    return; // Interrompe aqui
                }

                // Se chegou até aqui, então "error" é null,
                // e presumimos que data.valid = true (cadastro bem-sucedido)

                const userData = data?.user;
                if (!userData) {
                    console.error(
                        "Não veio userData no cadastro? Cheque o backend.",
                    );
                    return;
                }

                // Simula “login” automático
                document.cookie = `id=${userData.id}; path=/; max-age=3600;`; // 30 min
                sessionStorage.setItem("User", JSON.stringify(userData));
                location.reload();
            } catch (err) {
                console.error("Erro ao fazer registro:", err);
            }
        });
    });
</script>
