---
const { t } = Astro.props;
---

<style>
    button {
        background: #ffc107; /* Gold for buttons */
        color: black; /* Text color on buttons */
        font-size: 0.9vw;
    }

    button:hover {
        background: #e0a800; /* Slightly darker gold for hover effect */
    }

    /*   input {
        background: rgba(255, 255, 255, 0.1);
        color: white; 
        border: 1px solid rgba(255, 255, 255, 0.3); 
    } */

    input::placeholder {
        color: rgba(255, 255, 255, 0.5); /* Placeholder visibility */
    }
</style>

<!-- Modal de Login -->
<dialog
    id="modalLogin"
    class="backdrop:bg-black/50 blurred-background w-full max-w-md p-0 rounded-lg shadow-lg"
>
    <form
        method="dialog"
        id="login-form"
        class="h-full flex flex-col rounded-lg"
    >
        <!-- Header -->
        <div class="flex justify-between items-center p-4 border-b">
            <h2 class="text-lg md:text-xl font-semibold text-white">
                {t("home.login")}
            </h2>
            <button
                type="button"
                onclick="document.getElementById('modalLogin').close()"
                class="text-gray-500 hover:text-white px-3 py-2 rounded-full"
            >
                &#x2715;
            </button>
        </div>
        <!-- Corpo do Modal -->
        <div class="h-full flex flex-col gap-4 p-4">
            <div>
                <label
                    for="loginEmail"
                    class="block text-sm text-white mb-[1vw]">Email</label
                >
                <input
                    type="email"
                    id="loginEmail"
                    name="loginEmail"
                    placeholder="name@company.com"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
                <p
                    id="loginEmailError"
                    class="mt-1 text-red-500 font-bold text-xs hidden"
                >
                </p>
            </div>
            <div>
                <label
                    for="loginPassword"
                    class="block text-sm text-white mb-[1vw]"
                    >{t("home.password")}</label
                >
                <input
                    type="password"
                    id="loginPassword"
                    name="loginPassword"
                    placeholder="••••••••"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
                <p
                    id="loginPasswordError"
                    class="mt-1 text-red-500 font-bold text-xs hidden"
                >
                </p>
            </div>
            <div class="flex items-center">
                <input
                    id="rememberLogin"
                    name="rememberLogin"
                    type="checkbox"
                    class="w-4 h-4 border-gray-300 rounded"
                />
                <label for="rememberLogin" class="ml-2 text-sm text-white">
                    {t("home.remember")}
                </label>
            </div>
            <button
                type="submit"
                class="w-full bg-yellow-500 text-white py-2 rounded-lg hover:bg-yellow-600"
            >
                {t("home.loginYourAccount")}
            </button>
            <p class="text-sm text-white text-center">
                {t("home.notRegistered")}
                <button
                    type="button"
                    class="text-yellow-500 hover:underline"
                    onclick="document.getElementById('modalLogin').close(); document.getElementById('modalRegister').showModal();"
                >
                    {t("home.createAccount")}
                </button>
            </p>
        </div>
    </form>
</dialog>

<!-- Modal de Registro -->
<dialog
    id="modalRegister"
    class="backdrop:bg-black/50 blurred-background w-full max-w-md p-0 rounded-lg shadow-lg"
>
    <form
        method="dialog"
        id="register-form"
        class="h-full flex flex-col rounded-lg"
    >
        <!-- Header -->
        <div class="flex justify-between items-center p-4 border-b">
            <h2 class="text-lg md:text-xl font-semibold text-white">
                {t("home.register")}
            </h2>
            <button
                type="button"
                onclick="document.getElementById('modalRegister').close()"
                class="text-gray-500 hover:text-white px-3 py-2 rounded-full"
            >
                &#x2715;
            </button>
        </div>
        <!-- Corpo do Modal -->
        <div class="h-full flex flex-col gap-4 p-4">
            <div>
                <label
                    for="registerName"
                    class="block text-sm text-white mb-[1vw]"
                    >{t("home.name")}</label
                >
                <input
                    type="text"
                    id="registerName"
                    placeholder="example name"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
                <p
                    id="registerNameError"
                    class="mt-1 text-red-500 font-bold text-xs hidden"
                >
                </p>
            </div>
            <div>
                <label
                    for="registerEmail"
                    class="block text-sm text-white mb-[1vw]">Email</label
                >
                <input
                    type="email"
                    id="registerEmail"
                    placeholder="name@company.com"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
                <p
                    id="registerEmailError"
                    class="mt-1 text-red-500 font-bold text-xs hidden"
                >
                </p>
            </div>
            <div>
                <label
                    for="registerPassword"
                    class="block text-sm text-white mb-[1vw]"
                    >{t("home.password")}</label
                >
                <input
                    type="password"
                    id="registerPassword"
                    placeholder="••••••••"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
                <p
                    id="registerPasswordError"
                    class="mt-1 text-red-500 font-bold text-xs hidden"
                >
                </p>
            </div>
            <div>
                <label
                    for="registerConfirmPassword"
                    class="block text-sm text-white mb-[1vw]"
                    >{t("home.confirmPass")}</label
                >
                <input
                    type="password"
                    id="registerConfirmPassword"
                    placeholder="••••••••"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
                <p
                    id="registerConfirmPasswordError"
                    class="mt-1 text-red-500 font-bold text-xs hidden"
                >
                </p>
            </div>
            <div class="flex items-center">
                <input
                    id="rememberRegister"
                    type="checkbox"
                    class="w-4 h-4 border-gray-300 rounded"
                />
                <label for="rememberRegister" class="ml-2 text-sm text-white"
                    >{t("home.remember")}</label
                >
            </div>
            <button
                type="submit"
                class="w-full bg-yellow-500 text-white py-2 rounded-lg hover:bg-yellow-600"
            >
                {t("home.register")}
            </button>
            <p class="text-sm text-white text-center">
                {t("home.alreadyRegistered")}
                <button
                    type="button"
                    class="text-yellow-500 hover:underline"
                    onclick="document.getElementById('modalRegister').close(); document.getElementById('modalLogin').showModal();"
                >
                    {t("home.login")}
                </button>
            </p>
        </div>
    </form>
</dialog>

<script>
    import { actions } from "astro:actions";

    document.addEventListener("astro:page-load", () => {
        const loginForm = document.getElementById("login-form");
        const loginEmailErrorEl = document.getElementById(
            "loginEmailError",
        ) as HTMLElement;
        const loginPasswordErrorEl = document.getElementById(
            "loginPasswordError",
        ) as HTMLElement;

        loginForm?.addEventListener("submit", async (event: any) => {
            event.preventDefault();

            // 1) Limpar mensagens de erro a cada tentativa
            loginEmailErrorEl.textContent = "";
            loginEmailErrorEl.classList.add("hidden");
            loginPasswordErrorEl.textContent = "";
            loginPasswordErrorEl.classList.add("hidden");

            // Coleta os dados do formulário
            const email = (
                document.getElementById("loginEmail") as HTMLInputElement
            )?.value.trim();
            const password = (
                document.getElementById("loginPassword") as HTMLInputElement
            )?.value.trim();

            try {
                // Chama a action diretamente (sem rota)
                const { data, error } = await actions.login({
                    email,
                    password,
                });

                // Se há erro, pode ser erro de validação do Zod ou outro erro
                if (error) {
                    // Verifica se é erro "Failed to validate:"
                    if (error.message.startsWith("Failed to validate:")) {
                        // Extrai só a parte JSON do final da mensagem
                        const rawJSON = error.message
                            .replace("Failed to validate:", "")
                            .trim();

                        try {
                            // Faz parse do array de erros
                            const zodErrors = JSON.parse(rawJSON);
                            zodErrors.forEach(
                                (zErr: {
                                    path: any[];
                                    message: string | null;
                                }) => {
                                    const field = zErr.path[0]; // "email" ou "password"

                                    if (field === "email") {
                                        loginEmailErrorEl.textContent =
                                            zErr.message;
                                        loginEmailErrorEl.classList.remove(
                                            "hidden",
                                        );
                                    } else if (field === "password") {
                                        loginPasswordErrorEl.textContent =
                                            zErr.message;
                                        loginPasswordErrorEl.classList.remove(
                                            "hidden",
                                        );
                                    }
                                },
                            );
                        } catch (parseErr) {
                            console.error(
                                "Falha ao parsear erros de validação:",
                                parseErr,
                            );
                        }
                    } else {
                        // Se não for erro de validação, é um erro crítico
                        console.error("Erro crítico:", error);
                    }
                    return; // Interrompe aqui
                }

                // Se não houve "error", pode ter data.valid = false (depende de como você retornou)
                if (data && !data.valid && data.message) {
                    // Caso você esteja retornando algo como: { valid: false, errors: [...] }
                    const field = data.message.includes("email")
                        ? "email"
                        : "password";
                    if (field === "email") {
                        loginEmailErrorEl.textContent = data.message;
                        loginEmailErrorEl.classList.remove("hidden");
                    } else if (field === "password") {
                        loginPasswordErrorEl.textContent = data.message;
                        loginPasswordErrorEl.classList.remove("hidden");
                    }
                    return;
                }

                // Caso seja válido (login ok), data.user deve conter o usuário:
                const userData = data?.user;
                //console.log("userData: ", userData);

                // Se quiser "simular" uma sessão:
                document.cookie = `id=${userData?.id}; path=/; max-age=3600;`; // 60 min
                sessionStorage.setItem("User", JSON.stringify(userData));

                // Ou redirecionar, recarregar, etc.
                location.reload();
            } catch (err) {
                console.error("Erro ao fazer login:", err);
            }
        });

        const registerForm = document.getElementById("register-form");

        // Referências para as mensagens de erro
        const registerNameErrorEl = document.getElementById(
            "registerNameError",
        ) as HTMLElement;
        const registerEmailErrorEl = document.getElementById(
            "registerEmailError",
        ) as HTMLElement;
        const registerPasswordErrorEl = document.getElementById(
            "registerPasswordError",
        ) as HTMLElement;
        const registerConfirmPasswordErrorEl = document.getElementById(
            "registerConfirmPasswordError",
        ) as HTMLElement;

        registerForm?.addEventListener("submit", async (event) => {
            event.preventDefault();

            // Limpa mensagens de erro anteriores
            if (registerNameErrorEl) {
                registerNameErrorEl.textContent = "";
                registerNameErrorEl.classList.add("hidden");
            }
            if (registerEmailErrorEl) {
                registerEmailErrorEl.textContent = "";
                registerEmailErrorEl.classList.add("hidden");
            }
            if (registerPasswordErrorEl) {
                registerPasswordErrorEl.textContent = "";
                registerPasswordErrorEl.classList.add("hidden");
            }
            if (registerConfirmPasswordErrorEl) {
                registerConfirmPasswordErrorEl.textContent = "";
                registerConfirmPasswordErrorEl.classList.add("hidden");
            }

            const formData = new FormData();
            const nameInput = document.getElementById(
                "registerName",
            ) as HTMLInputElement;
            const emailInput = document.getElementById(
                "registerEmail",
            ) as HTMLInputElement;
            const passwordInput = document.getElementById(
                "registerPassword",
            ) as HTMLInputElement;
            const userType = "client"; // Valor fixo ou dinâmico
            const phoneInput = document.getElementById(
                "registerPhone",
            ) as HTMLInputElement; // Opcional

            formData.append("name", nameInput.value.trim());
            formData.append("email", emailInput.value.trim());
            formData.append("password", passwordInput.value.trim());
            formData.append("user_type", userType);
            if (phoneInput) {
                formData.append("phone", phoneInput.value.trim());
            }

            if (
                passwordInput.value.trim() !==
                (
                    document.getElementById(
                        "registerConfirmPassword",
                    ) as HTMLInputElement
                )?.value.trim()
            ) {
                if (registerConfirmPasswordErrorEl) {
                    registerConfirmPasswordErrorEl.textContent =
                        "Passwords do not match.";
                    registerConfirmPasswordErrorEl.classList.remove("hidden");
                }
                return; // Não envia o formulário
            }

            try {
                const { data, error } = await actions.addUser(formData);

                // Se "error" existir, pode ser erro de validação do Zod
                if (error) {
                    // Verifica se começa com "Failed to validate:"
                    if (error.message.startsWith("Failed to validate:")) {
                        // Extraímos a parte JSON
                        const rawJSON = error.message
                            .replace("Failed to validate:", "")
                            .trim();
                        let zodErrors;
                        try {
                            zodErrors = JSON.parse(rawJSON); // array de erros
                        } catch (parseErr) {
                            console.error(
                                "Falha ao parsear erros de validação:",
                                parseErr,
                            );
                            return;
                        }

                        // Exibe cada erro no campo correspondente
                        zodErrors.forEach(
                            (zErr: { path: any[]; message: string | null }) => {
                                const field = zErr.path[0]; // Ex.: "name", "email", "password", etc.

                                switch (field) {
                                    case "name":
                                        if (registerNameErrorEl) {
                                            registerNameErrorEl.textContent =
                                                zErr.message || "Invalid name.";
                                            registerNameErrorEl.classList.remove(
                                                "hidden",
                                            );
                                        }
                                        break;
                                    case "email":
                                        if (registerEmailErrorEl) {
                                            registerEmailErrorEl.textContent =
                                                zErr.message ||
                                                "Invalid email.";
                                            registerEmailErrorEl.classList.remove(
                                                "hidden",
                                            );
                                        }
                                        break;
                                    case "password":
                                        if (registerPasswordErrorEl) {
                                            registerPasswordErrorEl.textContent =
                                                zErr.message ||
                                                "Invalid password.";
                                            registerPasswordErrorEl.classList.remove(
                                                "hidden",
                                            );
                                        }
                                        break;
                                    case "confirmPassword":
                                        if (registerConfirmPasswordErrorEl) {
                                            registerConfirmPasswordErrorEl.textContent =
                                                zErr.message ||
                                                "Passwords do not match.";
                                            registerConfirmPasswordErrorEl.classList.remove(
                                                "hidden",
                                            );
                                        }
                                        break;
                                    case "server":
                                        alert(zErr.message); // Para mensagens de erro gerais.
                                        break;
                                    default:
                                        console.warn(
                                            "Unmapped field error:",
                                            zErr,
                                        );
                                }
                            },
                        );
                    }

                    // Verificar mensagens gerais e associá-las a campos
                    if (
                        error.message.includes(
                            "A user with this email already exists",
                        )
                    ) {
                        // Mostra a mensagem no campo de email
                        if (registerEmailErrorEl) {
                            registerEmailErrorEl.textContent =
                                "A user with this email already exists.";
                            registerEmailErrorEl.classList.remove("hidden");
                        }
                    } else {
                        // Se não for "Failed to validate:", é um erro crítico
                        console.error("Erro crítico:", error);
                    }

                    return; // Interrompe aqui
                }

                const userData = data?.user;

                if (!userData) {
                    console.error(
                        "Não veio userData no cadastro? Cheque o backend.",
                    );
                    return;
                }

                // Simula “login” automático
                document.cookie = `id=${userData?.id}; path=/; max-age=3600;`; // 30 min
                sessionStorage.setItem("User", JSON.stringify(userData));
                location.reload();
            } catch (err) {
                console.error("Erro ao fazer registro:", err);
            }
        });
    });
</script>
