<!-- Modal de Login -->
<dialog id="modalLogin" class="p-0 rounded-lg shadow-lg w-full max-w-md">
    <form method="dialog" id="login-form" class="bg-white rounded-lg">
        <!-- Header -->
        <div class="flex justify-between items-center p-4 border-b">
            <h2 class="text-xl font-semibold text-gray-800">Sign in</h2>
            <button
                type="button"
                onclick="document.getElementById('modalLogin').close()"
                class="text-gray-500 hover:text-gray-700"
            >
                &#x2715;
            </button>
        </div>
        <!-- Corpo do Modal -->
        <div class="p-4 space-y-4">
            <div>
                <label for="loginEmail" class="block text-sm text-gray-700 mb-1"
                    >Your Email</label
                >
                <input
                    type="email"
                    id="loginEmail"
                    placeholder="name@company.com"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
            </div>
            <div>
                <label
                    for="loginPassword"
                    class="block text-sm text-gray-700 mb-1"
                    >Your password</label
                >
                <input
                    type="password"
                    id="loginPassword"
                    placeholder="••••••••"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
            </div>
            <div class="flex items-center">
                <input
                    id="rememberLogin"
                    type="checkbox"
                    class="w-4 h-4 text-blue-500 border-gray-300 rounded"
                />
                <label for="rememberLogin" class="ml-2 text-sm text-gray-600"
                    >Remember me</label
                >
            </div>
            <button
                type="submit"
                class="w-full bg-yellow-500 text-white py-2 rounded-lg hover:bg-yellow-600"
            >
                Login to your account
            </button>
            <p class="text-sm text-gray-600 text-center">
                Not registered?
                <button
                    type="button"
                    class="text-yellow-500 hover:underline"
                    onclick="document.getElementById('modalLogin').close(); document.getElementById('modalRegister').showModal();"
                >
                    Create account
                </button>
            </p>
        </div>
    </form>
</dialog>

<!-- Modal de Registro -->
<dialog id="modalRegister" class="p-0 rounded-lg shadow-lg w-full max-w-md">
    <form method="dialog" id="register-form" class="bg-white rounded-lg">
        <!-- Header -->
        <div class="flex justify-between items-center p-4 border-b">
            <h2 class="text-xl font-semibold text-gray-800">Register</h2>
            <button
                type="button"
                onclick="document.getElementById('modalRegister').close()"
                class="text-gray-500 hover:text-gray-700"
            >
                &#x2715;
            </button>
        </div>
        <!-- Corpo do Modal -->
        <div class="p-4 space-y-4">
            <div>
                <label
                    for="registerName"
                    class="block text-sm text-gray-700 mb-1">Name</label
                >
                <input
                    type="text"
                    id="registerName"
                    placeholder="example name"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
            </div>
            <div>
                <label
                    for="registerEmail"
                    class="block text-sm text-gray-700 mb-1">Your email</label
                >
                <input
                    type="email"
                    id="registerEmail"
                    placeholder="name@company.com"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
            </div>
            <div>
                <label
                    for="registerPassword"
                    class="block text-sm text-gray-700 mb-1">Password</label
                >
                <input
                    type="password"
                    id="registerPassword"
                    placeholder="••••••••"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
            </div>
            <div>
                <label
                    for="registerConfirmPassword"
                    class="block text-sm text-gray-700 mb-1"
                    >Confirm password</label
                >
                <input
                    type="password"
                    id="registerConfirmPassword"
                    placeholder="••••••••"
                    class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500"
                    required
                />
            </div>
            <div class="flex items-center">
                <input
                    id="rememberRegister"
                    type="checkbox"
                    class="w-4 h-4 text-blue-500 border-gray-300 rounded"
                />
                <label for="rememberRegister" class="ml-2 text-sm text-gray-600"
                    >Remember me</label
                >
            </div>
            <button
                type="submit"
                class="w-full bg-yellow-500 text-white py-2 rounded-lg hover:bg-yellow-600"
            >
                Register
            </button>
            <p class="text-sm text-gray-600 text-center">
                Already have an account?
                <button
                    type="button"
                    class="text-yellow-500 hover:underline"
                    onclick="document.getElementById('modalRegister').close(); document.getElementById('modalLogin').showModal();"
                >
                    Login
                </button>
            </p>
        </div>
    </form>
</dialog>

<script is:inline>
    document
        .getElementById("login-form")
        .addEventListener("submit", async (event) => {
            event.preventDefault();

            // Coleta os dados do formulário
            const email = document.getElementById("loginEmail").value;
            const password = document.getElementById("loginPassword").value;

            try {
                const response = await fetch("/api/login", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ email, password }),
                });

                const result = await response.json();
                if (response.ok) {
                    const userData = result.user;

                    document.cookie = `user_id=${userData.user_id}; path=/; max-age=3600;`; // 30 min
                    sessionStorage.setItem("User", JSON.stringify(userData));

                    location.reload();
                } else {
                    alert(result.message || "Erro no login.");
                }
            } catch (error) {
                console.error("Erro ao fazer login:", error);
                alert("Erro no servidor.");
            }
        });

    // Manipula o registro
    document
        .getElementById("register-form")
        .addEventListener("submit", async (event) => {
            event.preventDefault();

            // Coleta os dados do formulário
            const name = document.getElementById("registerName").value.trim();
            const email = document.getElementById("registerEmail").value.trim();
            const password = document
                .getElementById("registerPassword")
                .value.trim();
            const confirmPassword = document
                .getElementById("registerConfirmPassword")
                .value.trim();

            // Validações básicas
            if (!name || !email || !password || !confirmPassword) {
                alert("All fields are required.");
                return;
            }

            if (password !== confirmPassword) {
                alert("The passwords don't match.");
                return;
            }

            try {
                const response = await fetch("/api/register", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ name, email, password }),
                });

                const result = await response.json();
                if (response.ok) {
                    const userData = result.user;

                    sessionStorage.setItem("user", JSON.stringify(userData));
                    document.cookie = `user_id=${userData.user_id}; path=/; max-age=3600;`; // 30 min

                    location.reload();
                } else {
                    alert(result.message || "Erro ao registrar.");
                }
            } catch (error) {
                console.error("Erro ao fazer registro:", error);
                alert("Erro no servidor.");
            }
        });
</script>
