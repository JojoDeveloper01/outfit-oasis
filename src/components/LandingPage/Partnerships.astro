---
const partners = [
    { logo: "adidas.png", name: "Adidas" },
    { logo: "lacoste.png", name: "Lacoste" },
    { logo: "fila.png", name: "Fila" },
    { logo: "kappa.png", name: "Kappa" },
];
---

<section
    id="partnerships"
    class="section flex flex-col justify-around gap-8 text-white py-48 rounded-lg"
>
    <h2 class="text-[4vw] font-bold text-white">Our Trusted Partners</h2>
    <!-- Grid responsivo -->
    <ul
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-8 items-center justify-center mx-auto"
    >
        {
            partners.map((partner) => (
                <li class="grid justify-center">
                    <img
                        src={`/partnerships/${partner.logo}`}
                        alt={partner.name}
                        class="h-32 object-contain"
                    />
                </li>
            ))
        }
    </ul>
</section>
