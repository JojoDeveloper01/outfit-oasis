---
/* const { partners } = Astro.props; */

const defaultPartners = [
    { logo: "/images/partner1.png", name: "Partner 1" },
    { logo: "/images/partner2.png", name: "Partner 2" },
];
---

<section class="partnerships py-[.3vw]6">
    <h2 class="text-3xl font-bold text-center mb-8">Our Trusted Partners</h2>
    <ul class="flex flex-wrap justify-center items-center gap-8">
        {
            defaultPartners.map((partner: { logo: string; name: string }) => (
                <li>
                    <img alt={partner.name} class="h-16 max-[768px]:h-24" />
                </li>
            ))
        }
    </ul>
</section>
