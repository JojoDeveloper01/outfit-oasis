---
const { t } = Astro.props;

const partners = [
    { logo: "adidas.png", name: "Adidas" },
    { logo: "lacoste.png", name: "Lacoste" },
    { logo: "fila.png", name: "Fila" },
    { logo: "kappa.png", name: "Kappa" },
];
---

<style>
    .scroll-container {
        display: grid;
        align-items: center;
        height: 11rem;
        position: relative;
        overflow: hidden;
    }

    .carousel-primary,
    .carousel-secondary {
        position: absolute;
        display: flex;
        gap: 2rem;
        padding: 1rem;
        transform: translateX(0); /* Posição inicial */
    }

    .carousel-item {
        flex-shrink: 0;
        width: 11rem;
    }

    .carousel-primary {
        animation: scroll-horizontal 20s linear infinite;
    }

    .carousel-secondary {
        animation: scroll-horizontal 20s linear infinite;
        animation-delay: -10s;
    }

    @keyframes scroll-horizontal {
        from {
            transform: translateX(100%);
        }
        to {
            transform: translateX(-100%);
        }
    }
</style>

<section
    id="partnerships"
    class="flex flex-col gap-12 text-white py-24 rounded-lg"
>
    <h2 class="text-[3.5vw] font-bold text-white">{t("home.partners")}</h2>

    <div class="scroll-container">
        <div class="carousel-primary">
            {
                partners.map((partner) => (
                    <div class="carousel-item">
                        <img
                            src={`/partnerships/${partner.logo}`}
                            alt={partner.name}
                            class="h-32 w-full object-contain"
                        />
                    </div>
                ))
            }
        </div>
        <div class="carousel-secondary">
            {
                partners.map((partner) => (
                    <div class="carousel-item">
                        <img
                            src={`/partnerships/${partner.logo}`}
                            alt={partner.name}
                            class="h-32 w-full object-contain"
                        />
                    </div>
                ))
            }
        </div>
    </div>
</section>
