---
const { t } = Astro.props;

const steps = [
    {
        image: "/choose.png",
        alt: t("home.choose"),
        title: `1 - ${t("home.choose")}`,
        description: t("home.chooseSub"),
        icon: `<svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-search"
            >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
                <path d="M21 21l-6 -6"></path>
            </svg>`,
    },
    {
        image: "/rent.png",
        alt: t("home.click"),
        title: `2 - ${t("home.click")}`,
        description: t("home.clickSub"),
        icon: `<svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="icon icon-tabler icons-tabler-outline icon-tabler-circle-check"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"
                        ></path><path d="M9 12l2 2l4 -4"></path></svg
                    >`,
    },
    {
        image: "/toSchedule.png",
        alt: t("home.pick"),
        title: `3 - ${t("home.pick")}`,
        description: t("home.pickSub"),
        icon: `<svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="icon icon-tabler icons-tabler-outline icon-tabler-calendar"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z"
                        ></path><path d="M16 3v4"></path><path d="M8 3v4"
                        ></path><path d="M4 11h16"></path><path d="M11 15h1"
                        ></path><path d="M12 15v3"></path></svg
                    >`,
    },
    {
        image: "/pay.png",
        alt: t("home.pay"),
        title: `4 - ${t("home.pay")}`,
        description: t("home.paySub"),
        icon: `<svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="icon icon-tabler icons-tabler-outline icon-tabler-credit-card"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M3 5m0 3a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3z"
                        ></path><path d="M3 10l18 0"></path><path
                            d="M7 15l.01 0"></path><path d="M11 15l2 0"
                        ></path></svg
                    >`,
    },
];
---

<section class="section flex flex-col">
    <div class="flex flex-col justify-center gap-28 h-full">
        <h2 class="text-[3.5vw] font-bold text-white">{t("home.how")}</h2>
        <div
            class="h-[58%] grid grid-cols-1 md:grid-cols-4 gap-8 *:flex *:flex-col *:items-center *:text-center *:gap-2"
        >
            {
                steps.map((step, index) => (
                    <div
                        class={
                            index % 2 === 0 ? "justify-start" : "justify-end"
                        }
                    >
                        <div class="size-[14vw] rounded-full overflow-hidden">
                            <img
                                src={step.image}
                                alt={step.alt}
                                class="w-full h-full object-cover"
                            />
                        </div>
                        <span class="*:size-12" set:html={step.icon} />
                        <h3 class="text-[1.5vw] font-semibold text-white">
                            {step.title}
                        </h3>
                        <p class="text-sm text-white text-center font-light">
                            {step.description}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
