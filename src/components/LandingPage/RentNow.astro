---
const { lang, t } = Astro.props;

const cta = {
    title: "Ready to renovate your low-cost clothes?",
    images: ["/man-banner.webp"],
};
---

<section id="rentNow" class="h-[40vh] text-white p-8 rounded-lg bg-[--blush]">
    <div class="relative h-full flex gap-6 items-center">
        <!-- Texto CTA -->
        <div class="w-[65%] flex flex-col gap-4">
            <h2 class="text-[1vw] md:text-[2.5vw] font-bold">{cta.title}</h2>
            <a
                href=`/${lang}/clothes`
                class="w-fit bg-[--gold] text-2xl text-black font-semibold mt-4 px-12 py-4 rounded-md hover:bg-black hover:text-[--gold] transition"
            >
                {t("home.seeMore")}
            </a>
        </div>
    </div>
</section>
