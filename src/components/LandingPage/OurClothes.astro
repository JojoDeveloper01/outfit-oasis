---
import ItemTableUser from "@components/Items/ItemTableUser";

const { items, rentals, lang } = Astro.props;
---

<section id="ourclothes" class="section grid justify-center">
    <div class="flex flex-col justify-center gap-12 h-full">
        <h2 class="text-[4vw] font-bold text-white">Our Clothes</h2>
        <div>
            <div class="w-full h-[30vw] relative grid">
                <ItemTableUser
                    client:load
                    items={items}
                    rentals={rentals}
                    lang={lang}
                    layoutDirection="horizontal"
                    width="20vw"
                />
                <div
                    class="w-fit h-full absolute flex items-center right-4 top-0 z-50"
                >
                    <span
                        class="*:size-10 opacity-70 text-black *:drop-shadow-[0_35px_35px_rgba(255,255,255,1)] z-50 *:text-[#5f5f5f]"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-big-right-lines"
                            ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                            ></path><path
                                d="M12 9v-3.586a1 1 0 0 1 1.707 -.707l6.586 6.586a1 1 0 0 1 0 1.414l-6.586 6.586a1 1 0 0 1 -1.707 -.707v-3.586h-3v-6h3z"
                            ></path><path d="M3 9v6"></path><path d="M6 9v6"
                            ></path></svg
                        >
                    </span>
                </div>
            </div>
            <a
                href={`/${lang}/clothes`}
                class="flex items-center gap-3 mt-4 text-yellow-200 text-[3vw] md:text-[.9vw] hover:underline"
            >
                See more
                <img class="svg-yellow" src="/icons/redirect.svg" />
            </a>
        </div>
    </div>
</section>
