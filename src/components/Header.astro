---
import {
    getLangFromUrl,
    useTranslations,
    useTranslatedPath,
} from "@i18n/utils";
import { languages } from "@i18n/ui";
import LanguagePicker from "./LanguagePicker.astro";
import UserMenu from "./UserMenu.astro";
import ModalCart from "./Modal/ModalCart.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang as keyof typeof languages);

const { user, isStaff } = Astro.props;

//console.log(user);

//dashboard dropdown
const dasboardItems = [
    {
        href: `/${lang}/dashboard/analytics`,
        label: t("nav.analytics"),
    },
    {
        href: `/${lang}/dashboard/users`,
        label: t("nav.users"),
    },
    {
        href: `/${lang}/dashboard/items`,
        label: t("nav.items"),
    },
    {
        href: `/${lang}/dashboard/inbox`,
        label: t("nav.inbox"),
    },
    {
        href: `/${lang}/dashboard/historical`,
        label: t("nav.historical"),
    },
];
---

<style>
    button {
        &:hover {
            color: var(--colo-white);
        }
    }

    .dashboard-dropdown {
        &:hover .dashboard-menu,
        &:focus-within .dashboard-menu {
            visibility: visible;
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<header class="capitalize">
    <nav class="px-8">
        <div
            class="max-w-screen-2xl flex flex-wrap items-center justify-between mx-auto p-4"
        >
            <a
                href={`/${lang}/`}
                class="flex items-center space-x-3 rtl:space-x-reverse"
            >
                <img src="" class="h-8" alt="Outfit Oasis Logo" />
                <span
                    class="self-center text-2xl font-semibold whitespace-nowrap"
                    >OutFit Oasis</span
                >
            </a>

            <div
                class="gap-4 items-center justify-between hidden w-full md:flex md:w-auto md:order-1"
                id="navbar-user"
            >
                <ul
                    class="flex flex-col font-medium p-4 md:p-0 mt-4 border rounded-lg rtl:space-x-reverse md:flex-row md:mt-0 md:border-0"
                >
                    <li>
                        <a
                            href={`/${lang}/`}
                            class="text-white px-4 py-2 rounded-lg cursor-pointer text-sm hover:text-white hover:bg-[#dadada3a]"
                            aria-current="page">{t("nav.home")}</a
                        >
                    </li>
                    <li>
                        <a
                            href=`/${lang}/clothes/`
                            class="text-white px-4 py-2 rounded-lg cursor-pointer text-sm hover:text-white hover:bg-[#dadada3a]"
                            >{t("nav.clothes")}</a
                        >
                    </li>
                    <li class=`${user === undefined ? 'hidden' : ''}`>
                        <a
                            href=`/${lang}/historical/`
                            class="text-white px-4 py-2 rounded-lg cursor-pointer text-sm hover:text-white hover:bg-[#dadada3a]"
                            >{t("nav.historical")}</a
                        >
                    </li>
                    <li class=`${isStaff}`>
                        <ul class="dashboard-dropdown relative inline-block">
                            <a
                                href={`/${lang}/dashboard/`}
                                class="text-white px-4 py-2 rounded-lg cursor-pointer text-sm hover:text-white hover:bg-[#dadada3a]"
                                >{t("nav.dashboard")}</a
                            >

                            <!-- dashboard Dropdown -->
                            <ul
                                class="dashboard-menu mt-4 absolute top-full right-0 bg-white border border-gray-200 rounded-lg shadow-lg invisible opacity-0 translate-y-[-10px] transition-all duration-300 ease z-[1000]"
                                aria-label="submenu dropdown"
                            >
                                {
                                    dasboardItems.map((item) => (
                                        <li>
                                            <a
                                                href={item.href}
                                                class="w-36 block p-3 hover:bg-gray-100 text-gray-700 text-sm text-center"
                                            >
                                                {item.label}
                                            </a>
                                        </li>
                                    ))
                                }
                            </ul>
                        </ul>
                    </li>
                </ul>

                <LanguagePicker
                    languages={languages}
                    lang={lang}
                    translatePath={translatePath}
                />

                {
                    user ? (
                        <UserMenu
                            isStaff={isStaff}
                            name={user.name}
                            image={user.profile_pic}
                            email={user.email}
                            lang={lang}
                            t={t}
                        />
                    ) : (
                        <div class="flex gap-4 font-medium bg-[--color2] px-4 py-2 rounded-2xl ">
                            <button
                                id="modalLogin"
                                onclick="document.getElementById('modalLogin').showModal()"
                            >
                                Login
                            </button>
                            <button
                                id="modalRegister"
                                onclick="document.getElementById('modalRegister').showModal()"
                            >
                                Register
                            </button>
                        </div>
                    )
                }

                <ModalCart />
            </div>
        </div>
    </nav>
</header>
