---
import {
    getLangFromUrl,
    useTranslations,
    useTranslatedPath,
} from "@i18n/utils";
import { languages } from "@i18n/ui";
import LanguagePicker from "./LanguagePicker.astro";
import UserMenu from "./UserMenu.astro";
import ModalCart from "./Modal/ModalCart.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang as keyof typeof languages);

const { user, isStaff } = Astro.props;

//console.log(user);

//dashboard dropdown
const dasboardItems = [
    {
        href: `/${lang}/dashboard/analytics`,
        label: t("nav.analytics"),
    },
    {
        href: `/${lang}/dashboard/users`,
        label: t("nav.users"),
    },
    {
        href: `/${lang}/dashboard/items`,
        label: t("nav.items"),
    },
];
---

<style>
    button {
        &:hover {
            color: var(--colo-white);
        }
    }

    .hvLi {
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        cursor: pointer;

        &:hover {
            background-color: #dadada3a;
        }
    }

    .dashboard-dropdown {
        &:hover .dashboard-menu,
        &:focus-within .dashboard-menu {
            visibility: visible;
            opacity: 1;
            transform: translateY(0);
        }

        svg {
            transform: rotate(0deg);
            transition:
                color 0.3s ease,
                transform 0.3s ease;
        }

        &:hover svg,
        &:focus-within svg {
            transform: rotate(180deg);
        }
    }
</style>

<header transition:persist="header" class="capitalize">
    <nav class="w-[70%] m-auto border-b-2 border-[#ffffff3d]">
        <div
            class="max-w-screen-2xl flex flex-wrap items-center justify-between mx-auto py-8"
        >
            <a
                href={`/${lang}/`}
                class="flex items-center space-x-3 rtl:space-x-reverse"
            >
                <!-- <img src="" class="h-8" alt="Outfit Oasis Logo" /> -->
                <span
                    class="self-center text-2xl font-semibold whitespace-nowrap"
                    >OutFit Oasis</span
                >
            </a>

            <ul
                class="flex flex-col p-4 md:p-0 mt-4 border rounded-lg rtl:space-x-reverse md:flex-row md:mt-0 md:border-0 *:flex *:items-center"
            >
                <li>
                    <a href={`/${lang}/`} class="hvLi" aria-current="page"
                        >{t("nav.home")}</a
                    >
                </li>
                <li>
                    <a href=`/${lang}/clothes/` class="hvLi"
                        >{t("nav.clothes")}</a
                    >
                </li>
                <li class=`${user === undefined ? 'hidden' : ''}`>
                    <a href=`/${lang}/historical/` class="hvLi"
                        >{t("nav.historical")}</a
                    >
                </li>
                <li class=`${isStaff}`>
                    <ul class="dashboard-dropdown relative flex items-center">
                        <a href={`/${lang}/dashboard/`} class="hover: mr-2"
                            >{t("nav.dashboard")}</a
                        >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            class="opacity-80"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-down"
                            ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                            ></path><path d="M6 9l6 6l6 -6"></path></svg
                        >

                        <!-- dashboard Dropdown -->
                        <ul
                            class="dashboard-menu mt-4 absolute top-full right-0 border border-gray-200 rounded-lg shadow-lg invisible opacity-0 translate-y-[-10px] transition-all duration-300 ease z-[1000] bg-gray-100"
                            aria-label="submenu dropdown"
                        >
                            {
                                dasboardItems.map((item) => (
                                    <li>
                                        <a
                                            href={item.href}
                                            class="w-36 block p-3 hover:bg-gray-200 text-gray-700 text-sm text-center"
                                        >
                                            {item.label}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </ul>
                </li>
            </ul>

            <div
                class="gap-4 items-center justify-between hidden w-full md:flex md:w-auto md:order-1"
                id="navbar-user"
            >
                <LanguagePicker
                    languages={languages}
                    lang={lang}
                    translatePath={translatePath}
                />

                {
                    user ? (
                        <UserMenu
                            isStaff={isStaff}
                            name={user.name}
                            image={user.profile_pic}
                            email={user.email}
                            lang={lang}
                            t={t}
                        />
                    ) : (
                        <div class="flex gap-4 ">
                            <button
                                id="modalLogin"
                                class="hvLi"
                                onclick="document.getElementById('modalLogin').showModal()"
                            >
                                Login
                            </button>
                            <button
                                id="modalRegister"
                                class="hvLi"
                                onclick="document.getElementById('modalRegister').showModal()"
                            >
                                Register
                            </button>
                        </div>
                    )
                }

                <ModalCart />
            </div>
        </div>
    </nav>
</header>
