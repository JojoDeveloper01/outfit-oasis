---
import {
    getLangFromUrl,
    useTranslations,
    useTranslatedPath,
} from "@i18n/utils";
import { languages } from "@i18n/ui";
import LanguagePicker from "./LanguagePicker.astro";
import UserMenu from "./UserMenu.astro";
import ModalCart from "./Modal/modalCart.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang as keyof typeof languages);

const { user, isStaff } = Astro.props;

//console.log(user);
---

<style>
    button {
        &:hover {
            color: var(--colo-white);
        }
    }
</style>

<header class="capitalize">
    <nav class="px-8">
        <div
            class="max-w-screen-2xl flex flex-wrap items-center justify-between mx-auto p-4"
        >
            <a
                href={`/${lang}/`}
                class="flex items-center space-x-3 rtl:space-x-reverse"
            >
                <img src="" class="h-8" alt="Outfit Oasis Logo" />
                <span
                    class="self-center text-2xl font-semibold whitespace-nowrap"
                    >OutFit Oasis</span
                >
            </a>

            <div
                class="gap-4 items-center justify-between hidden w-full md:flex md:w-auto md:order-1"
                id="navbar-user"
            >
                <ul
                    class="flex flex-col font-medium p-4 md:p-0 mt-4 mr-4 border rounded-lg md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0"
                >
                    <li>
                        <a
                            href={`/${lang}/`}
                            class="block py-2 px-3 rounded md:p-0"
                            aria-current="page">{t("nav.home")}</a
                        >
                    </li>
                    <li>
                        <a
                            href=`/${lang}/clothes/`
                            class="block py-2 px-3 rounded md:p-0"
                            >{t("nav.clothes")}</a
                        >
                    </li>
                    <li class=`${isStaff}`>
                        <a
                            href={`/${lang}/dashboard/`}
                            class="block py-2 px-3 rounded md:p-0"
                            >{t("nav.dashboard")}</a
                        >
                    </li>
                </ul>

                <LanguagePicker
                    languages={languages}
                    lang={lang}
                    translatePath={translatePath}
                />

                {
                    user ? (
                        <UserMenu
                            isStaff={isStaff}
                            name={user.name}
                            image={user.profile_pic}
                            email={user.email}
                            lang={lang}
                            t={t}
                        />
                    ) : (
                        <div class="flex gap-4 font-medium bg-[--color2] px-4 py-2 rounded-2xl ">
                            <button
                                id="modalLogin"
                                onclick="document.getElementById('modalLogin').showModal()"
                            >
                                Login
                            </button>
                            <button
                                id="modalRegister"
                                onclick="document.getElementById('modalRegister').showModal()"
                            >
                                Register
                            </button>
                        </div>
                    )
                }

                <ModalCart />
            </div>
        </div>
    </nav>
</header>
