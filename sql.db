CREATE TABLE
  users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    email TEXT UNIQUE NOT NULL,
    password TEXT NOT NULL,
    user_type TEXT CHECK (user_type IN ('client', 'staff')) NOT NULL,
    phone INTEGER,
    profile_pic TEXT DEFAULT '/profile_users/default.png',
    registration_date DATETIME DEFAULT CURRENT_TIMESTAMP
  );

ALTER TABLE users 
ADD COLUMN profile_pic TEXT DEFAULT '/profile_users/default.png';

INSERT INTO users_new (id, name, email, password, user_type, phone, registration_date)
SELECT user_id, name, email, password, user_type, phone, registration_date
FROM users;

CREATE TABLE
  articles (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    type TEXT CHECK (type IN ('clothing', 'footwear', 'other')) NOT NULL,
    category TEXT NOT NULL,
    size TEXT NOT NULL,
    color TEXT NOT NULL,
    brand TEXT NOT NULL,
    rental_price DECIMAL(5, 2) NOT NULL,
   image TEXT NOT NULL,
    condition TEXT CHECK (condition IN ('new', 'used', 'worn')) NOT NULL,
    availability BOOLEAN DEFAULT 1,
    added_date DATETIME DEFAULT CURRENT_TIMESTAMP
  );

CREATE TABLE
  reservations (
    reservation_id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    article_id INTEGER NOT NULL,
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    reservation_status TEXT CHECK (
      reservation_status IN ('pending', 'confirmed', 'canceled')
    ) NOT NULL,
    reservation_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users (user_id),
    FOREIGN KEY (article_id) REFERENCES articles (article_id)
  );

CREATE TABLE
  rentals (
    rental_id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    article_id INTEGER NOT NULL,
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    rental_status TEXT CHECK (rental_status IN ('active', 'completed', 'late')) NOT NULL,
    return_date DATE,
    total_cost DECIMAL(7, 2),
    FOREIGN KEY (user_id) REFERENCES users (user_id),
    FOREIGN KEY (article_id) REFERENCES articles (article_id)
  );

CREATE TABLE
  payments (
    payment_id INTEGER PRIMARY KEY AUTOINCREMENT,
    reservation_id INTEGER NOT NULL,
    user_id INTEGER NOT NULL,
    payment_amount DECIMAL(7, 2) NOT NULL,
    payment_method TEXT CHECK (payment_method IN ('card', 'mbway')) NOT NULL,
    payment_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (reservation_id) REFERENCES reservations (reservation_id),
    FOREIGN KEY (user_id) REFERENCES users (user_id)
  );

